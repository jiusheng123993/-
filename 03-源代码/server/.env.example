PORT=3000
DATABASE_URL=postgresql://postgres:password@localhost:5432/xinghuanhai
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
# AI（火山方舟 DeepSeek-V4-Flash，GA 版；与 DeepSeek 官方同款模型，微信审核合作协议走火山）
ARK_API_KEY=your-volcengine-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=deepseek-v4-flash-ga-260731
# 兼容旧变量名：配置了 ARK_* 后以下三项留空即可
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 阿里云百炼 - 视觉识别 + 语音转文字
BAILIAN_API_KEY=your-bailian-api-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_VISION_MODEL=qwen3.6-plus
BAILIAN_ASR_MODEL=fun-asr
WECHAT_APPID=your-wechat-app-id
WECHAT_SECRET=your-wechat-app-secret
SEEDREAM_API_KEY=your-seedream-api-key
# 视频生成（Seedance）API Key，不配置时复用 SEEDREAM_API_KEY
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-1-5-pro-251215
# 3D 模型生成（Meshy）
MESHY_API_KEY=your-meshy-api-key
MODERATE_API_KEY=your-content-moderation-api-key
UPLOAD_DIR=./uploads
# 对外可访问的服务基础地址（生成视频/图片的完整 URL 前缀），如 https://api.example.com
PUBLIC_BASE_URL=
# CORS 允许来源（逗号分隔，如 https://admin.example.com）；留空则允许所有来源（小程序端不受 CORS 限制）
ALLOWED_ORIGINS=
# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# ===== 微信支付配置 =====
# Mock 模式开关：true=本地开发模拟支付（不调真实微信 API），false=真实微信支付 V3
WECHAT_PAY_MOCK=true
# 微信支付商户号
WECHAT_PAY_MCH_ID=
# 微信支付 API V3 密钥（用于回调解密，32 位字符）
WECHAT_PAY_API_V3_KEY=
# 商户证书私钥（PEM 格式，多行字符串或文件路径）
WECHAT_PAY_PRIVATE_KEY=
# 商户证书序列号
WECHAT_PAY_CERT_SERIAL_NO=
# 微信支付平台证书序列号（用于验证回调签名）
WECHAT_PAY_PLATFORM_CERT_SERIAL_NO=
# 微信支付平台证书内容（PEM 格式，用于验证回调签名）
WECHAT_PAY_PLATFORM_CERT=
# 微信支付回调通知地址（必须公网可访问，如 https://api.example.com/api/payment/wechat/notify）
WECHAT_PAY_NOTIFY_URL=
