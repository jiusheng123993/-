.onboarding-page {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  box-sizing: border-box;
  animation: pageEnter 0.5s ease-out;
  position: relative;
  overflow: hidden;
}
.onboarding-page::before {
  content: "";
  position: absolute;
  top: 20%;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.05) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  animation: warmBreathe 5s ease-in-out infinite;
}
.onboarding-page::after {
  content: "";
  position: absolute;
  bottom: 25%;
  right: -40rpx;
  width: 180rpx;
  height: 180rpx;
  background: radial-gradient(circle, rgba(var(--primary-light, #E8C8D8), 0.04) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
  animation: warmBreathe 5s ease-in-out 1.5s infinite;
}
.onboarding-page__skip {
  align-self: flex-end;
  padding: 48rpx 0 16rpx;
  position: relative;
  z-index: 1;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.onboarding-page__skip:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.onboarding-page__skip-text {
  font-size: 14rpx;
  color: var(--text-tertiary, #786870);
}
.onboarding-page__content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  position: relative;
  z-index: 1;
  animation: fadeInScale 0.4s ease-out;
}
.onboarding-page__icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  background: var(--bg-card, #2A1E24);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(var(--primary, #C88EA8), 0.08);
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  animation: popupBounceIn 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  animation: warmBreathe 3s ease-in-out infinite;
}
.onboarding-page__icon-emoji {
  font-size: 56rpx;
  animation: heartbeat 2s ease-in-out infinite;
}
.onboarding-page__title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
  text-align: center;
  margin-bottom: 16rpx;
  animation: fadeInUp 0.4s ease-out 0.1s both;
}
.onboarding-page__description {
  display: block;
  font-size: 15rpx;
  color: var(--text-secondary, #A098A0);
  text-align: center;
  line-height: 1.6;
  max-width: 280rpx;
  animation: fadeInUp 0.4s ease-out 0.2s both;
}
.onboarding-page__dots {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}
.onboarding-page__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--border, rgba(200, 142, 168, 0.15));
  transition: all 0.3s ease;
}
.onboarding-page__dot--active {
  width: 24rpx;
  background: var(--primary, #C88EA8);
  box-shadow: 0 0 8rpx rgba(var(--primary, #C88EA8), 0.4);
}
.onboarding-page__actions {
  padding-bottom: 60rpx;
  position: relative;
  z-index: 1;
}
.onboarding-page__btn {
  border-radius: 24rpx;
  padding: 14rpx 0;
  text-align: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.onboarding-page__btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.onboarding-page__btn--next {
  background: var(--bg-card, #2A1E24);
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}
.onboarding-page__btn--start {
  background: var(--gradient-warm, linear-gradient(135deg, #C88EA8, #D8A8B8, #E8C8D8));
  box-shadow: 0 4rpx 12rpx rgba(var(--primary, #C88EA8), 0.3);
}
.onboarding-page__btn-text {
  font-size: 16rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}
.onboarding-page__btn--start .onboarding-page__btn-text {
  color: var(--text-inverse, #1A1418);
}
