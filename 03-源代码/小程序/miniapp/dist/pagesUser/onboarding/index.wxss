.onboarding-page{background:#f8f4e9;box-sizing:border-box;display:flex;flex-direction:column;min-height:100vh;padding:0 24rpx}.onboarding-page__skip{align-self:flex-end;padding:48rpx 0 16rpx}.onboarding-page__skip-text{color:#999;font-size:14rpx}.onboarding-page__content{align-items:center;display:flex;flex:1;flex-direction:column;justify-content:center;padding:0 20rpx}.onboarding-page__icon{align-items:center;background:#fff;border-radius:30rpx;box-shadow:0 8rpx 32rpx rgba(140,107,79,.1);display:flex;height:120rpx;justify-content:center;margin-bottom:32rpx;width:120rpx}.onboarding-page__icon-emoji{font-size:56rpx}.onboarding-page__title{color:#2c2c2c;display:block;font-size:24rpx;font-weight:700;margin-bottom:16rpx;text-align:center}.onboarding-page__description{color:#666;display:block;font-size:15rpx;line-height:1.6;max-width:280rpx;text-align:center}.onboarding-page__dots{display:flex;gap:8rpx;justify-content:center;margin-bottom:32rpx}.onboarding-page__dot{background:#e0d8cc;border-radius:4rpx;height:8rpx;transition:all .3s ease;width:8rpx}.onboarding-page__dot--active{background:#ff8c42;width:24rpx}.onboarding-page__actions{padding-bottom:60rpx}.onboarding-page__btn{border-radius:24rpx;padding:14rpx 0;text-align:center}.onboarding-page__btn--next{background:#fff;border:1rpx solid #e8e0d4}.onboarding-page__btn--start{background:linear-gradient(135deg,#ff8c42,#ff6b35);box-shadow:0 4rpx 12rpx rgba(255,107,53,.3)}.onboarding-page__btn-text{color:#333;font-size:16rpx;font-weight:600}.onboarding-page__btn--start .onboarding-page__btn-text{color:#fff}