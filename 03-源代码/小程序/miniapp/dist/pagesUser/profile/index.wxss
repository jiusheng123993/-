page{background-color:#f7f4ed}.profile-page{min-height:100vh;overflow:hidden;padding-bottom:140rpx;position:relative}.profile-page .ink-bg-decoration{animation:inkSpread 2s cubic-bezier(.22,.61,.36,1) forwards;border-radius:50%;filter:blur(60rpx);opacity:0;pointer-events:none;position:absolute}.profile-page .ink-bg-1{animation-delay:.3s;background:radial-gradient(circle,rgba(45,45,45,.04) 0,transparent 70%);height:300rpx;right:-80rpx;top:-50rpx;width:300rpx}.profile-page .ink-bg-2{animation-delay:.6s;background:radial-gradient(circle,rgba(45,45,45,.03) 0,transparent 70%);bottom:200rpx;height:250rpx;left:-60rpx;width:250rpx}@keyframes inkSpread{0%{filter:blur(80rpx);opacity:0;transform:scale(.5)}50%{filter:blur(40rpx);opacity:.6}100%{filter:blur(60rpx);opacity:1;transform:scale(1)}}@keyframes inkFadeIn{0%{opacity:0;transform:translateY(20rpx)}100%{opacity:1;transform:translateY(0)}}.ink-item{animation:inkFadeIn .7s cubic-bezier(.22,.61,.36,1) forwards;opacity:0}.profile-header{background:#2c2c2c;overflow:hidden;padding:48rpx 24rpx;position:relative}.profile-header::after{background:hsla(0,0%,100%,.04);border-radius:50%;content:"";height:300rpx;pointer-events:none;position:absolute;right:-20%;top:-50%;width:300rpx}.avatar-section{align-items:center;display:flex;gap:24rpx}.avatar{border:4rpx solid hsla(44,52%,94%,.3);border-radius:50%;box-shadow:0 4rpx 16rpx rgba(45,45,45,.2);height:128rpx;width:128rpx}.avatar-placeholder{align-items:center;background:hsla(44,52%,94%,.15);border-radius:50%;display:flex;height:128rpx;justify-content:center;width:128rpx}.avatar-icon{font-size:64rpx}.user-info{flex:1}.nickname{color:#f8f4e9;font-size:40rpx;font-weight:700;letter-spacing:.5rpx}.login-hint{color:hsla(42,38%,95%,.9);font-size:32rpx;font-weight:500}.stats-section{background:hsla(0,0%,100%,.85);border:1rpx solid rgba(140,107,79,.1);border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);margin:24rpx;padding:24rpx;position:relative;z-index:1}.stats-title{margin-bottom:24rpx}.stats-title text{color:#8a8a8a;font-size:18rpx;font-weight:500;letter-spacing:1rpx}.stats-grid{display:flex;flex-wrap:wrap;margin:-8rpx}.stat-item{align-items:center;background:hsla(44,52%,94%,.5);border:1rpx solid rgba(93,93,93,.06);border-radius:16rpx;display:flex;flex-direction:column;margin:8rpx;padding:24rpx 8rpx;transition:all .3s cubic-bezier(.22,.61,.36,1);width:calc(25% - 16rpx)}.stat-item:active{background:hsla(44,52%,94%,.8);transform:scale(.96)}.stat-value{color:#2d2d2d;font-size:48rpx;font-weight:700;line-height:1.2}.stat-label{color:#8a8a8a;font-size:24rpx;font-weight:500;margin-top:8rpx}.menu-section{background:hsla(0,0%,100%,.85);border:1rpx solid rgba(140,107,79,.1);border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);margin:24rpx;overflow:hidden;position:relative;z-index:1}.menu-item{align-items:center;border-bottom:1rpx solid rgba(93,93,93,.06);display:flex;padding:32rpx;transition:all .3s cubic-bezier(.22,.61,.36,1)}.menu-item:last-child{border-bottom:none}.menu-item:active{background:hsla(42,38%,95%,.5)}.menu-icon{align-items:center;background:rgba(93,93,93,.08);border-radius:12rpx;display:flex;font-size:40rpx;height:64rpx;justify-content:center;margin-right:24rpx;width:64rpx}.menu-text{color:#2d2d2d;flex:1;font-size:32rpx;font-weight:500}.menu-arrow{color:#8a8a8a;font-size:36rpx}.logout-section{margin:48rpx 24rpx 24rpx;position:relative;z-index:1}.logout-btn{align-items:center;background:hsla(0,0%,100%,.85);border:1rpx solid rgba(140,107,79,.1);border-radius:48rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);display:flex;height:96rpx;justify-content:center;transition:all .3s cubic-bezier(.22,.61,.36,1)}.logout-btn:active{box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);opacity:.9;transform:scale(.98)}.logout-text{color:#5a5a5a;font-size:32rpx;font-weight:600}.profile-footer{background:#f7f4ed;bottom:0;left:0;padding:24rpx;position:fixed;right:0;text-align:center}.footer-text{color:#8a8a8a;font-size:24rpx}