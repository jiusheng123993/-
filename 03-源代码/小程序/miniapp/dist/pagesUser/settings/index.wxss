.settings-page{background-color:#f7f4ed;min-height:100vh;padding-bottom:env(safe-area-inset-bottom)}.settings-page__section{background:hsla(0,0%,100%,.85);border:1rpx solid rgba(140,107,79,.1);border-radius:24rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);margin-left:24rpx;margin-right:24rpx;margin-top:24rpx;padding:0 32rpx}.settings-page__section:first-child{margin-top:24rpx}.settings-page__section-title{color:#8a8a8a;display:block;font-size:24rpx;font-weight:500;letter-spacing:1rpx;padding:24rpx 0 8rpx}.settings-page__item{align-items:center;border-bottom:1rpx solid rgba(93,93,93,.06);display:flex;justify-content:space-between;padding:28rpx 0}.settings-page__item:last-child{border-bottom:none}.settings-page__item:active{background:hsla(42,38%,95%,.5)}.settings-page__item-label{color:#2d2d2d;font-size:28rpx;font-weight:500}.settings-page__item-label--danger{color:#ff4d4f}.settings-page__item-value{color:#8a8a8a;font-size:28rpx}.settings-page__item-value--bound{color:#4a90d9}.settings-page__item-arrow{color:#8a8a8a;font-size:32rpx;margin-left:16rpx}.settings-page__item-badge{background-color:#fff3ed;border-radius:8rpx;color:#ff6b35;font-size:20rpx;margin-left:16rpx;padding:4rpx 12rpx}.settings-page__item-loading{color:#4a90d9;font-size:24rpx;margin-left:16rpx}.settings-page__deletion-notice{background:#fff2f0;border:2rpx solid #ffccc7;border-radius:16rpx;margin:24rpx;padding:24rpx 32rpx}.settings-page__deletion-notice .deletion-notice__title{color:#ff4d4f;display:block;font-size:28rpx;font-weight:600;margin-bottom:8rpx}.settings-page__deletion-notice .deletion-notice__desc{color:#666;display:block;font-size:24rpx;line-height:1.5;margin-bottom:16rpx}.settings-page__deletion-notice .deletion-notice__action{background:#fff;border:2rpx solid #ff4d4f;border-radius:24rpx;display:inline-block;padding:8rpx 24rpx}.settings-page__deletion-notice .deletion-notice__action:active{opacity:.8}.settings-page__deletion-notice .deletion-notice__cancel{color:#ff4d4f;font-size:24rpx;font-weight:500}.settings-page__logout{background:hsla(0,0%,100%,.85);border:1rpx solid rgba(140,107,79,.1);border-radius:48rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.04);margin:48rpx 24rpx;padding:24rpx 0;text-align:center;transition:all .3s cubic-bezier(.22,.61,.36,1)}.settings-page__logout:active{opacity:.9;transform:scale(.98)}.settings-page__logout-text{color:#ff6b35;font-size:30rpx;font-weight:600}.settings-page__modal{align-items:center;background:rgba(0,0,0,.5);bottom:0;display:flex;justify-content:center;left:0;position:fixed;right:0;top:0;z-index:1000}.settings-page__modal-content{background:#fff;border-radius:24rpx;max-height:80vh;overflow-y:auto;width:90%}