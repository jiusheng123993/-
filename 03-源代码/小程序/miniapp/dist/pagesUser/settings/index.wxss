.settings-page {
  min-height: 100vh;
  background-color: var(--bg-page, #1A1418);
  padding-bottom: env(safe-area-inset-bottom);
}
.settings-page__section {
  margin-top: 24rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 0 32rpx;
  border-radius: 24rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}
.settings-page__section:first-child {
  margin-top: 24rpx;
}
.settings-page__section-title {
  display: block;
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary, #786870);
  letter-spacing: 1rpx;
  font-weight: 500;
}
.settings-page__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
  transition: background 0.25s ease;
}
.settings-page__item:last-child {
  border-bottom: none;
}
.settings-page__item:active {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
}
.settings-page__item-label {
  font-size: 28rpx;
  color: var(--text-primary, #E8D8DE);
  font-weight: 500;
}
.settings-page__item-label--danger {
  color: var(--danger, #C87070);
}
.settings-page__item-value {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
}
.settings-page__item-value--bound {
  color: var(--primary, #C88EA8);
}
.settings-page__item-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary, #786870);
  margin-left: 16rpx;
}
.settings-page__item-badge {
  font-size: 20rpx;
  color: var(--primary, #C88EA8);
  background-color: var(--primary-bg, rgba(200, 142, 168, 0.08));
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 16rpx;
}
.settings-page__item-loading {
  font-size: 24rpx;
  color: var(--primary, #C88EA8);
  margin-left: 16rpx;
}
.settings-page__deletion-notice {
  margin: 24rpx;
  padding: 24rpx 32rpx;
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
  border-radius: 16rpx;
  border: 2rpx solid rgba(224, 133, 107, 0.3);
}
.settings-page__deletion-notice .deletion-notice__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--danger, #C87070);
  margin-bottom: 8rpx;
}
.settings-page__deletion-notice .deletion-notice__desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #A098A0);
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.settings-page__deletion-notice .deletion-notice__action {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 24rpx;
  border: 2rpx solid var(--danger, #C87070);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.settings-page__deletion-notice .deletion-notice__action:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.settings-page__deletion-notice .deletion-notice__cancel {
  font-size: 24rpx;
  color: var(--danger, #C87070);
  font-weight: 500;
}
.settings-page__logout {
  margin: 48rpx 24rpx;
  padding: 24rpx 0;
  text-align: center;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 48rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.settings-page__logout:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.settings-page__logout-text {
  font-size: 30rpx;
  color: var(--primary, #C88EA8);
  font-weight: 600;
}
.settings-page__modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay, rgba(0, 0, 0, 0.7));
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.settings-page__modal-content {
  width: 90%;
  max-height: 80vh;
  background: var(--bg-card, #2A1E24);
  border-radius: 24rpx;
  overflow-y: auto;
}
.settings-page__theme-group-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary, #A098A0);
  padding: 24rpx 0 8rpx;
}
.settings-page__theme-grid {
  padding: 8rpx 0 24rpx;
}
.settings-page__theme-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
  background: var(--bg-secondary, #241820);
  border: 2rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  position: relative;
}
.settings-page__theme-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.settings-page__theme-card--active {
  border-color: var(--primary, #C88EA8);
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  box-shadow: 0 0 20rpx rgba(var(--primary, #C88EA8), 0.15);
}
.settings-page__theme-card:last-child {
  margin-bottom: 0;
}
.settings-page__theme-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}
.settings-page__theme-preview-emoji {
  font-size: 36rpx;
}
.settings-page__theme-info {
  flex: 1;
  min-width: 0;
}
.settings-page__theme-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
  margin-bottom: 4rpx;
}
.settings-page__theme-desc {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.settings-page__theme-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.settings-page__theme-check Text {
  font-size: 24rpx;
  color: var(--text-inverse, #1A1418);
  font-weight: 700;
}
