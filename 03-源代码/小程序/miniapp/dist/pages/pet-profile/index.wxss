.profile-page{background:#f5f7fa;min-height:100vh}.profile-header{align-items:center;background:linear-gradient(180deg,#fff8ee,#f5f7fa);display:flex;flex-direction:column;justify-content:center;padding:48rpx 32rpx 32rpx}.profile-avatar{align-items:center;background:#fff;border-radius:999rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.08);display:flex;height:160rpx;justify-content:center;margin-bottom:20rpx;width:160rpx}.profile-avatar-emoji{font-size:80rpx}.profile-name{color:#1a1a1a;font-size:48rpx;font-weight:700;margin-bottom:8rpx}.profile-breed{color:#666;font-size:28rpx;margin-bottom:16rpx}.profile-tags{display:flex;flex-wrap:wrap;gap:12rpx;justify-content:center}.profile-tag{background:#fff;border:1rpx solid #fff8ee;border-radius:20rpx;color:#e8a838;font-size:24rpx;padding:6rpx 20rpx}.profile-pet-switcher{display:flex;gap:12rpx;overflow-x:auto;padding:16rpx 32rpx}.profile-pet-tab{align-items:center;background:#fff;border-radius:24rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);color:#666;display:flex;font-size:26rpx;gap:8rpx;padding:12rpx 24rpx;transition:transform .15s ease,opacity .15s ease;white-space:nowrap}.profile-pet-tab:active{opacity:.85;transform:scale(.97)}.profile-pet-tab-active{background:#e8a838;color:#fff}.profile-section{margin:16rpx 32rpx}.profile-section-title{color:#1a1a1a;display:block;font-size:32rpx;font-weight:700;margin-bottom:16rpx}.profile-info-grid{display:grid;gap:12rpx;grid-template-columns:repeat(2,1fr)}.profile-info-item{background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);padding:20rpx}.profile-info-label{color:#999;display:block;font-size:24rpx;margin-bottom:8rpx}.profile-info-value{color:#1a1a1a;font-size:28rpx;font-weight:500}.profile-feature-card{background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);padding:20rpx}.profile-feature-item{align-items:center;border-bottom:1rpx solid #f0f0f0;display:flex;justify-content:space-between;padding:16rpx 0}.profile-feature-item:last-child{border-bottom:none}.profile-feature-label{color:#666;font-size:26rpx}.profile-feature-value{color:#1a1a1a;font-size:26rpx;font-weight:500}.profile-health-card{background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);padding:20rpx}.profile-health-item{align-items:center;border-bottom:1rpx solid #f0f0f0;display:flex;justify-content:space-between;padding:16rpx 0}.profile-health-item:last-child{border-bottom:none}.profile-health-label{color:#666;font-size:26rpx}.profile-health-value{color:#1a1a1a;font-size:26rpx;font-weight:500}.profile-actions{display:flex;gap:16rpx}.profile-action-btn{align-items:center;background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);display:flex;flex:1;flex-direction:column;gap:8rpx;padding:24rpx 12rpx;transition:transform .15s ease,opacity .15s ease}.profile-action-btn:active{opacity:.85;transform:scale(.97)}.profile-action-icon{font-size:36rpx}.profile-action-label{color:#1a1a1a;font-size:24rpx;font-weight:500}.profile-danger-zone{background:#fff;border:1rpx solid #ffccc7;border-radius:8rpx;padding:24rpx}.profile-danger-title{color:#f5222d;display:block;font-size:26rpx;font-weight:500;margin-bottom:16rpx}.profile-danger-btn{background:#fff1f0;border:1rpx solid #ffccc7;border-radius:4rpx;color:#f5222d;font-size:26rpx;padding:16rpx;text-align:center;transition:transform .15s ease,opacity .15s ease}.profile-danger-btn:active{opacity:.85;transform:scale(.97)}.profile-empty{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:120rpx 32rpx}.profile-empty-icon{font-size:80rpx;margin-bottom:16rpx}.profile-empty-text{color:#1a1a1a;font-size:32rpx;font-weight:500;margin-bottom:8rpx}.profile-empty-hint{color:#999;font-size:24rpx;margin-bottom:32rpx}.profile-empty-btn{background:#e8a838;border-radius:40rpx;color:#fff;font-size:28rpx;font-weight:500;padding:16rpx 48rpx;transition:transform .15s ease,opacity .15s ease}.profile-empty-btn:active{opacity:.85;transform:scale(.97)}.profile-bottom-safe{height:40rpx}