.chat-home-page {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  display: flex;
  flex-direction: column;
  position: relative;
  animation: pageEnter 0.4s ease-out;
}

.chat-paw-particles {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.chat-paw {
  position: absolute;
  font-size: 32rpx;
  opacity: 0;
}
.chat-paw--1 {
  bottom: 20%;
  left: 8%;
  animation: pawFloat1 5s ease-out infinite;
  animation-delay: 0s;
}
.chat-paw--2 {
  bottom: 30%;
  right: 10%;
  animation: pawFloat2 6s ease-out infinite;
  animation-delay: 2s;
}
.chat-paw--3 {
  bottom: 15%;
  left: 45%;
  animation: pawFloat3 4.5s ease-out infinite;
  animation-delay: 1s;
}
.chat-paw--4 {
  bottom: 25%;
  right: 30%;
  animation: pawFloat1 5.5s ease-out infinite;
  animation-delay: 3s;
}
.chat-paw--5 {
  bottom: 10%;
  left: 25%;
  animation: pawFloat2 4.8s ease-out infinite;
  animation-delay: 0.5s;
}
.chat-paw--6 {
  bottom: 35%;
  left: 60%;
  animation: pawFloat3 5.2s ease-out infinite;
  animation-delay: 2.5s;
}

.chat-stars {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.chat-star {
  position: absolute;
  font-size: 16rpx;
  opacity: 0.25;
}
.chat-star--1 {
  top: 8%;
  right: 12%;
  animation: starTwinkle1 2.5s ease-in-out infinite;
}
.chat-star--2 {
  top: 15%;
  left: 8%;
  animation: starTwinkle2 3s ease-in-out infinite;
  animation-delay: 0.8s;
}
.chat-star--3 {
  top: 22%;
  right: 25%;
  animation: starTwinkle3 2.8s ease-in-out infinite;
  animation-delay: 1.6s;
}
.chat-star--4 {
  top: 5%;
  left: 35%;
  animation: starTwinkle1 3.2s ease-in-out infinite;
  animation-delay: 0.4s;
}
.chat-star--5 {
  top: 18%;
  left: 55%;
  animation: starTwinkle2 2.4s ease-in-out infinite;
  animation-delay: 1.2s;
}
.chat-star--6 {
  top: 10%;
  right: 40%;
  animation: starTwinkle3 3.5s ease-in-out infinite;
  animation-delay: 2s;
}

.chat-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: rgba(var(--bg-page, #1A1418), 0.94);
  backdrop-filter: blur(24rpx);
  border-bottom: 1rpx solid var(--border-light, rgba(200, 142, 168, 0.08));
  position: sticky;
  top: 0;
  z-index: 50;
}

.chat-top-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chat-pet-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--gradient-warm, linear-gradient(135deg, #C88EA8, #D8A8B8, #E8C8D8));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  box-shadow: 0 0 20rpx rgba(var(--primary, #C88EA8), 0.3);
  animation: warmBreathe 3s ease-in-out infinite;
}

.chat-top-info {
  display: flex;
  flex-direction: column;
}

.chat-pet-name {
  font-size: 32rpx;
  font-weight: 700;
  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.chat-pet-detail {
  font-size: 22rpx;
  color: var(--text-hint, #988898);
  margin-top: 2rpx;
}

.chat-switch-btn {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: var(--primary-light, #E8C8D8);
  transition: all 0.2s ease;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.chat-switch-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.chat-msg-list {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  position: relative;
  z-index: 1;
}

.msg-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
  animation: msgBounceIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.msg-row.ai {
  align-self: flex-start;
  max-width: 88%;
}

.msg-row.user {
  align-self: flex-end;
  max-width: 80%;
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.msg-row.ai .msg-avatar {
  background: linear-gradient(135deg, var(--teal, #7EA8A0), #3A7879);
  box-shadow: 0 0 16rpx rgba(var(--teal, #7EA8A0), 0.3);
}

.msg-row.user .msg-avatar {
  background: var(--gradient-warm, linear-gradient(135deg, #C88EA8, #D8A8B8, #E8C8D8));
  box-shadow: 0 0 16rpx rgba(var(--primary, #C88EA8), 0.3);
}

.msg-bubble-wrap {
  flex: 1;
  min-width: 0;
}

.msg-bubble {
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-primary, #E8D8DE);
  word-break: break-all;
}

.msg-row.ai .msg-bubble {
  background: var(--bg-card, #2A1E24);
  border-top-left-radius: 8rpx;
  border: 1rpx solid var(--border-light, rgba(200, 142, 168, 0.08));
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.msg-row.user .msg-bubble {
  background: var(--gradient-card, linear-gradient(135deg, rgba(200, 142, 168, 0.12), rgba(200, 142, 168, 0.04)));
  border-top-right-radius: 8rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.msg-bubble--streaming {
  cursor: pointer;
}

.streaming-cursor {
  display: inline-block;
  margin-left: 4rpx;
  color: var(--primary, #C88EA8);
  animation: blink 0.8s steps(2) infinite;
  font-weight: bold;
}

.streaming-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary, #A098A0);
  text-align: right;
  opacity: 0.7;
  animation: fadeInUp 0.3s ease-out;
}

@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}
.msg-quick-actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
  animation: fadeInUp 0.35s ease-out 0.1s both;
}

.msg-quick-btn {
  background: var(--bg-card, #2A1E24);
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  color: var(--primary-light, #E8C8D8);
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.msg-quick-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.msg-quick-btn:active {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-color: var(--primary, #C88EA8);
  box-shadow: 0 0 16rpx rgba(var(--primary, #C88EA8), 0.2);
}

.msg-options-list {
  margin-top: 18rpx;
  animation: fadeInUp 0.35s ease-out 0.05s both;
}

.msg-option {
  display: block;
  width: 100%;
  text-align: left;
  background: rgba(var(--bg-card, #2A1E24), 0.8);
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  color: var(--text-primary, #E8D8DE);
  padding: 26rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.msg-option:active {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-color: var(--primary, #C88EA8);
  transform: scale(0.98);
  box-shadow: 0 0 16rpx rgba(var(--primary, #C88EA8), 0.15);
}
.msg-option:last-child {
  margin-bottom: 0;
}

.typing-bubble {
  padding: 16rpx 32rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  padding: 8rpx 0;
  align-items: center;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--primary-light, #E8C8D8);
  animation: dotBounce 1.4s ease-in-out infinite both;
}
.typing-dot:nth-child(1) {
  animation-delay: 0s;
}
.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}
.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

.chat-bottom-spacer {
  height: 80rpx;
}

.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  padding: 0 60rpx;
  animation: fadeInUp 0.6s ease-out;
}
.chat-empty .chat-empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  animation: pulse 3s ease-in-out infinite;
}
.chat-empty .chat-empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
  margin-bottom: 16rpx;
  text-align: center;
}
.chat-empty .chat-empty-desc {
  font-size: 28rpx;
  color: var(--text-secondary, #A098A0);
  text-align: center;
  line-height: 1.8;
  margin-bottom: 48rpx;
}
.chat-empty .chat-empty-btn {
  padding: 24rpx 80rpx;
  border-radius: 999rpx;
  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
  transition: all 0.2s ease;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.chat-empty .chat-empty-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.chat-empty .chat-empty-btn .chat-empty-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-inverse, #1A1418);
}

.chat-input-area {
  position: sticky;
  bottom: 0;
  padding: 20rpx 32rpx 0;
  background: rgba(var(--bg-page, #1A1418), 0.96);
  backdrop-filter: blur(24rpx);
  z-index: 99;
}

.chat-input-safe {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  min-height: 24rpx;
}

.chat-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  transition: all 0.25s ease;
}
.chat-input-row:focus-within {
  border-color: var(--primary, #C88EA8);
  box-shadow: 0 0 20rpx rgba(var(--primary, #C88EA8), 0.12);
}

.chat-plus-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}
.chat-plus-btn:active {
  background: rgba(var(--primary, #C88EA8), 0.2);
  transform: rotate(90deg) scale(0.9);
}

.chat-plus-text {
  font-size: 40rpx;
  color: var(--primary-light, #E8C8D8);
  line-height: 1;
}

.chat-input-field {
  flex: 1;
  background: transparent;
  border: none;
  color: var(--text-primary, #E8D8DE);
  font-size: 28rpx;
  padding: 12rpx 0;
  height: 72rpx;
  line-height: 72rpx;
}

.chat-send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s cubic-bezier(0.22, 0.61, 0.36, 1);
  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.3);
}
.chat-send-btn:active {
  transform: scale(0.88);
  box-shadow: 0 2rpx 8rpx rgba(var(--primary, #C88EA8), 0.2);
}

.chat-send-text {
  font-size: 36rpx;
  color: var(--text-inverse, #1A1418);
  font-weight: 700;
  line-height: 1;
}

.chat-plus-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  animation: fadeIn 0.2s ease-out;
}

.chat-plus-menu {
  position: absolute;
  bottom: 130rpx;
  left: 32rpx;
  right: 32rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 32rpx;
  padding: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.5);
  animation: popupBounceIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  z-index: 100;
}

.plus-menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  transition: all 0.15s ease;
}
.plus-menu-item:active {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  transform: scale(0.98);
}

.plus-menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plus-menu-icon {
  font-size: 36rpx;
}

.plus-menu-text {
  display: flex;
  flex-direction: column;
}

.plus-menu-label {
  font-size: 28rpx;
  color: var(--text-primary, #E8D8DE);
  font-weight: 500;
}

.plus-menu-sub {
  font-size: 22rpx;
  color: var(--text-hint, #988898);
  margin-top: 4rpx;
}

.msg-card {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  animation: fadeInUp 0.4s ease-out 0.05s both;
  animation: warmBreathe 3s ease-in-out infinite;
}

.msg-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-light, #E8C8D8);
  margin-bottom: 12rpx;
  display: block;
}

.msg-card-text {
  font-size: 24rpx;
  color: var(--text-hint, #988898);
  line-height: 1.6;
  display: block;
}

.msg-card-stat {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.msg-card-stat-label {
  color: var(--text-hint, #988898);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.msg-card-stat-val {
  color: var(--primary-light, #E8C8D8);
  font-weight: 600;
}

.score-stars {
  color: var(--primary, #C88EA8);
  font-size: 32rpx;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
  animation: pulse 2s ease-in-out infinite;
}

.msg-card-alert {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.msg-card-alert--danger {
  background: var(--danger-light, rgba(200, 112, 112, 0.12));
  border: 1rpx solid rgba(224, 133, 107, 0.3);
  color: var(--danger, #C87070);
}
.msg-card-alert--safe {
  background: rgba(140, 173, 126, 0.1);
  border: 1rpx solid rgba(140, 173, 126, 0.3);
  color: var(--sage, #8EA898);
}

.msg-card-hospital {
  margin-top: 16rpx;
  padding: 20rpx;
  background: rgba(224, 133, 107, 0.08);
  border: 1rpx solid rgba(224, 133, 107, 0.25);
  border-radius: 24rpx;
  text-align: center;
}

.msg-card-hospital-title {
  font-size: 26rpx;
  color: var(--danger, #C87070);
  font-weight: 600;
  margin-bottom: 12rpx;
  display: block;
}

.msg-card-hospital-item {
  font-size: 24rpx;
  color: var(--text-hint, #988898);
  line-height: 1.8;
  display: block;
}

.msg-naming-card {
  margin-top: 16rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 24rpx;
  padding: 24rpx;
  position: relative;
  animation: fadeInUp 0.4s ease-out 0.05s both;
}

.msg-naming-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-light, #E8C8D8);
  display: block;
  margin-bottom: 8rpx;
}

.msg-naming-meaning {
  font-size: 24rpx;
  color: var(--text-hint, #988898);
  line-height: 1.6;
  display: block;
}

.msg-naming-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  padding: 4rpx 14rpx;
  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
  color: var(--text-inverse, #1A1418);
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(var(--primary, #C88EA8), 0.3);
}
