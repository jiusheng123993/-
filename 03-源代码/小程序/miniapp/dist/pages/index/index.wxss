.home-page{background:#f5f7fa;min-height:100vh}.home-header{align-items:center;background:#fff;display:flex;justify-content:space-between;padding:24rpx 32rpx}.home-header-title{color:#1a1a1a;font-size:36rpx;font-weight:600}.home-header-right{align-items:center;background:#f5f7fa;border-radius:999rpx;display:flex;height:64rpx;justify-content:center;transition:transform .15s ease,opacity .15s ease;width:64rpx}.home-header-right:active{opacity:.85;transform:scale(.97)}.home-settings-icon{font-size:32rpx}.home-pet-card{align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);display:flex;justify-content:space-between;margin:16rpx 32rpx;padding:24rpx;transition:transform .15s ease,opacity .15s ease}.home-pet-card:active{opacity:.85;transform:scale(.97)}.home-pet-card-left{align-items:center;display:flex;gap:16rpx}.home-pet-avatar{align-items:center;background:#fff8ee;border-radius:999rpx;display:flex;font-size:40rpx;height:80rpx;justify-content:center;width:80rpx}.home-pet-info{display:flex;flex-direction:column;gap:4rpx}.home-pet-name{color:#1a1a1a;font-size:32rpx;font-weight:600}.home-pet-detail{color:#999;font-size:24rpx}.home-pet-switch{color:#e8a838;font-size:24rpx}.home-pet-dropdown{background:#fff;border-radius:0 0 16rpx 16rpx;box-shadow:0 4rpx 16rpx rgba(0,0,0,.08);margin:-8rpx 32rpx 0;overflow:hidden}.home-pet-dropdown-item{align-items:center;border-bottom:1rpx solid #f0f0f0;color:#1a1a1a;display:flex;font-size:28rpx;justify-content:space-between;padding:20rpx 24rpx;transition:transform .15s ease,opacity .15s ease}.home-pet-dropdown-item:active{opacity:.85;transform:scale(.97)}.home-pet-dropdown-item:last-child{border-bottom:none}.home-pet-dropdown-item-active{background:#fff8ee;color:#e8a838}.home-pet-check{color:#e8a838;font-weight:600}.home-avatar-section{margin:16rpx 32rpx}.home-avatar-card{align-items:center;background:linear-gradient(135deg,#fff8ee,#d4e4fc);border-radius:20rpx;display:flex;height:320rpx;justify-content:center;overflow:hidden}.home-avatar-placeholder{align-items:center;display:flex;flex-direction:column;gap:12rpx}.home-avatar-emoji{font-size:80rpx}.home-avatar-mood{color:#e8a838;font-size:28rpx;font-weight:500}.home-checkin-section{margin:16rpx 32rpx}.home-checkin-card{align-items:center;background:linear-gradient(135deg,#e8a838,#f5d78c);border-radius:20rpx;display:flex;flex-direction:column;gap:20rpx;padding:32rpx}.home-checkin-title{color:#fff;font-size:32rpx;font-weight:600}.home-checkin-btn{background:#fff;border-radius:40rpx;height:80rpx;line-height:80rpx;text-align:center;transition:transform .15s ease,opacity .15s ease;width:320rpx}.home-checkin-btn:active{opacity:.85;transform:scale(.97)}.home-checkin-btn-text{color:#e8a838;font-size:30rpx;font-weight:600}.home-checkin-streak{background:hsla(0,0%,100%,.2);border-radius:20rpx;padding:8rpx 24rpx}.home-checkin-streak-text{color:#fff;font-size:24rpx}.home-section{margin:0 32rpx 16rpx}.home-section-title{color:#1a1a1a;display:block;font-size:30rpx;font-weight:600;margin-bottom:16rpx}.home-quick-actions{display:grid;gap:12rpx;grid-template-columns:repeat(4,1fr)}.home-quick-action{align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);display:flex;flex-direction:column;gap:8rpx;padding:20rpx 8rpx;transition:transform .15s ease,opacity .15s ease}.home-quick-action:active{opacity:.85;transform:scale(.97)}.home-quick-icon{align-items:center;border-radius:18rpx;display:flex;font-size:32rpx;height:72rpx;justify-content:center;width:72rpx}.home-quick-label{color:#1a1a1a;font-size:22rpx;font-weight:500}.home-vaccine-card{align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);display:flex;justify-content:space-between;padding:24rpx;transition:transform .15s ease,opacity .15s ease}.home-vaccine-card:active{opacity:.85;transform:scale(.97)}.home-vaccine-left{align-items:center;display:flex;gap:16rpx}.home-vaccine-icon{font-size:40rpx}.home-vaccine-label{color:#999;display:block;font-size:22rpx}.home-vaccine-text{color:#1a1a1a;font-size:28rpx;font-weight:500}.home-vaccine-arrow{color:#ccc;font-size:36rpx}.home-tip-card{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);padding:24rpx}.home-tip-header{align-items:center;display:flex;gap:8rpx;margin-bottom:12rpx}.home-tip-icon{font-size:28rpx}.home-tip-label{color:#1a1a1a;font-size:26rpx;font-weight:600}.home-tip-text{color:#666;font-size:26rpx;line-height:1.6}.home-empty{align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);display:flex;flex-direction:column;padding:60rpx 32rpx}.home-empty-icon{font-size:80rpx;margin-bottom:16rpx}.home-empty-text{color:#1a1a1a;font-size:30rpx;font-weight:500;margin-bottom:8rpx}.home-empty-hint{color:#999;font-size:24rpx;margin-bottom:32rpx}.home-empty-btn{background:#e8a838;border-radius:40rpx;color:#fff;font-size:28rpx;font-weight:500;padding:16rpx 48rpx;transition:transform .15s ease,opacity .15s ease}.home-empty-btn:active{opacity:.85;transform:scale(.97)}.home-member-section{margin:16rpx 32rpx}.home-member-banner{align-items:center;background:linear-gradient(135deg,#fff8e8,#fff0d0);border-radius:16rpx;display:flex;justify-content:space-between;padding:24rpx;transition:transform .15s ease,opacity .15s ease}.home-member-banner:active{opacity:.85;transform:scale(.97)}.home-member-level{color:#1a1a1a;display:block;font-size:28rpx;font-weight:600}.home-member-hint{color:#999;display:block;font-size:24rpx;margin-top:4rpx}.home-member-btn{background:linear-gradient(135deg,gold,orange);border-radius:24rpx;color:#fff;font-size:26rpx;font-weight:600;padding:12rpx 28rpx;transition:transform .15s ease,opacity .15s ease}.home-member-btn:active{opacity:.85;transform:scale(.97)}.home-bottom-safe{height:40rpx}