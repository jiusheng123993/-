.login-page{align-items:center;background:linear-gradient(180deg,#f5f7fa,#e8f0fe);display:flex;flex-direction:column;justify-content:center;min-height:100vh;padding:40rpx 32rpx}.login-logo{align-items:center;background:#fff;border-radius:32rpx;box-shadow:0 8rpx 24rpx rgba(74,144,217,.12);display:flex;font-size:48rpx;height:160rpx;justify-content:center;margin-bottom:24rpx;width:160rpx}.login-title{color:#1a1a1a;font-size:36rpx;font-weight:600;margin-bottom:12rpx}.login-subtitle{color:#666;font-size:28rpx;line-height:1.6;margin-bottom:80rpx;text-align:center}.login-btn{background:#4a90d9;border:none;border-radius:48rpx;box-shadow:0 4rpx 12rpx rgba(74,144,217,.3);color:#fff;font-size:32rpx;font-weight:500;height:96rpx;line-height:96rpx;margin-bottom:24rpx;text-align:center;width:100%}.login-btn:active{opacity:.8}.login-btn-loading{opacity:.6}.login-agreement{color:#999;font-size:24rpx;line-height:1.6;text-align:center}.login-agreement-link{color:#4a90d9}.login-error{color:#f5222d;font-size:26rpx;margin-bottom:24rpx;text-align:center}