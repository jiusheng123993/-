.member-page{background:#f5f7fa;min-height:100vh}.member-header{align-items:center;background:#fff;display:flex;justify-content:space-between;padding:24rpx 32rpx}.member-header-title{color:#1a1a1a;font-size:36rpx;font-weight:700}.member-badge{background:linear-gradient(135deg,gold,orange);border-radius:20rpx;color:#fff;font-size:24rpx;font-weight:700;padding:8rpx 20rpx}.member-hero{border-radius:20rpx;margin:16rpx 32rpx;overflow:hidden;position:relative}.member-hero-bg{background:linear-gradient(135deg,#4a90d9,#7bb3e8);bottom:0;left:0;position:absolute;right:0;top:0}.member-hero-content{align-items:center;display:flex;flex-direction:column;padding:48rpx 32rpx;position:relative}.member-hero-icon{font-size:64rpx;margin-bottom:16rpx}.member-hero-title{color:#fff;font-size:34rpx;font-weight:700;margin-bottom:12rpx}.member-hero-desc{color:hsla(0,0%,100%,.8);font-size:26rpx;line-height:1.5;text-align:center}.member-section{margin:16rpx 32rpx}.member-section-title{color:#1a1a1a;display:block;font-size:32rpx;font-weight:700;margin-bottom:16rpx}.member-benefits{display:grid;gap:12rpx;grid-template-columns:repeat(3,1fr)}.member-benefit-item{align-items:center;background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);display:flex;flex-direction:column;padding:24rpx 12rpx}.member-benefit-icon{font-size:36rpx;margin-bottom:8rpx}.member-benefit-title{color:#1a1a1a;font-size:24rpx;font-weight:500;margin-bottom:4rpx}.member-benefit-desc{color:#999;font-size:20rpx;text-align:center}.member-plans{display:flex;gap:16rpx}.member-plan-card{background:#fff;border:2rpx solid #e8e8e8;border-radius:16rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);flex:1;padding:32rpx 24rpx;position:relative;transition:transform .15s ease,opacity .15s ease}.member-plan-card:active{opacity:.85;transform:scale(.97)}.member-plan-card-active{background:#e8f0fe;border-color:#4a90d9}.member-plan-tag{background:linear-gradient(135deg,gold,orange);border-radius:0 14rpx 0 14rpx;color:#fff;font-size:20rpx;font-weight:700;padding:6rpx 16rpx;position:absolute;right:0;top:0}.member-plan-name{color:#1a1a1a;display:block;font-size:28rpx;font-weight:700;margin-bottom:12rpx}.member-plan-price-row{align-items:baseline;display:flex;margin-bottom:8rpx}.member-plan-price{color:#4a90d9;font-size:40rpx;font-weight:700}.member-plan-period{color:#999;font-size:24rpx}.member-plan-original{color:#999;display:block;font-size:22rpx;margin-bottom:24rpx;text-decoration:line-through}.member-plan-features{display:flex;flex-direction:column;gap:12rpx}.member-plan-feature{align-items:center;display:flex;gap:8rpx}.member-plan-check{color:#4a90d9;font-size:22rpx;font-weight:700}.member-plan-feature-text{color:#666;font-size:22rpx}.member-subscribe-btn{background:linear-gradient(135deg,#4a90d9,#7bb3e8);border-radius:48rpx;box-shadow:0 4rpx 16rpx rgba(74,144,217,.3);color:#fff;font-size:32rpx;font-weight:700;height:96rpx;line-height:96rpx;text-align:center;transition:transform .15s ease,opacity .15s ease}.member-subscribe-btn:active{opacity:.85;transform:scale(.97)}.member-subscribe-hint{color:#999;display:block;font-size:22rpx;margin-top:16rpx;text-align:center}.member-manage-card{background:#fff;border-radius:8rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);padding:24rpx}.member-manage-item{align-items:center;border-bottom:1rpx solid #f0f0f0;display:flex;justify-content:space-between;padding:16rpx 0}.member-manage-item:last-child{border-bottom:none}.member-manage-label{color:#666;font-size:26rpx}.member-manage-value{color:#1a1a1a;font-size:26rpx;font-weight:500}.member-bottom-safe{height:40rpx}