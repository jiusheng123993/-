x;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);margin:0 32rpx 16rpx;overflow:hidden}.mine-menu-item{align-items:center;border-bottom:1rpx solid #f0f0f0;display:flex;padding:28rpx 24rpx;transition:transform .15s ease,opacity .15s ease}.mine-menu-item:active{opacity:.85;transform:scale(.97)}.mine-menu-item:last-child{border-bottom:none}.mine-menu-icon{font-size:32rpx;margin-right:16rpx}.mine-menu-label{color:#1a1a1a;flex:1;font-size:28rpx}.mine-menu-arrow{color:#999;font-size:32rpx}.mine-section{margin:16rpx 32rpx}.mine-logout-btn{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 4rpx rgba(0,0,0,.04);color:#f5222d;font-size:28rpx;height:88rpx;line-height:88rpx;text-align:center;transition:transform .15s ease,opacity .15s ease}.mine-logout-btn:active{opacity:.85;transform:scale(.97)}.mine-bottom-safe{height:40rpx}