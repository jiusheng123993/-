.breed-page{background:#f8f4e9;min-height:100vh;padding-bottom:120rpx}.breed-page__header{padding:32rpx 24rpx 12rpx;text-align:center}.breed-page__title{color:#2c2c2c;display:block;font-size:48rpx;font-weight:700}.breed-page__subtitle{color:#8c8c8c;display:block;font-size:22rpx;margin-top:8rpx}.breed-page__search{margin-bottom:12rpx;padding:0 24rpx}.breed-page__search-wrapper{align-items:center;background:#fff;border-radius:999rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);display:flex;height:72rpx;padding:0 24rpx}.breed-page__search-icon{flex-shrink:0;font-size:28rpx;margin-right:12rpx}.breed-page__search-input{color:#2c2c2c;flex:1;font-size:22rpx;height:72rpx}.breed-page__search-placeholder{color:#8c8c8c;font-size:22rpx}.breed-page__search-clear{align-items:center;display:flex;flex-shrink:0;height:40rpx;justify-content:center;width:40rpx}.breed-page__search-clear-icon{color:#8c8c8c;font-size:24rpx}.breed-page__filters{margin-bottom:12rpx;padding:0 24rpx}.breed-page__filter-row{margin-bottom:8rpx;white-space:nowrap}.breed-page__filter-chip{background:#fff;border-radius:24rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);color:#4a4a4a;display:inline-block;font-size:22rpx;margin-right:8rpx;padding:10rpx 24rpx;transition:all .2s ease}.breed-page__filter-chip--active{background:#b03a2e;color:#f8f4e9}.breed-page__count{padding:8rpx 24rpx}.breed-page__count-text{color:#8c8c8c;font-size:22rpx}.breed-page__list{height:calc(100vh - 420rpx);padding:0 24rpx}.breed-page__grid{display:flex;flex-direction:column;gap:12rpx}.breed-page__card{align-items:center;background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);display:flex;gap:16rpx;padding:24rpx;position:relative;transition:all .2s ease}.breed-page__card:active{box-shadow:0 4rpx 16rpx rgba(0,0,0,.1);transform:scale(.98)}.breed-page__card-emoji{align-items:center;background:#f5f0e3;border-radius:16rpx;display:flex;flex-shrink:0;height:80rpx;justify-content:center;width:80rpx}.breed-page__card-emoji-text{font-size:44rpx}.breed-page__card-body{flex:1;min-width:0}.breed-page__card-name{color:#2c2c2c;display:block;font-size:32rpx;font-weight:500;margin-bottom:8rpx}.breed-page__card-meta{display:flex;gap:16rpx;margin-bottom:8rpx}.breed-page__card-meta-item{color:#8c8c8c;font-size:22rpx}.breed-page__card-tags{display:flex;flex-wrap:wrap;gap:6rpx}.breed-page__card-tag{background:rgba(176,58,46,.1);border-radius:12rpx;color:#b03a2e;font-size:20rpx;padding:2rpx 10rpx}.breed-page__card-arrow{color:#8c8c8c;flex-shrink:0;font-size:36rpx}.breed-page__empty{align-items:center;display:flex;flex-direction:column;padding:80rpx 0}.breed-page__empty-icon{font-size:64rpx;margin-bottom:16rpx}.breed-page__empty-text{color:#8c8c8c;font-size:28rpx}.breed-page__load-more{padding:24rpx 0;text-align:center}.breed-page__load-more-text{color:#8c8c8c;font-size:22rpx}.breed-page__disclaimer{backdrop-filter:blur(8rpx);background:hsla(44,52%,94%,.95);bottom:0;left:0;padding:12rpx 24rpx;position:fixed;right:0}.breed-page__disclaimer-text{color:#8c8c8c;font-size:20rpx;line-height:1.5}