.app-root {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
}

page {
  background: transparent;
  color: var(--text-primary, #E8D8DE);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
  color: var(--text-inverse, #1A1418);
  border: none;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.25);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.btn-outline {
  background: transparent;
  border: 1rpx solid var(--primary, #C88EA8);
  color: var(--primary, #C88EA8);
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.btn-outline:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.card {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.card-warm {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 24rpx;
  margin-bottom: 16rpx;
  animation: warmBreathe 3s ease-in-out infinite;
}

::-webkit-scrollbar {
  width: 3rpx;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(var(--primary, #C88EA8), 0.3);
  border-radius: 3rpx;
}

.safe-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
  min-height: 24rpx;
}

.paw-particles {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.paw-particle {
  position: absolute;
  font-size: 28rpx;
  opacity: 0;
  animation-timing-function: ease-out;
  animation-fill-mode: forwards;
}
.paw-particle--1 {
  animation: pawFloat1 4s ease-out infinite;
  animation-delay: 0s;
}
.paw-particle--2 {
  animation: pawFloat2 5s ease-out infinite;
  animation-delay: 1.5s;
}
.paw-particle--3 {
  animation: pawFloat3 4.5s ease-out infinite;
  animation-delay: 3s;
}
.paw-particle--4 {
  animation: pawFloat1 5.5s ease-out infinite;
  animation-delay: 0.5s;
}
.paw-particle--5 {
  animation: pawFloat2 4.2s ease-out infinite;
  animation-delay: 2.5s;
}
.paw-particle--6 {
  animation: pawFloat3 5.8s ease-out infinite;
  animation-delay: 4s;
}

.star-particles {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

.star-particle {
  position: absolute;
  font-size: 20rpx;
  opacity: 0.3;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.star-particle--1 {
  animation: starTwinkle1 2.5s ease-in-out infinite;
  animation-delay: 0s;
}
.star-particle--2 {
  animation: starTwinkle2 3s ease-in-out infinite;
  animation-delay: 0.8s;
}
.star-particle--3 {
  animation: starTwinkle3 2.8s ease-in-out infinite;
  animation-delay: 1.6s;
}
.star-particle--4 {
  animation: starTwinkle1 3.2s ease-in-out infinite;
  animation-delay: 0.4s;
}
.star-particle--5 {
  animation: starTwinkle2 2.4s ease-in-out infinite;
  animation-delay: 1.2s;
}
.star-particle--6 {
  animation: starTwinkle3 3.5s ease-in-out infinite;
  animation-delay: 2s;
}
.star-particle--7 {
  animation: starTwinkle1 2.7s ease-in-out infinite;
  animation-delay: 0.2s;
}
.star-particle--8 {
  animation: starTwinkle2 2.9s ease-in-out infinite;
  animation-delay: 1.5s;
}

.light-particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: var(--primary-light, #E8C8D8);
  animation: particleRise 3s ease-out infinite;
}
.light-particle--1 {
  animation-delay: 0s;
  left: 10%;
}
.light-particle--2 {
  animation-delay: 1s;
  left: 25%;
}
.light-particle--3 {
  animation-delay: 2s;
  left: 40%;
}
.light-particle--4 {
  animation-delay: 0.5s;
  left: 55%;
}
.light-particle--5 {
  animation-delay: 1.5s;
  left: 70%;
}
.light-particle--6 {
  animation-delay: 2.5s;
  left: 85%;
}

.breed-page {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  padding-bottom: 120rpx;
  animation: pageEnter 0.4s ease-out;
}
.breed-page__header {
  padding: 32rpx 24rpx 12rpx;
  text-align: center;
}
.breed-page__title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
  display: block;
}
.breed-page__subtitle {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  margin-top: 8rpx;
  display: block;
}
.breed-page__search {
  padding: 0 24rpx;
  margin-bottom: 12rpx;
}
.breed-page__search-wrapper {
  display: flex;
  align-items: center;
  background: var(--bg-card, #2A1E24);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}
.breed-page__search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.breed-page__search-input {
  flex: 1;
  height: 72rpx;
  font-size: 20rpx;
  color: var(--text-primary, #E8D8DE);
}
.breed-page__search-placeholder {
  color: var(--text-tertiary, #786870);
  font-size: 20rpx;
}
.breed-page__search-clear {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.breed-page__search-clear-icon {
  font-size: 24rpx;
  color: var(--text-tertiary, #786870);
}
.breed-page__filters {
  padding: 0 24rpx;
  margin-bottom: 12rpx;
}
.breed-page__filter-row {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.breed-page__filter-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 8rpx;
  background: var(--bg-card, #2A1E24);
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 20rpx;
  font-size: 20rpx;
  color: var(--text-secondary, #A098A0);
  transition: all 0.15s ease;
}
.breed-page__filter-chip--active {
  background: var(--primary, #C88EA8);
  color: var(--text-inverse, #1A1418);
  border-color: var(--primary, #C88EA8);
}
.breed-page__count {
  padding: 8rpx 24rpx;
}
.breed-page__count-text {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}
.breed-page__list {
  padding: 0 24rpx;
  height: calc(100vh - 420rpx);
}
.breed-page__grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.breed-page__card {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  transition: all 0.15s ease;
  animation: cardStaggerIn 0.4s ease-out both;
}
.breed-page__card:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.breed-page__card-emoji {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.breed-page__card-emoji-text {
  font-size: 44rpx;
}
.breed-page__card-body {
  flex: 1;
  min-width: 0;
}
.breed-page__card-name {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary, #E8D8DE);
  display: block;
  margin-bottom: 8rpx;
}
.breed-page__card-meta {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.breed-page__card-meta-item {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}
.breed-page__card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}
.breed-page__card-tag {
  padding: 2rpx 10rpx;
  background: rgba(var(--primary, #C88EA8), 0.12);
  border-radius: 12rpx;
  font-size: 20rpx;
  color: var(--primary-light, #E8C8D8);
}
.breed-page__card-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary, #786870);
  flex-shrink: 0;
}
.breed-page__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  animation: fadeInScale 0.4s ease-out;
}
.breed-page__empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}
.breed-page__empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
}
.breed-page__load-more {
  padding: 24rpx 0;
  text-align: center;
}
.breed-page__load-more-text {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
}
.breed-page__disclaimer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx 24rpx;
  background: rgba(var(--bg-card, #2A1E24), 0.95);
  backdrop-filter: blur(8rpx);
  border-top: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}
.breed-page__disclaimer-text {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  line-height: 1.5;
}
