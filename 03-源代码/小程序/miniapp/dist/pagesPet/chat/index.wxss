.chat-container{background:#0f1724;display:flex;flex-direction:column;height:100vh;overflow:hidden}.chat-header{align-items:center;backdrop-filter:blur(20rpx);background:rgba(15,23,36,.95);border-bottom:1rpx solid hsla(0,0%,100%,.04);display:flex;flex-direction:row;flex-shrink:0;padding:calc(12rpx + env(safe-area-inset-top)) 16rpx 12rpx}.pet-avatar{align-items:center;background:linear-gradient(135deg,#8cad7e,#6b9070);border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:16rpx;font-weight:600;height:36rpx;justify-content:center;width:36rpx}.msg-list{flex:1;overflow-y:auto;padding:16rpx 16rpx 120rpx}.msg-row{display:flex;flex-direction:column;margin-bottom:16rpx}.msg-row.assistant{align-items:flex-start}.msg-row.user{align-items:flex-end}.msg-bubble{border-radius:18rpx;font-size:14rpx;line-height:1.65;max-width:80%;padding:12rpx 16rpx;word-break:break-word}.msg-bubble.assistant{background:linear-gradient(135deg,rgba(232,168,56,.12),hsla(43,84%,75%,.06));border:1rpx solid rgba(232,168,56,.15);border-bottom-left-radius:6rpx;color:#e8dfd5}.msg-bubble.user{background:rgba(26,35,50,.9);border:1rpx solid rgba(232,168,56,.35);border-bottom-right-radius:6rpx;color:#f5d78c}.quick-actions{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:8rpx}.quick-btn{background:rgba(232,168,56,.1);border:1rpx solid rgba(232,168,56,.25);border-radius:20rpx;color:#f5d78c;font-size:13rpx;padding:8rpx 16rpx}.input-area{align-items:center;backdrop-filter:blur(20rpx);background:rgba(10,15,26,.95);border-top:1rpx solid hsla(0,0%,100%,.06);bottom:0;box-sizing:border-box;display:flex;gap:8rpx;left:50%;max-width:414rpx;padding:12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));position:fixed;transform:translateX(-50%);width:100%}.chat-input{background:hsla(0,0%,100%,.06);border:1rpx solid hsla(0,0%,100%,.1);border-radius:18rpx;box-sizing:border-box;color:#e8dfd5;flex:1;font-size:14rpx;height:36rpx;line-height:36rpx;padding:0 14rpx}.plus-btn{align-items:center;background:rgba(232,168,56,.1);border:1rpx solid rgba(232,168,56,.2);border-radius:50%;display:flex;flex-shrink:0;height:36rpx;justify-content:center;width:36rpx}.send-btn{align-items:center;background:linear-gradient(135deg,#e8a838,#c88520);border-radius:50%;display:flex;flex-shrink:0;height:36rpx;justify-content:center;width:36rpx}.func-menu{backdrop-filter:blur(20rpx);background:rgba(10,15,26,.98);border-top:1rpx solid hsla(0,0%,100%,.06);bottom:72rpx;box-sizing:border-box;display:flex;justify-content:space-around;left:50%;max-width:414rpx;padding:16rpx;position:fixed;transform:translateX(-50%);width:100%}.func-menu-item{align-items:center;display:flex;flex-direction:column;gap:4rpx}.typing-indicator{align-items:flex-start;display:flex;padding:8rpx 0}.typing-bubble{background:rgba(26,35,50,.6);border:1rpx solid rgba(232,168,56,.1);border-radius:18rpx;border-bottom-left-radius:6rpx;color:#89a;font-size:13rpx;padding:12rpx 16rpx}