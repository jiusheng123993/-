.pet-trends-page {
  min-height: 100vh;
  background-color: var(--bg-page, #1A1418);
  padding-bottom: 160rpx;
}

.pet-trends__time-range {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
}

.pet-trends__time-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  transition: all 0.25s ease;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.pet-trends__time-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.pet-trends__time-btn--active {
  background: rgba(var(--primary, #C88EA8), 0.08);
  border-color: var(--primary, #C88EA8);
}
.pet-trends__time-btn--active .pet-trends__time-btn-text {
  color: var(--primary, #C88EA8);
  font-weight: 600;
}

.pet-trends__time-btn-text {
  font-size: 24rpx;
  color: var(--text-secondary, #A098A0);
}

.pet-trends__tabs {
  display: flex;
  margin: 0 32rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 8rpx;
}

.pet-trends__tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-radius: 28rpx;
  transition: all 0.25s ease;
}
.pet-trends__tab--active {
  background: rgba(var(--primary, #C88EA8), 0.08);
}
.pet-trends__tab--active .pet-trends__tab-text {
  color: var(--primary, #C88EA8);
  font-weight: 600;
}

.pet-trends__tab-text {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
}

.pet-trends__content {
  flex: 1;
  padding: 20rpx 32rpx;
}

.pet-trends__chart-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trend-card {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
  animation: cardStaggerIn 0.4s ease-out both;
}

.trend-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.trend-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.trend-card__period {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
}

.trend-card__badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background-color: var(--danger, #C87070);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.trend-chart__container {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
}

.trend-chart__breed-range-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(140, 173, 126, 0.08);
  border-radius: 16rpx;
  border: 2rpx solid rgba(140, 173, 126, 0.2);
}

.trend-chart__breed-range-label {
  font-size: 20rpx;
  color: var(--success, #8EA898);
  font-weight: 500;
}

.trend-chart__breed-range-value {
  font-size: 20rpx;
  color: var(--success, #8EA898);
  font-weight: 600;
}
.trend-chart__breed-range-value--warning {
  color: var(--danger, #C87070);
}

.trend-chart__breed-range-warning {
  font-size: 22rpx;
  color: var(--danger, #C87070);
  font-weight: 600;
  margin-left: auto;
  padding: 4rpx 16rpx;
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
  border-radius: 12rpx;
  border: 1rpx solid rgba(224, 133, 107, 0.3);
}

/* 品种体重分析卡片 */
.trend-chart__breed-analysis {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid;
}
.trend-chart__breed-analysis--normal {
  background: rgba(140, 173, 126, 0.08);
  border-color: rgba(140, 173, 126, 0.2);
}
.trend-chart__breed-analysis--underweight {
  background: rgba(var(--primary, #C88EA8), 0.06);
  border-color: rgba(var(--primary, #C88EA8), 0.2);
}
.trend-chart__breed-analysis--overweight {
  background: rgba(var(--primary, #C88EA8), 0.08);
  border-color: rgba(var(--primary, #C88EA8), 0.25);
}
.trend-chart__breed-analysis--obese {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
  border-color: rgba(224, 133, 107, 0.3);
}

.trend-chart__breed-analysis-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.trend-chart__breed-analysis-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.trend-chart__breed-analysis-value {
  font-size: 20rpx;
  color: var(--text-secondary, #A098A0);
  font-weight: 500;
}

.trend-chart__breed-analysis-suggestion {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #A098A0);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.trend-chart__breed-trend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.trend-chart__breed-trend-label {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
}

.trend-chart__breed-trend-value {
  font-size: 20rpx;
  font-weight: 600;
}
.trend-chart__breed-trend-value--stable {
  color: var(--success, #8EA898);
}
.trend-chart__breed-trend-value--increasing {
  color: var(--primary, #C88EA8);
}
.trend-chart__breed-trend-value--decreasing {
  color: var(--danger, #C87070);
}

.trend-chart__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.trend-chart__empty-text {
  font-size: 30rpx;
  color: var(--text-tertiary, #786870);
  margin-bottom: 12rpx;
}

.trend-chart__empty-hint {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
}

.trend-chart__y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 80rpx;
  padding-right: 16rpx;
  flex-shrink: 0;
}

.trend-chart__y-label {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
  text-align: right;
}

.trend-chart__plot-area {
  flex: 1;
  position: relative;
}

.trend-chart__grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  pointer-events: none;
}

.trend-chart__grid-line {
  height: 1rpx;
  background-color: var(--primary-bg, rgba(200, 142, 168, 0.08));
}

.trend-chart__line-chart {
  position: relative;
  width: 100%;
}

.trend-chart__breed-range-zone {
  position: absolute;
  left: 0;
  right: 0;
  background-color: rgba(140, 173, 126, 0.08);
  pointer-events: none;
  z-index: 0;
}

.trend-chart__breed-range-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background-color: rgba(140, 173, 126, 0.4);
}
.trend-chart__breed-range-line--top {
  top: 0;
}
.trend-chart__breed-range-line--bottom {
  bottom: 0;
}

.trend-chart__svg-line {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.trend-chart__data-point {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.trend-chart__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--primary, #C88EA8);
  border: 3rpx solid var(--bg-card, #2A1E24);
  box-shadow: 0 2rpx 6rpx rgba(var(--primary, #C88EA8), 0.4);
}
.trend-chart__dot--abnormal {
  background-color: var(--danger, #C87070);
  border-color: rgba(224, 133, 107, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(224, 133, 107, 0.5);
}
.trend-chart__dot--out-of-range {
  background-color: var(--danger, #C87070);
  border-color: rgba(224, 133, 107, 0.2);
  box-shadow: 0 2rpx 8rpx rgba(224, 133, 107, 0.5);
}

.trend-chart__data-point--abnormal .trend-chart__point-value {
  color: var(--danger, #C87070);
}

.trend-chart__point-value {
  font-size: 20rpx;
  color: var(--primary, #C88EA8);
  margin-top: 4rpx;
  white-space: nowrap;
}
.trend-chart__point-value--out-of-range {
  color: var(--danger, #C87070);
}

.trend-chart__x-axis {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  overflow: hidden;
}

.trend-chart__x-label {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  text-align: center;
  flex-shrink: 0;
}

.trend-chart__bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 280rpx;
  padding-bottom: 8rpx;
  overflow-x: auto;
}

.trend-chart__bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 60rpx;
  flex-shrink: 0;
}
.trend-chart__bar-item--abnormal .trend-chart__bar-wrap {
  border: 2rpx solid var(--danger, #C87070);
}

.trend-chart__bar-mark {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid var(--danger, #C87070);
}

.trend-chart__bar-wrap {
  position: relative;
  width: 40rpx;
  height: 200rpx;
  border-radius: 8rpx 8rpx 0 0;
  background-color: var(--primary-bg, rgba(200, 142, 168, 0.08));
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.trend-chart__bar {
  width: 100%;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.25s ease;
}

.trend-chart__bar-label {
  font-size: 20rpx;
  color: var(--text-secondary, #A098A0);
  margin-top: 8rpx;
  white-space: nowrap;
}

.trend-chart__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.trend-chart__legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.trend-chart__legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.trend-chart__legend-text {
  font-size: 22rpx;
  color: var(--text-secondary, #A098A0);
}

.trend-summary {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.trend-summary__stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
  margin-bottom: 24rpx;
}

.trend-summary__stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.trend-summary__stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
}

.trend-summary__stat-label {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}

.trend-summary__ai-text {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.trend-summary__ai-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary, #C88EA8);
}

.trend-summary__ai-content {
  font-size: 28rpx;
  color: var(--text-secondary, #A098A0);
  line-height: 1.6;
}

.trend-summary__abnormal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trend-summary__abnormal-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: rgba(var(--primary, #C88EA8), 0.06);
  border-radius: 16rpx;
}

.trend-summary__abnormal-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.trend-summary__abnormal-date {
  font-size: 20rpx;
  color: var(--text-secondary, #A098A0);
  flex-shrink: 0;
}

.trend-summary__abnormal-desc {
  font-size: 20rpx;
  color: var(--text-primary, #E8D8DE);
}

.trend-summary__section {
  margin-bottom: 20rpx;
}
.trend-summary__section:last-child {
  margin-bottom: 0;
}

.trend-summary__section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
  margin-bottom: 12rpx;
}

.trend-summary__list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}

.trend-summary__list-dot {
  font-size: 20rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.trend-summary__list-text {
  font-size: 24rpx;
  color: var(--text-secondary, #A098A0);
  line-height: 1.6;
}

.export-section {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx;
  margin-top: 24rpx;
}
.export-section .preview-btn,
.export-section .export-btn,
.export-section .csv-btn,
.export-section .vet-btn,
.export-section .share-btn {
  flex: 1;
  min-width: calc(50% - 12rpx);
  height: 44rpx;
  line-height: 44rpx;
  border-radius: 22rpx;
  font-size: 15rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.export-section .preview-btn:active,
.export-section .export-btn:active,
.export-section .csv-btn:active,
.export-section .vet-btn:active,
.export-section .share-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}
.export-section .preview-btn {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  color: var(--text-secondary, #A098A0);
}
.export-section .export-btn {
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
  color: #FFFFFF;
}
.export-section .csv-btn {
  background: var(--success, #8EA898);
  color: #FFFFFF;
}
.export-section .vet-btn {
  background: var(--primary, #C88EA8);
  color: #FFFFFF;
}
.export-section .share-btn {
  background: var(--teal, #7EA8A0);
  color: #FFFFFF;
}

.report-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}
.report-modal .modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay, rgba(0, 0, 0, 0.7));
}
.report-modal .modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 80%;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: fadeInScale 0.3s ease-out;
}
.report-modal .modal-content .modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}
.report-modal .modal-content .modal-header .modal-title {
  font-size: 17rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}
.report-modal .modal-content .modal-header .modal-close {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  padding: 4rpx;
}
.report-modal .modal-content .modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0;
}
.report-modal .modal-content .modal-footer {
  padding: 16rpx;
  border-top: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}
.report-modal .modal-content .modal-footer .download-btn {
  width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
  color: #FFFFFF;
  border-radius: 22rpx;
  font-size: 15rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.report-modal .modal-content .modal-footer .download-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.pet-trends__disclaimer {
  padding: 20rpx;
  background: rgba(var(--primary, #C88EA8), 0.06);
  border: 1rpx solid rgba(var(--primary, #C88EA8), 0.12);
  border-radius: 16rpx;
  margin: 24rpx 24rpx 0;
}

.pet-trends__disclaimer-text {
  font-size: 22rpx;
  color: var(--primary-light, #E8C8D8);
  line-height: 1.5;
}
