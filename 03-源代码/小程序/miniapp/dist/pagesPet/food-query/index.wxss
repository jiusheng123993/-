.pet-food-query{background:#fff5f0;min-height:100vh;padding:32rpx 24rpx 200rpx;position:relative}.pet-food-query__loading{align-items:center;display:flex;justify-content:center;padding:80rpx 0}.pet-food-query__loading-text{color:#8c8c8c;font-size:26rpx}.pet-food-query__empty{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:120rpx 48rpx}.pet-food-query__empty-icon{font-size:96rpx;margin-bottom:24rpx}.pet-food-query__empty-text{color:#8c8c8c;font-size:28rpx;line-height:1.6;text-align:center}.pet-food-query__search{align-items:center;display:flex;gap:16rpx;margin-bottom:16rpx;margin-top:24rpx}.pet-food-query__input{background:#fff;border-radius:32rpx;box-shadow:0 4rpx 16rpx rgba(255,140,66,.08);box-sizing:border-box;color:#2c2c2c;flex:1;font-size:28rpx;height:88rpx;padding:0 32rpx}.pet-food-query__input-placeholder{color:silver}.pet-food-query__search-btn{align-items:center;background:#ff8c42;border-radius:32rpx;box-shadow:0 4rpx 16rpx rgba(255,140,66,.25);color:#fff;display:flex;flex-shrink:0;font-size:28rpx;font-weight:600;height:88rpx;justify-content:center;transition:all .3s ease;width:140rpx}.pet-food-query__search-btn:active{box-shadow:0 2rpx 8rpx rgba(255,140,66,.15);transform:scale(.96)}.pet-food-query__search-btn--disabled{box-shadow:none;opacity:.4}.pet-food-query__quota{background:#fff;border-radius:24rpx;box-shadow:0 2rpx 8rpx rgba(255,140,66,.06);color:#8c8c8c;font-size:24rpx;margin-bottom:16rpx;padding:12rpx 24rpx;text-align:center}.pet-food-query__quota--exhausted{color:#ff4d4f;font-weight:600}.pet-food-query__result{background:#fff;border-radius:32rpx;box-shadow:0 4rpx 16rpx rgba(255,140,66,.08);margin-bottom:24rpx;padding:32rpx}.pet-food-query__result--safe{border-left:8rpx solid #4caf50}.pet-food-query__result--caution{border-left:8rpx solid #ffc107}.pet-food-query__result--dangerous{border-left:8rpx solid #ff9800}.pet-food-query__result--toxic{border-left:8rpx solid #f44336}.pet-food-query__result-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:20rpx}.pet-food-query__result-name{color:#2c2c2c;font-size:36rpx;font-weight:700}.pet-food-query__result-badge{border-radius:20rpx;color:#fff;font-size:24rpx;font-weight:600;padding:8rpx 20rpx}.pet-food-query__result-badge--safe{background:#4caf50}.pet-food-query__result-badge--caution{background:#ffc107;color:#5d4037}.pet-food-query__result-badge--dangerous{background:#ff9800}.pet-food-query__result-badge--toxic{background:#f44336}.pet-food-query__result-section{margin-top:20rpx}.pet-food-query__result-section-title{color:#2c2c2c;display:block;font-size:26rpx;font-weight:600;margin-bottom:12rpx}.pet-food-query__result-section-text{color:#4a4a4a;display:block;font-size:26rpx;line-height:1.7}.pet-food-query__result-tags{display:flex;flex-wrap:wrap;gap:12rpx}.pet-food-query__result-tag{background:#fff5f0;border-radius:20rpx;color:#6b6b6b;font-size:24rpx;padding:8rpx 20rpx}.pet-food-query__result-tag--danger{background:#fff1f0;color:#cf1322}.pet-food-query__result-firstaid{background:#fff1f0;border:2rpx solid #f44336;border-radius:24rpx;margin-top:24rpx;padding:24rpx}.pet-food-query__result-firstaid-title{color:#cf1322;display:block;font-size:26rpx;font-weight:700;margin-bottom:12rpx}.pet-food-query__result-firstaid-text{color:#cf1322;display:block;font-size:26rpx;line-height:1.7}.pet-food-query__history{margin-top:24rpx}.pet-food-query__history-title{color:#2c2c2c;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.pet-food-query__history-list{display:flex;flex-direction:column;gap:12rpx}.pet-food-query__history-item{align-items:center;background:#fff;border-radius:24rpx;box-shadow:0 2rpx 8rpx rgba(255,140,66,.06);display:flex;justify-content:space-between;padding:24rpx;transition:all .2s ease}.pet-food-query__history-item:active{box-shadow:0 4rpx 16rpx rgba(255,140,66,.12);transform:scale(.98)}.pet-food-query__history-item-left{align-items:center;display:flex;flex:1;gap:16rpx;min-width:0}.pet-food-query__history-item-name{color:#2c2c2c;font-size:28rpx;font-weight:500;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pet-food-query__history-item-badge{border-radius:16rpx;flex-shrink:0;font-size:22rpx;font-weight:600;padding:4rpx 16rpx}.pet-food-query__history-item-time{color:#8c8c8c;flex-shrink:0;font-size:22rpx}.pet-food-query__disclaimer{background:#fffbe6;border-radius:16rpx;margin-top:24rpx;padding:20rpx}.pet-food-query__disclaimer-text{color:#d48806;font-size:22rpx;line-height:1.5}.pet-food-query__result-section--breed{background:#fff5f0;border-radius:24rpx;margin-top:20rpx;padding:24rpx}.pet-food-query__breed-warning{background:#fff;border-left:6rpx solid #ff8c42;border-radius:20rpx;margin-bottom:16rpx;padding:20rpx}.pet-food-query__breed-warning:last-child{margin-bottom:0}.pet-food-query__breed-warning-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:12rpx}.pet-food-query__breed-warning-name{color:#2c2c2c;font-size:28rpx;font-weight:600}.pet-food-query__breed-warning-level{border-radius:16rpx;color:#fff;font-size:22rpx;font-weight:600;padding:4rpx 16rpx}.pet-food-query__breed-warning-level--toxic{background:#f44336}.pet-food-query__breed-warning-level--dangerous{background:#ff9800}.pet-food-query__breed-warning-level--caution{background:#ffc107;color:#5d4037}.pet-food-query__breed-warning-level--info{background:#2196f3}.pet-food-query__breed-warning-reason{color:#4a4a4a;display:block;font-size:26rpx;line-height:1.6;margin-bottom:12rpx}.pet-food-query__breed-warning-recommendation{align-items:flex-start;background:#f6ffed;border-radius:16rpx;display:flex;gap:8rpx;padding:16rpx}.pet-food-query__breed-warning-recommendation-label{color:#389e0d;flex-shrink:0;font-size:24rpx;font-weight:600}.pet-food-query__breed-warning-recommendation-text{color:#389e0d;flex:1;font-size:24rpx;line-height:1.5}