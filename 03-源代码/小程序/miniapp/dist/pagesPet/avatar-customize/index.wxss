.avatar-customize {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  padding: 32rpx 24rpx;
  animation: pageEnter 0.4s ease-out;
}
.avatar-customize__preview {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}
.avatar-customize__generated-img {
  width: 320rpx;
  height: 320rpx;
  display: block;
  animation: fadeInScale 0.4s ease;
}
.avatar-customize__generating {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
