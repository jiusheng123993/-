.avatar-customize{background:#2a2320;min-height:100vh;padding:32rpx 24rpx}.avatar-customize__preview{align-items:center;background:#1a2332;border-radius:16rpx;border-radius:24rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);display:flex;justify-content:center;margin-bottom:32rpx;padding:40rpx 0}.avatar-customize__generated-img{animation:avatarFadeIn .4s ease;display:block;height:320rpx;width:320rpx}.avatar-customize__generating{align-items:center;display:flex;flex-direction:column;gap:16rpx;justify-content:center;padding:60rpx 0}.avatar-customize__generating-spinner{animation:avatarSpin .8s linear infinite;border:6rpx solid #2a3342;border-radius:999rpx;border-top-color:#e8a838;height:80rpx;width:80rpx}.avatar-customize__generating-text{color:#89a;font-size:28rpx}.avatar-customize__generating-hint{color:#678;font-size:24rpx}.avatar-customize__section{margin-bottom:32rpx}.avatar-customize__section-title{color:#e8dfd5;display:block;font-size:28rpx;font-weight:600;margin-bottom:16rpx}.avatar-customize__style-options{display:flex;gap:16rpx}.avatar-customize__style-item{background:#1a2332;border:2rpx solid #2a3342;border-radius:16rpx;flex:1;padding:20rpx 16rpx;text-align:center;transition:border-color .15s ease,background-color .15s ease;transition:transform .15s ease,opacity .15s ease}.avatar-customize__style-item:active{opacity:.85;transform:scale(.97)}.avatar-customize__style-item--active{background:#2a1f10;border-color:#e8a838}.avatar-customize__style-label{color:#e8dfd5;display:block;font-size:28rpx;font-weight:600;margin-bottom:4rpx}.avatar-customize__style-desc{color:#678;display:block;font-size:22rpx}.avatar-customize__color-options{display:flex;flex-wrap:wrap;gap:16rpx}.avatar-customize__color-item{align-items:center;border:4rpx solid transparent;border-radius:999rpx;display:flex;height:72rpx;justify-content:center;transition:border-color .15s ease,transform .15s ease;transition:transform .15s ease,opacity .15s ease;width:72rpx}.avatar-customize__color-item:active{opacity:.85;transform:scale(.97)}.avatar-customize__color-item--active{border-color:#e8a838;box-shadow:0 0 0 4rpx #2a1f10;transform:scale(1.15)}.avatar-customize__color-check{color:#0f1724;font-size:28rpx;font-weight:700;text-shadow:0 1rpx 2rpx rgba(0,0,0,.3)}.avatar-customize__quota{margin-bottom:24rpx;text-align:center}.avatar-customize__quota-text{color:#678;font-size:24rpx}.avatar-customize__actions{padding:0 16rpx}.avatar-customize__btn{background:linear-gradient(135deg,#e8a838,#f5d78c);border-radius:40rpx;box-shadow:0 4rpx 16rpx rgba(74,144,217,.3);padding:24rpx 0;text-align:center;transition:transform .15s ease,opacity .15s ease}.avatar-customize__btn:active{opacity:.85;transform:scale(.97)}.avatar-customize__btn--disabled{background:#456;box-shadow:none}.avatar-customize__btn--secondary{background:#1a2332;border:2rpx solid #e8a838;box-shadow:none}.avatar-customize__btn-text{color:#0f1724;font-size:30rpx;font-weight:600}.avatar-customize__btn--secondary .avatar-customize__btn-text{color:#e8a838}.avatar-customize__btn-group{display:flex;gap:16rpx}.avatar-customize__btn-group .avatar-customize__btn{flex:1}.avatar-customize__existing{background:#1a2332;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.04);margin-top:32rpx;padding:24rpx;text-align:center}.avatar-customize__existing-label{color:#678;display:block;font-size:24rpx;margin-bottom:12rpx}.avatar-customize__existing-img{display:block;height:160rpx;margin:0 auto;width:160rpx}@keyframes avatarFadeIn{from{opacity:0;transform:scale(.9)}to{opacity:1;transform:scale(1)}}@keyframes avatarSpin{to{transform:rotate(1turn)}}