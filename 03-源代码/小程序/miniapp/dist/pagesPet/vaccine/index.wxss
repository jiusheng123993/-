.pet-vaccine {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  padding: 32rpx 24rpx;
  padding-bottom: 200rpx;
  position: relative;
  animation: pageEnter 0.4s ease-out;
}

.pet-vaccine__loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.pet-vaccine__loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary, #786870);
}

.pet-vaccine__header {
  margin: 24rpx 0;
}

.pet-vaccine__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
  text-align: center;
}

.pet-vaccine__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.pet-vaccine__empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.pet-vaccine__empty-text {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
  text-align: center;
  line-height: 1.6;
}

.pet-vaccine__stats {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.pet-vaccine__stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.pet-vaccine__stats-value {
  font-size: 40rpx;
  font-weight: 700;
}

.pet-vaccine__stats-value--completed {
  color: var(--success, #8EA898);
}

.pet-vaccine__stats-value--pending {
  color: var(--primary, #C88EA8);
}

.pet-vaccine__stats-value--overdue {
  color: var(--danger, #C87070);
}

.pet-vaccine__stats-label {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}

.pet-vaccine__stats-divider {
  width: 2rpx;
  height: 48rpx;
  background: var(--divider, rgba(200, 142, 168, 0.06));
}

.pet-vaccine__reminders {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.pet-vaccine__reminders-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pet-vaccine__reminders-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.pet-vaccine__reminders-toggle {
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  transition: all 0.25s ease;
}

.pet-vaccine__reminders-toggle--on {
  background: rgba(var(--primary, #C88EA8), 0.08);
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.pet-vaccine__reminders-toggle-text {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  font-weight: 500;
}

.pet-vaccine__reminders-toggle--on .pet-vaccine__reminders-toggle-text {
  color: var(--primary, #C88EA8);
}

.pet-vaccine__reminder-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pet-vaccine__reminder-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
}

.pet-vaccine__reminder-item--overdue {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
}

.pet-vaccine__reminder-item--upcoming {
  background: rgba(var(--primary, #C88EA8), 0.06);
}

.pet-vaccine__reminder-icon {
  font-size: 32rpx;
}

.pet-vaccine__reminder-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pet-vaccine__reminder-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.pet-vaccine__reminder-date {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}

.pet-vaccine__reminder-item--overdue .pet-vaccine__reminder-date {
  color: var(--danger, #C87070);
}

.pet-vaccine__section {
  margin-top: 24rpx;
}

.pet-vaccine__section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.pet-vaccine__section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.pet-vaccine__section-count {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}

.pet-vaccine__auto-schedule {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.pet-vaccine__schedule-toggle {
  padding: 8rpx 20rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 20rpx;
}

.pet-vaccine__schedule-toggle-text {
  font-size: 22rpx;
  color: var(--primary, #C88EA8);
}

.pet-vaccine__schedule-list {
  margin-top: 16rpx;
}

.pet-vaccine__schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.pet-vaccine__schedule-item:last-child {
  border-bottom: none;
}

.pet-vaccine__schedule-item--overdue {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: none;
}

.pet-vaccine__schedule-item--due {
  background: rgba(var(--primary, #C88EA8), 0.06);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: none;
}

.pet-vaccine__schedule-item-left {
  flex: 1;
}

.pet-vaccine__schedule-item-name {
  font-size: 24rpx;
  color: var(--text-primary, #E8D8DE);
  font-weight: 500;
  display: block;
}

.pet-vaccine__schedule-item-notes {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
  margin-top: 4rpx;
  display: block;
}

.pet-vaccine__schedule-item-right {
  text-align: right;
}

.pet-vaccine__schedule-item-date {
  font-size: 22rpx;
  color: var(--text-secondary, #A098A0);
  display: block;
}

.pet-vaccine__schedule-item-status {
  font-size: 22rpx;
  font-weight: 500;
  display: block;
  margin-top: 4rpx;
}

.pet-vaccine__schedule-item-status--overdue {
  color: var(--danger, #C87070);
}

.pet-vaccine__schedule-item-status--due {
  color: var(--primary, #C88EA8);
}

.pet-vaccine__schedule-item-status--upcoming {
  color: var(--success, #8EA898);
}

.pet-vaccine__deworming {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.pet-vaccine__deworming-list {
  margin-top: 16rpx;
}

.pet-vaccine__deworming-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.pet-vaccine__deworming-item:last-child {
  border-bottom: none;
}

.pet-vaccine__deworming-item--overdue {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: none;
}

.pet-vaccine__deworming-item--due {
  background: rgba(var(--primary, #C88EA8), 0.06);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 8rpx;
  border-bottom: none;
}

.pet-vaccine__deworming-item-left {
  flex: 1;
}

.pet-vaccine__deworming-item-type {
  font-size: 24rpx;
  color: var(--text-primary, #E8D8DE);
  font-weight: 500;
}

.pet-vaccine__deworming-item-right {
  text-align: right;
}

.pet-vaccine__deworming-item-date {
  font-size: 22rpx;
  color: var(--text-secondary, #A098A0);
  display: block;
}

.pet-vaccine__deworming-item-status {
  font-size: 22rpx;
  font-weight: 500;
  display: block;
  margin-top: 4rpx;
}

.pet-vaccine__deworming-item-status--overdue {
  color: var(--danger, #C87070);
}

.pet-vaccine__deworming-item-status--due {
  color: var(--primary, #C88EA8);
}

.pet-vaccine__deworming-item-status--upcoming {
  color: var(--success, #8EA898);
}

.pet-vaccine__list-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.pet-vaccine__list-empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.pet-vaccine__list-empty-text {
  font-size: 24rpx;
  color: var(--text-tertiary, #786870);
  text-align: center;
}

.pet-vaccine__list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pet-vaccine__share-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  margin-top: -8rpx;
}

.pet-vaccine__share-item-text {
  font-size: 20rpx;
  color: var(--success, #8EA898);
  font-weight: 500;
}

.pet-vaccine__load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
}

.pet-vaccine__load-more-text {
  font-size: 24rpx;
  color: var(--text-tertiary, #786870);
}

.pet-vaccine__disclaimer {
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
}

.pet-vaccine__disclaimer-text {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
  line-height: 1.5;
}

.pet-vaccine__fab {
  position: fixed;
  right: 32rpx;
  bottom: 160rpx;
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(var(--primary, #C88EA8), 0.3);
  z-index: 100;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.pet-vaccine__fab:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.pet-vaccine__fab-icon {
  font-size: 48rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
}

/* VaccineCalendar */
.vaccine-calendar {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
}

.vaccine-calendar__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.vaccine-calendar__nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 16rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.vaccine-calendar__nav-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.vaccine-calendar__nav-icon {
  font-size: 32rpx;
  color: var(--primary, #C88EA8);
  font-weight: 600;
}

.vaccine-calendar__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-calendar__weekdays {
  display: flex;
  margin-bottom: 16rpx;
}

.vaccine-calendar__weekday {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  font-weight: 500;
}

.vaccine-calendar__days {
  display: flex;
  flex-wrap: wrap;
}

.vaccine-calendar__day {
  width: 14.28%;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 16rpx;
  transition: background 0.15s ease;
}

.vaccine-calendar__day--empty {
  pointer-events: none;
}

.vaccine-calendar__day--today {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
}

.vaccine-calendar__day--today .vaccine-calendar__day-num {
  color: var(--primary, #C88EA8);
  font-weight: 700;
}

.vaccine-calendar__day--overdue {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
}

.vaccine-calendar__day-num {
  font-size: 24rpx;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-calendar__day-marks {
  display: flex;
  gap: 4rpx;
  margin-top: 4rpx;
}

.vaccine-calendar__mark {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.vaccine-calendar__mark--vaccine {
  background: var(--primary, #C88EA8);
}

.vaccine-calendar__mark--deworm {
  background: var(--success, #8EA898);
}

.vaccine-calendar__legend {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.vaccine-calendar__legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vaccine-calendar__legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.vaccine-calendar__legend-dot--vaccine {
  background: var(--primary, #C88EA8);
}

.vaccine-calendar__legend-dot--deworm {
  background: var(--success, #8EA898);
}

.vaccine-calendar__legend-dot--overdue {
  background: var(--danger, #C87070);
}

.vaccine-calendar__legend-text {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
}

/* VaccineRecordCard */
.vaccine-record-card {
  background: var(--bg-card, #2A1E24);
  border-radius: 16rpx;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
  padding: 32rpx;
  animation: fadeInUp 0.4s ease-out;
}

.vaccine-record-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.vaccine-record-card__type {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.vaccine-record-card__type-icon {
  font-size: 36rpx;
}

.vaccine-record-card__type-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-record-card__status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.vaccine-record-card__status-text {
  font-size: 22rpx;
  font-weight: 500;
}

.vaccine-record-card__body {
  margin-bottom: 20rpx;
}

.vaccine-record-card__category {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
  margin-bottom: 16rpx;
}

.vaccine-record-card__info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.vaccine-record-card__info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.vaccine-record-card__info-label {
  font-size: 20rpx;
  color: var(--text-tertiary, #786870);
  min-width: 120rpx;
}

.vaccine-record-card__info-value {
  font-size: 20rpx;
  color: var(--text-primary, #E8D8DE);
  flex: 1;
}

.vaccine-record-card__info-value--overdue {
  color: var(--danger, #C87070);
  font-weight: 600;
}

.vaccine-record-card__actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.vaccine-record-card__btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  transition: all 0.25s ease;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.vaccine-record-card__btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.vaccine-record-card__btn--primary {
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
}

.vaccine-record-card__btn--secondary {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
}

.vaccine-record-card__btn--danger {
  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
}

.vaccine-record-card__btn-text {
  font-size: 24rpx;
  font-weight: 500;
}

.vaccine-record-card__btn--primary .vaccine-record-card__btn-text {
  color: #FFFFFF;
}

.vaccine-record-card__btn--secondary .vaccine-record-card__btn-text {
  color: var(--primary, #C88EA8);
}

.vaccine-record-card__btn--danger .vaccine-record-card__btn-text {
  color: var(--danger, #C87070);
}

/* VaccineAddModal */
.vaccine-modal__overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-overlay, rgba(0, 0, 0, 0.7));
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.vaccine-modal {
  width: 100%;
  max-height: 85vh;
  background: var(--bg-card, #2A1E24);
  border-radius: 48rpx 48rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.3s ease;
}

@keyframes sheetUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
.vaccine-modal__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.vaccine-modal__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-modal__close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vaccine-modal__close-icon {
  font-size: 32rpx;
  color: var(--text-tertiary, #786870);
}

.vaccine-modal__body {
  flex: 1;
  overflow-y: auto;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.vaccine-modal__section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.vaccine-modal__label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-modal__type-selector {
  display: flex;
  gap: 16rpx;
}

.vaccine-modal__type-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.vaccine-modal__type-btn--active {
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-color: var(--primary, #C88EA8);
}

.vaccine-modal__type-text {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
  font-weight: 500;
}

.vaccine-modal__type-btn--active .vaccine-modal__type-text {
  color: var(--primary, #C88EA8);
  font-weight: 600;
}

.vaccine-modal__picker {
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.vaccine-modal__picker-value {
  font-size: 28rpx;
  color: var(--text-primary, #E8D8DE);
}

.vaccine-modal__picker-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary, #786870);
}

.vaccine-modal__input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary, #E8D8DE);
  box-sizing: border-box;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.vaccine-modal__input-placeholder {
  color: var(--text-placeholder, #685860);
}

.vaccine-modal__textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 24rpx;
  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-primary, #E8D8DE);
  box-sizing: border-box;
  line-height: 1.6;
  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
}

.vaccine-modal__textarea-placeholder {
  color: var(--text-placeholder, #685860);
}

.vaccine-modal__count {
  font-size: 22rpx;
  color: var(--text-tertiary, #786870);
  text-align: right;
}

.vaccine-modal__footer {
  padding: 24rpx 32rpx 48rpx;
  border-top: 2rpx solid var(--divider, rgba(200, 142, 168, 0.06));
}

.vaccine-modal__submit {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(var(--primary, #C88EA8), 0.3);
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.vaccine-modal__submit:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.vaccine-modal__submit--disabled {
  opacity: 0.4;
  box-shadow: none;
}

.vaccine-modal__submit-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}
