.breed-detail{background:#f8f4e9;min-height:100vh;position:relative}.breed-detail__scroll{height:calc(100vh - 120rpx)}.breed-detail__loading{align-items:center;display:flex;height:100vh;justify-content:center}.breed-detail__loading-text{color:#8c8c8c;font-size:28rpx}.breed-detail__hero{align-items:center;background:linear-gradient(135deg,rgba(176,58,46,.1),#fff);display:flex;flex-direction:column;padding:32rpx 24rpx 24rpx}.breed-detail__hero-emoji{align-items:center;background:#fff;border-radius:50%;box-shadow:0 4rpx 16rpx rgba(0,0,0,.1);display:flex;height:120rpx;justify-content:center;margin-bottom:16rpx;width:120rpx}.breed-detail__hero-emoji-text{font-size:64rpx}.breed-detail__hero-name{color:#2c2c2c;font-size:48rpx;font-weight:700;margin-bottom:12rpx}.breed-detail__hero-badges{display:flex;flex-wrap:wrap;gap:8rpx;justify-content:center}.breed-detail__hero-badge{background:hsla(0,0%,100%,.8);border-radius:999rpx;color:#b03a2e;font-size:22rpx;padding:4rpx 16rpx}.breed-detail__info-grid{background:#fff;border-radius:16rpx;box-shadow:0 2rpx 8rpx rgba(0,0,0,.06);display:grid;gap:8rpx;grid-template-columns:repeat(4,1fr);margin:-20rpx 24rpx 0;padding:16rpx 24rpx;position:relative;z-index:1}.breed-detail__info-item{align-items:center;display:flex;flex-direction:column;padding:8rpx 0}.breed-detail__info-label{color:#8c8c8c;font-size:20rpx;margin-bottom:4rpx}.breed-detail__info-value{color:#2c2c2c;font-size:22rpx;font-weight:500}.breed-detail__section{padding:24rpx 24rpx 0}.breed-detail__section-title{color:#2c2c2c;display:block;font-size:32rpx;font-weight:500;margin-bottom:12rpx}.breed-detail__section-title--danger{color:#e74c3c}.breed-detail__section-title--warning{color:#f39c12}.breed-detail__section-title--success{color:#27ae60}.breed-detail__tags{display:flex;flex-wrap:wrap;gap:8rpx}.breed-detail__tag{background:#f5f0e3;border-radius:24rpx;color:#4a4a4a;font-size:22rpx;padding:6rpx 16rpx}.breed-detail__tag--primary{background:rgba(176,58,46,.1);color:#b03a2e}.breed-detail__tag--green{background:#e8f8f0;color:#27ae60}.breed-detail__danger-list{display:flex;flex-direction:column;gap:8rpx}.breed-detail__danger-card{align-items:center;background:#fff5f5;border-left:6rpx solid #e74c3c;border-radius:16rpx;display:flex;gap:12rpx;padding:16rpx 24rpx}.breed-detail__danger-icon{flex-shrink:0;font-size:28rpx}.breed-detail__danger-text{color:#c0392b;font-size:22rpx;font-weight:500}.breed-detail__warning-list{display:flex;flex-direction:column;gap:8rpx}.breed-detail__warning-card{align-items:center;background:#fffbeb;border-left:6rpx solid #f39c12;border-radius:16rpx;display:flex;gap:12rpx;padding:16rpx 24rpx}.breed-detail__warning-icon{flex-shrink:0;font-size:28rpx}.breed-detail__warning-text{color:#d68910;font-size:22rpx;font-weight:500}.breed-detail__success-list{display:flex;flex-direction:column;gap:8rpx}.breed-detail__success-card{align-items:flex-start;background:#f0fdf4;border-left:6rpx solid #27ae60;border-radius:16rpx;display:flex;gap:12rpx;padding:16rpx 24rpx}.breed-detail__success-index{align-items:center;background:#27ae60;border-radius:50%;color:#fff;display:flex;flex-shrink:0;font-size:20rpx;height:32rpx;justify-content:center;line-height:32rpx;text-align:center;width:32rpx}.breed-detail__success-text{color:#1e8449;flex:1;font-size:22rpx;line-height:1.6}.breed-detail__list{display:flex;flex-direction:column;gap:8rpx}.breed-detail__list-item{align-items:flex-start;background:#fff;border-radius:16rpx;display:flex;gap:12rpx;padding:12rpx 24rpx}.breed-detail__list-dot{color:#b03a2e;font-size:28rpx;line-height:1.6}.breed-detail__list-text{color:#4a4a4a;flex:1;font-size:22rpx;line-height:1.6}.breed-detail__disclaimer{margin-top:16rpx;padding:24rpx}.breed-detail__disclaimer-text{color:#8c8c8c;font-size:20rpx;line-height:1.5}.breed-detail__bottom-spacer{height:140rpx}.breed-detail__footer{background:#fff;bottom:0;box-shadow:0 -2rpx 12rpx rgba(0,0,0,.06);left:0;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:100}.breed-detail__footer-btn{align-items:center;background:#b03a2e;border-radius:999rpx;display:flex;height:88rpx;justify-content:center;transition:all .2s ease}.breed-detail__footer-btn:active{opacity:.85;transform:scale(.98)}.breed-detail__footer-btn-text{color:#f8f4e9;font-size:32rpx;font-weight:500}