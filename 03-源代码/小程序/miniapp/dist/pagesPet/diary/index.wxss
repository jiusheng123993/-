.pet-diary{background:#f5f7fa;display:flex;flex-direction:column;min-height:100vh}.pet-diary__avatar{display:flex;justify-content:center;padding:8rpx 0}.pet-diary__header{padding:12rpx 24rpx 16rpx;text-align:center}.pet-diary__title{color:#262626;display:block;font-size:20rpx;font-weight:600}.pet-diary__subtitle{color:#8c8c8c;display:block;font-size:13rpx;margin-top:4rpx}.pet-diary__content{flex:1;height:0;padding:0 16rpx}.pet-diary__empty,.pet-diary__error,.pet-diary__loading{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:60rpx 24rpx}.pet-diary__loading-text{color:#8c8c8c;font-size:14rpx}.pet-diary__error-text{color:#ff4d4f;font-size:14rpx;margin-bottom:16rpx}.pet-diary__retry-btn{background:#1890ff;border-radius:20rpx;padding:8rpx 24rpx}.pet-diary__retry-text{color:#fff;font-size:14rpx}.pet-diary__empty-icon{font-size:48rpx;margin-bottom:12rpx}.pet-diary__empty-text{color:#595959;font-size:16rpx;font-weight:500}.pet-diary__empty-hint{color:#bfbfbf;font-size:13rpx;margin-top:8rpx}.pet-diary__timeline{padding:8rpx 0 24rpx}.pet-diary__entry{display:flex;margin-bottom:0}.pet-diary__entry-left{align-items:center;display:flex;flex-direction:column;flex-shrink:0;width:24rpx}.pet-diary__dot{border-radius:50%;flex-shrink:0;height:10rpx;margin-top:16rpx;width:10rpx}.pet-diary__line{background:#e8e8e8;flex:1;margin-bottom:-16rpx;margin-top:4rpx;width:2rpx}.pet-diary__entry-right{background:#fff;border-radius:12rpx;box-shadow:0 1rpx 4rpx rgba(0,0,0,.06);flex:1;margin-bottom:12rpx;padding:12rpx 16rpx 20rpx 12rpx}.pet-diary__entry-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:8rpx}.pet-diary__entry-date{color:#8c8c8c;font-size:13rpx}.pet-diary__tone-badge{border-radius:10rpx;padding:2rpx 10rpx}.pet-diary__tone-text{color:#fff;font-size:11rpx;font-weight:500}.pet-diary__entry-body{align-items:flex-start;display:flex;gap:8rpx;margin-bottom:8rpx}.pet-diary__entry-emoji{flex-shrink:0;font-size:20rpx;line-height:1.4}.pet-diary__entry-text{color:#262626;flex:1;font-size:15rpx;line-height:1.5}.pet-diary__entry-note{align-items:flex-start;background:#fafafa;border-radius:8rpx;display:flex;gap:4rpx;margin-bottom:8rpx;padding:8rpx 10rpx}.pet-diary__note-label{color:#8c8c8c;flex-shrink:0;font-size:12rpx}.pet-diary__note-text{color:#595959;flex:1;font-size:12rpx}.pet-diary__entry-share{align-items:center;display:flex;justify-content:center;padding:6rpx 0}.pet-diary__share-text{color:#1890ff;font-size:12rpx}.pet-diary__disclaimer{padding:12rpx 24rpx 20rpx;text-align:center}.pet-diary__disclaimer-text{color:#bfbfbf;font-size:11rpx;line-height:1.5}