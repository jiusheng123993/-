.chronic-page {
  min-height: 100vh;
  background-color: var(--bg-page, #1A1418);
  padding-bottom: 40rpx;
  animation: pageEnter 0.4s ease-out;
}

.chronic-header {
  background: linear-gradient(135deg, var(--primary, #C88EA8) 0%, var(--primary-dark, #A06880) 100%);
  padding: 40rpx 24rpx 60rpx;
  color: var(--text-inverse, #1A1418);
}

.chronic-header-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.chronic-sync-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, opacity 0.15s ease;
}
.chronic-sync-btn:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.chronic-sync-icon {
