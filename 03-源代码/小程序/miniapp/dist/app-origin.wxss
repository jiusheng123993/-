page {
  background: transparent;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text-primary, #E8D8DE);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

view,
scroll-view,
swiper,
movable-view,
cover-view {
  box-sizing: border-box;
}

.app-root {
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
}

.app-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
  color: var(--primary, #C88EA8);
  font-size: 36rpx;
  font-weight: 600;
}
