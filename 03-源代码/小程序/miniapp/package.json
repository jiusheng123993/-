{
  "name": "xinghuanhai-miniapp",
  "private": true,
  "version": "0.1.0",
  "description": "星寰海微信小程序 - AI主动外联引擎",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "build:weapp": "taro build --type weapp",
    "build:alipay": "taro build --type alipay",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@tarojs/components": "^3.6.0",
    "@tarojs/plugin-framework-react": "^3.6.0",
    "@tarojs/react": "^3.6.0",
    "@tarojs/runtime": "^3.6.0",
    "@tarojs/taro": "^3.6.0",
    "crypto-js": "^4.2.0",
    "react": "^17.0.2",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.29.7",
    "@tarojs/cli": "^3.6.40",
    "@tarojs/plugin-platform-weapp": "^3.6.40",
    "@tarojs/webpack5-prebundle": "^3.6.40",
    "@tarojs/webpack5-runner": "^3.6.40",
    "@testing-library/react": "^12.1.5",
    "@types/node": "^20.10.0",
    "@types/react": "^17.0.2",
    "babel-preset-taro": "^4.2.0",
    "eslint": "^8.57.0",
    "react-dom": "^17.0.2",
    "sass": "^1.101.0",
    "typescript": "^5.3.0",
    "webpack": "5.78.0"
  }
}
