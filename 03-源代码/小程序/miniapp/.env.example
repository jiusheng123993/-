# ============================================================
# 星寰海小程序环境变量配置模板
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# --- Supabase 配置 ---
TARO_APP_SUPABASE_URL=https://your-project.supabase.co
TARO_APP_SUPABASE_KEY=your-supabase-anon-key

# --- 后端 API 配置 ---
TARO_APP_API_BASE_URL=http://localhost:3000/api

# --- 微信订阅消息模板 ID ---
# 从微信公众平台 → 订阅消息 → 添加模板 获取
TARO_APP_VACCINE_REMINDER_TEMPLATE_ID=
TARO_APP_FOLLOWUP_TEMPLATE_ID=
TARO_APP_CARE_PLAN_TEMPLATE_ID=
TARO_APP_HEALTH_CHECKIN_TEMPLATE_ID=

# --- Seedream API 配置（后端/Edge Function 使用，不暴露到前端） ---
# SEEDREAM_API_KEY=your-seedream-api-key

# --- 加密盐值（生产环境必须修改，禁止使用默认值） ---
TARO_APP_CRYPTO_SALT=

# --- AI Provider (DeepSeek / GLM-4) ---
TARO_APP_AI_API_KEY=your-api-key
TARO_APP_AI_BASE_URL=https://api.deepseek.com/v1
TARO_APP_AI_MODEL=deepseek-chat

# --- AI Guard ---
TARO_APP_GUARD_MODEL=deepseek-chat
