# ============================================================
# 星寰海小程序环境变量配置模板
# 复制此文件为 .env.local 并填入真实值
# ============================================================

# --- 后端 API 配置 ---
# 开发环境指向本地后端，生产环境指向腾讯云服务器地址
TARO_APP_API_BASE_URL=http://localhost:3000

# --- 微信订阅消息模板 ID ---
# 从微信公众平台 → 订阅消息 → 添加模板 获取
TARO_APP_VACCINE_REMINDER_TEMPLATE_ID=
TARO_APP_FOLLOWUP_TEMPLATE_ID=
TARO_APP_CARE_PLAN_TEMPLATE_ID=
TARO_APP_HEALTH_CHECKIN_TEMPLATE_ID=

# --- 加密盐值（生产环境必须修改，禁止使用默认值） ---
TARO_APP_CRYPTO_SALT=
