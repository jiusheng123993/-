+<script>
+function switchView(name) {
+  document.querySelectorAll('.sidebar-item').forEach(el => el.classList.remove('active'));
+  document.querySelectorAll('[id^="view-"]').forEach(el => el.classList.add('hidden'));
+  document.getElementById('view-' + name).classList.remove('hidden');
+  document.querySelector('.sidebar-item[onclick="switchView(\'' + name + '\')"]').classList.add('active');
+}
+
+// Diff Modal Functions
+function openDiff(filename, title) {
+  const modal = document.getElementById('diff-modal');
+  const body = document.getElementById('diff-modal-body');
+  const titleEl = document.getElementById('diff-modal-title');
+  titleEl.textContent = title ? '改动详情 - ' + title : '改动详情';
+  body.innerHTML = '<div class="diff-loading">加载中...</div>';
+  modal.classList.add('active');
+  document.body.style.overflow = 'hidden';
+
+  fetch('diffs/' + filename)
+    .then(r => {
+      if (!r.ok) throw new Error('文件不存在');
+      return r.text();
+    })
+    .then(text => {
+      body.innerHTML = renderDiff(text);
+    })
+    .catch(err => {
+      body.innerHTML = '<div class="diff-empty">暂无 diff 记录（' + err.message + '）</div>';
+    });
+}
+
+function closeDiff() {
+  const modal = document.getElementById('diff-modal');
+  modal.classList.remove('active');
+  document.body.style.overflow = '';
+}
+
+function closeDiffOnBackdrop(e) {
+  if (e.target === e.currentTarget) closeDiff();
+}
+
+document.addEventListener('keydown', function(e) {
+  if (e.key === 'Escape') closeDiff();
+});
+
+function escapeHtml(str) {
+  return str
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;');
+}
+
+function generateFileDescription(filename, hasAdd, hasDel) {
+  const ext = filename.split('.').pop() || '';
+  const base = filename.split('/').pop() || filename;
+  
+  if (base.endsWith('.test.' + ext.replace(/test\./, '')) || base.endsWith('.spec.' + ext)) {
+    return '增加/修改测试用例';
+  }
+  if (ext === 'css' || ext === 'scss' || ext === 'less') {
+    return '调整样式';
+  }
+  if (ext === 'ts' || ext === 'tsx' || ext === 'js' || ext === 'jsx') {
+    if (hasAdd && !hasDel) return '新增功能';
+    if (!hasAdd && hasDel) return '删除/重构代码';
+    return '修改逻辑代码';
+  }
+  if (ext === 'html') return '调整页面结构';
+  if (ext === 'json') return '更新配置';
+  if (ext === 'md' || ext === 'txt') return '更新文档';
+  if (hasAdd && !hasDel) return '新增内容';
+  if (!hasAdd && hasDel) return '删除内容';
+  return '修改内容';
+}
+
+function parseDiffToFiles(text) {
+  const files = [];
+  const lines = text.split('\n');
+  let currentFile = null;
+  let currentHunk = null;
+  let description = [];
+  let inDescription = false;
+  
+  for (let line of lines) {
+    if (line.startsWith('# 改动说明')) {
+      inDescription = true;
+      continue;
+    }
+    if (inDescription && line.startsWith('#')) {
+      description.push(line.substring(1).trim());
+      continue;
+    }
+    if (inDescription && !line.startsWith('#') && line.trim() !== '') {
+      inDescription = false;
+    }
+    
+    if (line.startsWith('diff --git')) {
+      if (currentFile) {
+        currentFile.description = description;
+        files.push(currentFile);
+      }
+      const match = line.match(/diff --git a\/(.+) b\/(.+)/);
+      currentFile = {
+        filename: match ? match[1] : line,
+        hunks: [],
+        description: []
+      };
+      currentHunk = null;
+    } else if (line.startsWith('@@')) {
+      const m = line.match(/@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/);
+      currentHunk = {
+        header: line,
+        oldStart: m ? parseInt(m[1], 10) : 0,
+        newStart: m ? parseInt(m[2], 10) : 0,
+        lines: []
+      };
+      if (currentFile) currentFile.hunks.push(currentHunk);
+    } else if (currentHunk) {
+      if (line.startsWith('-')) {
+        currentHunk.lines.push({ type: 'del', content: line.substring(1) });
+      } else if (line.startsWith('+')) {
+        currentHunk.lines.push({ type: 'add', content: line.substring(1) });
+      } else if (line.startsWith(' ')) {
+        currentHunk.lines.push({ type: 'ctx', content: line.substring(1) });
+      } else if (line === '') {
+        currentHunk.lines.push({ type: 'ctx', content: '' });
+      }
+    }
+  }
+  
+  if (currentFile) {
+    currentFile.description = description;
+    files.push(currentFile);
+  }
+  return files;
+}
+
+function renderDiff(text) {
+  const files = parseDiffToFiles(text);
+  if (files.length === 0) {
+    const lines = text.split('\n').filter(l => l.trim());
+    if (lines.length === 0) {
+      return '<div class="diff-empty">暂无 diff 内容</div>';
+    }
+    let html = '<div class="diff-plain-text">';
+    for (const line of lines) {
+      if (line.startsWith('#')) {
+        html += '<div class="diff-plain-comment">' + escapeHtml(line.substring(1).trim()) + '</div>';
+      } else {
+        html += '<div class="diff-plain-line">' + escapeHtml(line) + '</div>';
+      }
+    }
+    html += '</div>';
+    return html;
+  }
+  
+  let html = '';
+  for (const file of files) {
+    const hasAdd = file.hunks.some(h => h.lines.some(l => l.type === 'add'));
+    const hasDel = file.hunks.some(h => h.lines.some(l => l.type === 'del'));
+    const desc = generateFileDescription(file.filename, hasAdd, hasDel);
+    
+    html += '<div class="diff-file-card">';
+    html += '<div class="diff-file-header">';
+    html += '<div class="diff-file-name">&#128196; ' + escapeHtml(file.filename) + '</div>';
+    html += '<div class="diff-file-desc">' + escapeHtml(desc) + '</div>';
+    html += '</div>';
+    
+    if (file.description && file.description.length > 0) {
+      html += '<div class="diff-description">';
+      for (const descLine of file.description) {
+        html += '<div class="diff-description-line">' + escapeHtml(descLine) + '</div>';
+      }
+      html += '</div>';
+    }
+    
+    html += '<div class="diff-hunks">';
+    
+    for (const hunk of file.hunks) {
+      html += '<div class="diff-hunk-header">' + escapeHtml(hunk.header) + '</div>';
+      
+      // 将行配对：删除行和新增行配对，上下文行两边都有
+      const pairs = [];
+      let i = 0;
+      const lines = hunk.lines;
+      
+      while (i < lines.length) {
+        if (lines[i].type === 'del') {
+          // 收集连续的删除行
+          const dels = [];
+          while (i < lines.length && lines[i].type === 'del') {
+            dels.push(lines[i]);
+            i++;
+          }
+          // 收集紧随的连续新增行
+          const adds = [];
+          while (i < lines.length && lines[i].type === 'add') {
+            adds.push(lines[i]);
+            i++;
+          }
+          // 配对：一一对应，多余的单独放
+          const maxLen = Math.max(dels.length, adds.length);
+          for (let j = 0; j < maxLen; j++) {
+            pairs.push({
+              left: j < dels.length ? dels[j] : null,
+              right: j < adds.length ? adds[j] : null
+            });
+          }
+        } else if (lines[i].type === 'add') {
+          // 只有新增行（没有前面的删除行）
+          pairs.push({ left: null, right: lines[i] });
+          i++;
+        } else {
+          // 上下文行
+          pairs.push({ left: lines[i], right: lines[i] });
+          i++;
+        }
+      }
+      
+      // 渲染左右对比
+      html += '<div class="diff-pair">';
+      html += '<div class="diff-pair-header"><div class="diff-pair-header-left">&#128683; 修改前</div><div class="diff-pair-header-right">&#9989; 修改后</div></div>';
+      
+      let oldLineNum = hunk.oldStart;
+      let newLineNum = hunk.newStart;
+      
+      // 先计算行号
+      const leftLines = [];
+      const rightLines = [];
+      for (const pair of pairs) {
+        if (pair.left && pair.left.type === 'ctx') {
+          leftLines.push({ type: 'ctx', content: pair.left.content, num: oldLineNum });
+          rightLines.push({ type: 'ctx', content: pair.right.content, num: newLineNum });
+          oldLineNum++;
+          newLineNum++;
+        } else {
+          if (pair.left) {
+            leftLines.push({ type: 'del', content: pair.left.content, num: oldLineNum });
+            oldLineNum++;
+          } else {
+            leftLines.push({ type: 'empty', content: '', num: '' });
+          }
+          if (pair.right) {
+            rightLines.push({ type: 'add', content: pair.right.content, num: newLineNum });
+            newLineNum++;
+          } else {
+            rightLines.push({ type: 'empty', content: '', num: '' });
+          }
+        }
+      }
+      
+      // 渲染左侧
+      html += '<div class="diff-side diff-side-left">';
+      for (const line of leftLines) {
+        html += '<div class="diff-line-row ' + line.type + '">';
+        html += '<div class="diff-line-num">' + (line.num !== '' ? line.num : '') + '</div>';
+        html += '<div class="diff-line-content">' + escapeHtml(line.content) + '</div>';
+        html += '</div>';
+      }
+      html += '</div>';
+      
+      // 渲染右侧
+      html += '<div class="diff-side">';
+      for (const line of rightLines) {
+        html += '<div class="diff-line-row ' + line.type + '">';
+        html += '<div class="diff-line-num">' + (line.num !== '' ? line.num : '') + '</div>';
+        html += '<div class="diff-line-content">' + escapeHtml(line.content) + '</div>';
+        html += '</div>';
+      }
+      html += '</div>';
+      
+      html += '</div>';
+    }
+    
+    html += '</div></div>';
+  }
+  
+  return html;
+}
+
+// WebSocket 实时更新
+(function initWebSocket() {
+  let ws;
+  let reconnectTimer;
+  let wsStatusEl = null;
+
+  function createStatusIndicator() {
+    if (wsStatusEl) return;
+    const header = document.querySelector('.header');
+    if (!header) return;
+    wsStatusEl = document.createElement('div');
+    wsStatusEl.style.cssText = 'margin-top: 10px; font-size: 12px; display: flex; align-items: center; gap: 6px;';
+    wsStatusEl.innerHTML = '<span id="ws-dot" style="width:8px;height:8px;border-radius:50%;background:#9ca3af;display:inline-block;"></span><span id="ws-text" style="opacity:0.7;">实时更新未连接</span>';
+    header.appendChild(wsStatusEl);
+  }
+
+  function updateStatus(connected, text) {
+    const dot = document.getElementById('ws-dot');
+    const txt = document.getElementById('ws-text');
+    if (dot) dot.style.background = connected ? '#4ade80' : '#9ca3af';
+    if (txt) txt.textContent = text;
+  }
+
+  function connect() {
+    try {
+      ws = new WebSocket('ws://localhost:8081');
+
+      ws.onopen = function() {
+        createStatusIndicator();
+        updateStatus(true, '实时更新已连接');
+        if (reconnectTimer) {
+          clearTimeout(reconnectTimer);
+          reconnectTimer = null;
+        }
+      };
+
+      ws.onmessage = function(event) {
+        try {
+          const data = JSON.parse(event.data);
+          if (data.type === 'reload') {
+            // 如果当前在看板页面，刷新数据
+            if (data.file && data.file.includes('index.html')) {
+              location.reload();
+            }
+            // 如果当前在 diff 弹窗中，刷新 diff 内容
+            if (data.file && data.file.includes('.diff')) {
+              const modal = document.getElementById('diff-modal');
+              if (modal && modal.classList.contains('active')) {
+                const titleEl = document.getElementById('diff-modal-title');
+                const currentFile = titleEl ? titleEl.dataset.filename : null;
+                if (currentFile && data.file.includes(currentFile)) {
+                  const titleText = titleEl.textContent.replace('改动详情 - ', '');
+                  openDiff(currentFile, titleText);
+                }
+              }
+            }
+          }
+        } catch (e) {
+          // 静默处理解析错误
+        }
+      };
+
+      ws.onclose = function() {
+        updateStatus(false, '实时更新已断开');
+        reconnectTimer = setTimeout(connect, 3000);
+      };
+
+      ws.onerror = function() {
+        // 静默处理连接错误
+      };
+    } catch (e) {
+      // 静默处理
+    }
+  }
+
+  connect();
+})();
+
+(function initDateIndex() {
+  const container = document.getElementById('date-index');
+  const dateCount = {};
+  
+  document.querySelectorAll('.tl-item .tl-time').forEach(el => {
+    const timeText = el.textContent.trim();
+    const dateMatch = timeText.match(/^(\d{4}-\d{2}-\d{2})/);
+    if (dateMatch) {
+      const date = dateMatch[1];
+      dateCount[date] = (dateCount[date] || 0) + 1;
+    }
+  });
+  
+  const sortedDates = Object.keys(dateCount).sort((a, b) => b.localeCompare(a));
+  
+  const all = document.createElement('div');
+  all.className = 'sidebar-date active';
+  all.textContent = '全部显示';
+  all.onclick = function() {
+    document.querySelectorAll('.sidebar-date').forEach(e => e.classList.remove('active'));
+    this.classList.add('active');
+    switchView('timeline');
+    setTimeout(() => document.querySelectorAll('.tl-item').forEach(e => e.style.display = ''), 100);
+  };
+  container.appendChild(all);
+  
+  sortedDates.forEach(date => {
+    const count = dateCount[date];
+    const month = parseInt(date.split('-')[1], 10);
+    const day = parseInt(date.split('-')[2], 10);
+    const label = month + '月' + day + '日 (' + count + '项)';
+    
+    const el = document.createElement('div');
+    el.className = 'sidebar-date';
+    el.textContent = label;
+    el.dataset.date = date;
+    el.onclick = function() {
+      document.querySelectorAll('.sidebar-date').forEach(e => e.classList.remove('active'));
+      this.classList.add('active');
+      switchView('timeline');
+      setTimeout(() => {
+        document.querySelectorAll('.tl-item').forEach(item => {
+          const timeEl = item.querySelector('.tl-time');
+          if (timeEl && timeEl.textContent.trim().startsWith(date)) {
+            item.style.display = '';
+          } else {
+            item.style.display = 'none';
+          }
+        });
+      }, 100);
+    };
+    container.appendChild(el);
+  });
+})();
+</script>
+</body>
+</html>
