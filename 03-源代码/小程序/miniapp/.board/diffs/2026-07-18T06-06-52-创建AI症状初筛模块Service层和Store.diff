-+    daysUntilEvent: number
-+    emotionTag: string
-+    historicalImpact: number
-+  }
-+}
-+
-+// 推送决策
-+interface OutreachDecision {
-+  shouldPush: boolean
-+  reason: string
-+  content: string
-+  timing: Date
-+  priority: 'low' | 'medium' | 'high' | 'critical'
-+}
