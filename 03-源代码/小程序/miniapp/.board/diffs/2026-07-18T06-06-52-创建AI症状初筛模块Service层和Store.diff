-  }, [activeFocusTask, focusTargetMinutes, focusPausedRemainingMs, nextFocusTask, focusDurationDraft])
-
-  const pauseFocusTimer = useCallback(() => {
-    if (focusEndsAt === null) return
-    const now = Date.now()
