-  color: #e2e8ff;
-}
-
-html[data-theme='night-cosmos'] input:focus,
-html[data-theme='night-cosmos'] textarea:focus,
-html[data-theme='night-cosmos'] select:focus {
-  border-color: rgba(99, 102, 241, 0.5);
-  box-shadow: 0 0 15px rgba(99, 102, 241, 0.15);
-  outline: none;
