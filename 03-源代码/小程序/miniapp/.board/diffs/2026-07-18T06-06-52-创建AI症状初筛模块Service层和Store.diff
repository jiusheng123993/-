-  user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
-  product_id VARCHAR(64) NOT NULL,
-  channel VARCHAR(20) NOT NULL CHECK (channel IN ('wechat', 'alipay', 'apple')),
-  amount INTEGER NOT NULL DEFAULT 0,
