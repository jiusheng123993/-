-+  | 'diagnostic'      // 诊断性：触发因素、周期
-+  | 'predictive'      // 预测性：预警、风险
-+  | 'prescriptive'    // 指导性：建议、行动
-+
-+// 情绪模式
-+interface EmotionPattern {
-+  type: 'weekly_cycle' | 'trigger_association' | 'behavior_correlation' | 'intervention_effect'
