-    if (typeof entitlements.avatar_ai_gen === 'number') return entitlements.avatar_ai_gen as number
-    return entitlements.avatar_ai_gen ? AVATAR_CONSTRAINTS.AI_GENERATION_MONTHLY_LIMIT : 0
