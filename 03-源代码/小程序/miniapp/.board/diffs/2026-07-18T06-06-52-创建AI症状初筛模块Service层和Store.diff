-  /** 获取内容历史 */
-  getContentHistory(): Record<string, unknown> {
-    return { ...this.contentHistory };
-  }
-
-  /** 开始急救流程 */
-  startFlow(flowId: string): void {
-    const flowConfig = getFlowById(flowId);
-    if (!flowConfig) {
