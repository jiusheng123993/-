-// 星寰海 v3.0 - 全局样式系统（水墨风格）
-// 设计方向：水墨意境 · 液态玻璃 · 东方美学
-
-// ===== 水墨色彩系统 =====
-// 宣纸色
-$color-rice-paper: #f7f4ed;
-$color-rice-paper-warm: #f0ebe3;
-$color-rice-paper-cool: #e8e4dc;
-
-// 墨色
-$color-ink-light: #8a8a8a;
-$color-ink-medium: #5a5a5a;
-$color-ink-dark: #2d2d2d;
-$color-ink-pure: #1a1a1a;
-
-// 水墨晕染色
-$color-wash-1: rgba(45, 45, 45, 0.04);
-$color-wash-2: rgba(45, 45, 45, 0.08);
-$color-wash-3: rgba(45, 45, 45, 0.12);
-
-// 点缀色（朱砂、石青、藤黄）
-$color-cinnabar: #c45c48;
-$color-stone-blue: #5a7a8c;
-$color-vine-yellow: #c4a35a;
-
-// 液态玻璃
-$color-glass-bg: rgba(255, 255, 255, 0.65);
-$color-glass-border: rgba(255, 255, 255, 0.3);
-$color-glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
-
-// ===== 间距系统 =====
-$spacing-xs: 4px;
-$spacing-sm: 8px;
-$spacing-md: 16px;
-$spacing-lg: 24px;
-$spacing-xl: 32px;
-$spacing-xxl: 48px;
-
-// ===== 字体系统 =====
-$font-size-xs: 20px;
-$font-size-sm: 24px;
-$font-size-md: 28px;
-$font-size-lg: 32px;
-$font-size-xl: 36px;
-$font-size-xxl: 48px;
-$font-size-display: 64px;
-
-$font-weight-normal: 400;
-$font-weight-medium: 500;
-$font-weight-semibold: 600;
-$font-weight-bold: 700;
-
-// ===== 圆角系统 =====
-$radius-sm: 8px;
-$radius-md: 12px;
-$radius-lg: 16px;
-$radius-xl: 24px;
-$radius-full: 999px;
-
-// ===== 阴影系统 =====
-$shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
-$shadow-md: 0 4px 12px rgba(0, 0, 0, 0.06);
-$shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.08);
-
-// ===== 动画 =====
-$transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
-$transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
-$transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
-
-// ===== 页面基础样式 =====
-page {
-  background-color: $color-rice-paper;
-  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB',
-    'Microsoft YaHei', 'Segoe UI', sans-serif;
-  font-size: $font-size-md;
-  color: $color-ink-dark;
-  line-height: 1.6;
-  -webkit-font-smoothing: antialiased;
-}
-
-// ===== 水墨背景纹理 =====
-.ink-wash-bg {
-  position: relative;
-  background: linear-gradient(180deg, $color-rice-paper 0%, $color-rice-paper-warm 50%, $color-rice-paper 100%);
-
-  &::before {
-    content: '';
-    position: absolute;
-    top: 0;
-    left: 0;
-    right: 0;
-    bottom: 0;
-    background-image:
-      radial-gradient(ellipse at 20% 30%, rgba(45, 45, 45, 0.03) 0%, transparent 50%),
-      radial-gradient(ellipse at 80% 70%, rgba(45, 45, 45, 0.02) 0%, transparent 50%);
-    pointer-events: none;
-  }
-}
-
-// ===== 墨水晕染动画 =====
-@keyframes inkSpread {
-  0% {
-    opacity: 0;
-    transform: scale(0.8);
-    filter: blur(8px);
-  }
-  50% {
-    opacity: 0.7;
-    filter: blur(4px);
-  }
-  100% {
-    opacity: 1;
-    transform: scale(1);
-    filter: blur(0);
-  }
-}
-
-@keyframes inkFadeIn {
-  0% {
-    opacity: 0;
-    transform: translateY(20px);
-  }
-  100% {
-    opacity: 1;
-    transform: translateY(0);
-  }
-}
-
-@keyframes inkRipple {
-  0% {
-    transform: scale(0);
-    opacity: 0.6;
-  }
-  100% {
-    transform: scale(2.5);
-    opacity: 0;
-  }
-}
-
-.ink-animate {
-  animation: inkSpread 0.8s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
-}
-
-.ink-fade-in {
-  animation: inkFadeIn 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
-}
-
-// ===== 液态玻璃效果 =====
-.glass-effect {
-  background: $color-glass-bg;
-  backdrop-filter: blur(20px);
-  -webkit-backdrop-filter: blur(20px);
-  border: 1px solid $color-glass-border;
-  box-shadow: $color-glass-shadow;
-}
-
-// ===== 悬浮导航栏 =====
-.floating-nav {
-  position: fixed;
-  bottom: 32px;
-  left: 50%;
-  transform: translateX(-50%);
-  display: flex;
-  align-items: center;
-  padding: 8px 16px;
-  border-radius: 32px;
-  background: rgba(255, 255, 255, 0.72);
-  backdrop-filter: blur(24px) saturate(180%);
-  -webkit-backdrop-filter: blur(24px) saturate(180%);
-  border: 1px solid rgba(255, 255, 255, 0.4);
-  box-shadow:
-    0 4px 24px rgba(0, 0, 0, 0.06),
-    0 1px 2px rgba(0, 0, 0, 0.04),
-    inset 0 1px 0 rgba(255, 255, 255, 0.6);
-  z-index: 1000;
-  gap: 4px;
-
-  &-item {
-    display: flex;
-    flex-direction: column;
-    align-items: center;
-    justify-content: center;
-    padding: 8px 16px;
-    border-radius: 24px;
-    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
-    cursor: pointer;
-    position: relative;
-
-    &:active {
-      transform: scale(0.92);
-    }
-
-    &.active {
-      background: rgba(45, 45, 45, 0.06);
-
-      .floating-nav-icon {
-        color: $color-ink-dark;
-      }
-
-      .floating-nav-text {
-        color: $color-ink-dark;
-        font-weight: 600;
-      }
-    }
-  }
-
-  &-icon {
-    width: 24px;
-    height: 24px;
-    color: $color-ink-light;
-    transition: all 0.3s ease;
-  }
-
-  &-text {
-    font-size: 11px;
-    color: $color-ink-light;
-    margin-top: 2px;
-    transition: all 0.3s ease;
-  }
-}
-
-// ===== 通用工具类 =====
-.container {
-  display: flex;
-  flex-direction: column;
-  min-height: 100vh;
-  box-sizing: border-box;
-}
-
-.card {
-  background: rgba(255, 255, 255, 0.8);
-  border-radius: $radius-lg;
-  padding: $spacing-md;
-  margin: $spacing-sm $spacing-md;
-  box-shadow: $shadow-sm;
-  border: 1px solid rgba(0, 0, 0, 0.04);
-}
-
-.btn-primary {
-  background: $color-ink-dark;
-  color: #fff;
-  border: none;
-  border-radius: $radius-full;
-  padding: $spacing-sm $spacing-lg;
-  font-size: $font-size-lg;
-  font-weight: $font-weight-medium;
-  text-align: center;
-  box-shadow: $shadow-md;
-  transition: all $transition-fast;
-
-  &:active {
-    transform: scale(0.98);
-    opacity: 0.9;
-  }
-}
-
-.text-center {
-  text-align: center;
-}
-
-.text-secondary {
-  color: $color-ink-medium;
-}
-
-.text-tertiary {
-  color: $color-ink-light;
