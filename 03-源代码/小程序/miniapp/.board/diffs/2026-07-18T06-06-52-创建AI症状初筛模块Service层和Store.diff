-
-  // 获取当天的事件
-  const dayEvents = useMemo<ScheduleEvent[]>(() => {
-    if (!date) return [];
-    return events.filter(e => e.date === date).sort((a, b) => {
-      const timeA = a.time || '';
-      const timeB = b.time || '';
