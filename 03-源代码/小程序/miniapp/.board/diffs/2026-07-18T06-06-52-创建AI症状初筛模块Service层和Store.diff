-+### 5.1 情绪急救引擎
-+
-+```typescript
-+// 急救流程状态机
-+type EmergencyState = 
-+  | 'idle'           // 初始状态
-+  | 'entry'          // 显示5选项
-+  | 'naming'         // 命名步骤
-+  | 'writing'        // 书写步骤
-+  | 'action'         // 行动步骤
-+  | 'connect'        // 连接步骤
-+  | 'closing'        // 收尾步骤
-+  | 'crisis'         // 高危干预
