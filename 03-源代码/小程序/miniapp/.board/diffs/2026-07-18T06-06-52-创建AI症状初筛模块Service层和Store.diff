-+    daysSinceLastActive: number
-+    lastMood: string
-+  }
-+  
-+  // 基于情绪趋势
-+  moodTrend?: {
-+    consecutiveNegativeDays: number
-+    trendDirection: 'declining' | 'improving'
-+    changePercent: number
-+  }
-+  
-+  // 基于日程
