-      setStep(s)
-    }
-  }, [totalSteps])
-
-  const isFirstStep = step === 1
-  const isLastStep = step === totalSteps
-
-  return useMemo(() => ({
-    formData,
-    step,
-    totalSteps,
-    updateField,
-    nextStep,
-    prevStep,
-    goToStep,
-    isStepValid,
-    isFirstStep,
-    isLastStep,
-  }), [formData, step, totalSteps, updateField, nextStep, prevStep, goToStep, isStepValid, isFirstStep, isLastStep])
