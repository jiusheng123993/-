-        const next = { ...current }
-        delete next[taskIdToClear]
-        return next
-      })
-    }
-  }, [activeFocusTask, focusDisplayTask])
-
-  return {
-    focusTaskId,
-    focusEndsAt,
-    focusPausedRemainingMs,
-    focusNow,
-    focusDurationDraft,
-    isFocusRunning,
-    activeFocusTask,
-    focusDisplayTask,
-    focusTargetMinutes,
-    focusSeconds,
-    focusMinuteText,
-    focusSecondText,
-    focusRewardPoints,
-    focusRemainingSeconds,
-    FOCUS_MIN_MINUTES,
-    FOCUS_MAX_MINUTES,
-    FOCUS_STEP_MINUTES,
-    startFocusTimer,
-    pauseFocusTimer,
-    resetFocusTimer,
-    adjustFocusDuration,
-    handleFocusDurationInput
-  }
-}
