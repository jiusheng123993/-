-// 星寰海 v2.0 - 危机关键词检测工具
-// 提供独立的危机检测功能，支持实时文本检测和强度评估
-
-import { CRISIS_KEYWORDS, HOTLINE_INFO } from '../data/crisisKeywords';
-
-/** 危机严重程度 */
-export type CrisisLevel = 'mild' | 'moderate' | 'severe';
-
-/** 检测结果 */
-export interface CrisisDetectionResult {
