-
-  /** 推进到下一步 */
-  nextStep(): boolean {
-    if (this.currentStep >= this.flowSteps.length - 1) {
-      return false; // 已经是最后一步
-    }
-
-    this.currentStep++;
-    this.updateState();
-    return true;
-  }
-
-  /** 回退到上一步 */
-  previousStep(): boolean {
-    if (this.currentStep <= 0) {
-      return false; // 已经是第一步
