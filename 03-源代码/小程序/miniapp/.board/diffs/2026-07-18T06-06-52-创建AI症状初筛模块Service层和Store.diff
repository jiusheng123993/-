-interface WallpaperAdjustments {
-  overlay: string
-  blur: number
-  brightness: number
-  saturation: number
-  vignette: number
-  cardOpacity: number
-}
-
-interface ReadabilityCheckResult {
-  score: number
-  warnings: string[]
-  issues: ('low_contrast' | 'too_bright' | 'too_dark' | 'too_busy')[]
