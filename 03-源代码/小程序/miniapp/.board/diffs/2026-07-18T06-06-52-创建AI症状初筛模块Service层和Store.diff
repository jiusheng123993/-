-    this.currentStep = 0;
-    this.flowSteps = [];
-    this.flowConfig = null;
-    this.contentHistory = {};
-    this.preFlowIntensity = 0;
-    this.postFlowIntensity = 0;
-  }
-
-  /** 恢复会话（用于中断后恢复） */
-  restoreSession(sessionData: {
-    state: string;
-    currentStep: number;
-    content: Record<string, unknown>;
-    flowId: string;
