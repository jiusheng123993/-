-    targetAtomIds: contradiction.atomIds,
-    confidence: 0.5,
-    reason: `发现关于 ${contradiction.object} 的矛盾记忆，需要用户确认`
-  }))
-
-  return {
-    atoms: promotedAtoms,
-    proposals: [...mergeProposals, ...promoteProposals, ...contradictionProposals]
-  }
-}
