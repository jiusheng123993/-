-+    effect?: string          // 影响
-+    correlation?: number     // 相关性 0-1
-+    frequency?: number       // 出现频率
-+  }
-+  
-+  // 置信度
-+  confidence: number         // 0-1，基于数据量
-+  
-+  // 例子
-+  example: string            // "每次和家人通话后第二天情绪低1.8分"
-+}
-+```
