-      const results: { personas: number; memoryEvents: number } = { personas: 0, memoryEvents: 0 }
-
-      if (body.personas && Array.isArray(body.personas)) {
-        for (const p of body.personas) {
-          const existing = await personaRepo.findById(p.id)
