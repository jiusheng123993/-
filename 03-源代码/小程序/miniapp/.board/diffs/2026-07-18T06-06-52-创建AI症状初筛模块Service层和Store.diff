-  const mastered = state.cards.filter(c => c.reviewCount >= 3 && c.interval >= 21).length
-  const masteryRate = total > 0 ? Math.round((mastered / total) * 100) : 0
-
-  const reviewLogs: ReviewLogEntry[] = []
