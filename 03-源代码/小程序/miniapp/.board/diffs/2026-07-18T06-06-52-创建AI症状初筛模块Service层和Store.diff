-      confidence: 0.65
-    })
-  }
-
-  if (focusEvents.length >= 5 && profile.preferences.workStyle !== 'deep_work') {
-    proposals.push({
-      fieldPath: 'preferences.workStyle',
-      oldValue: profile.preferences.workStyle ?? 'flexible',
-      newValue: 'deep_work',
-      reasoning: `近期完成了 ${focusEvents.length} 次深度专注，表现出深度工作偏好`,
