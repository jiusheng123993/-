-/** 风险等级颜色 - 水墨灰阶 */
-function getRiskColor(riskLevel: string): string {
-  switch (riskLevel) {
-    case 'critical': return '#2d2d2d'; // 深墨
-    case 'high': return '#5a5a5a';     // 浓墨
-    case 'medium': return '#8a8a8a';   // 中墨
