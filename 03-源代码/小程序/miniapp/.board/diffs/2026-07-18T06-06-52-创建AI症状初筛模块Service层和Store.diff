-/* ============================================
-   深空星海主题 (night-cosmos) v4 — Cosmic Brutalism
-   设计哲学：深空黑底 + 电光蓝紫霓虹 + 琥珀暖金点缀 + 粗野几何装饰
-   借鉴 Radium (Cosmin Capitanu) 的包装感、概念感、排版功力
-   ============================================ */
-
-/* --- CSS 变量覆盖 --- */
-html[data-theme='night-cosmos'] {
-  --app-background: #020617;
-  --surface: rgba(10, 14, 38, 0.85);
-  --surface-strong: rgba(15, 20, 50, 0.92);
-  --primary: #6366f1;
-  --secondary: #a855f7;
-  --accent: #f59e0b;
-  --text: #e2e8ff;
-  --muted: #94a3b8;
-  --border: rgba(99, 102, 241, 0.25);
-  --hero-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #f59e0b 100%);
-  --card-gradient: linear-gradient(135deg, rgba(15, 20, 50, 0.95), rgba(8, 10, 28, 0.9));
-  --shadow: 0 24px 80px rgba(0, 0, 0, 0.60);
-  --glass: blur(24px) saturate(1.1);
-  --glass-edge: rgba(99, 102, 241, 0.30);
-  --glass-edge-soft: rgba(99, 102, 241, 0.10);
-  --glass-tint: rgba(10, 14, 38, 0.75);
-  --glass-tint-hover: rgba(15, 22, 55, 0.85);
-  --glass-shadow: rgba(0, 0, 0, 0.55);
-  --glass-bubble: rgba(99, 102, 241, 0.15);
-}
-
-/* ============================================
-   背景层：深空底色
-   ============================================ */
-html[data-theme='night-cosmos'] body {
-  background: #020617;
-}
-
-/* 星云光斑 1 — 左上角大光斑，蓝紫调 */
-html[data-theme='night-cosmos'] body::before {
-  content: '';
-  position: fixed;
-  pointer-events: none;
-  z-index: 0;
-  width: 900px;
-  height: 900px;
-  border-radius: 50%;
-  background: radial-gradient(circle at 30% 30%, rgba(99, 102, 241, 0.15), rgba(168, 85, 247, 0.06) 40%, transparent 70%);
-  top: -350px;
-  left: -250px;
-  filter: blur(80px);
-  animation: nebulaDrift1 24s ease-in-out infinite;
-}
-
-/* 星云光斑 2 — 右下角，琥珀暖金调 */
-html[data-theme='night-cosmos'] body::after {
-  content: '';
-  position: fixed;
-  pointer-events: none;
-  z-index: 0;
-  width: 600px;
-  height: 600px;
-  border-radius: 50%;
-  background: radial-gradient(circle at 60% 60%, rgba(245, 158, 11, 0.08), rgba(99, 102, 241, 0.04) 45%, transparent 70%);
-  bottom: -200px;
-  right: -150px;
-  filter: blur(80px);
-  animation: nebulaDrift2 28s ease-in-out infinite;
-}
-
-@keyframes nebulaDrift1 {
-  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.6; }
-  25% { transform: translate(50px, -40px) scale(1.12); opacity: 0.9; }
-  50% { transform: translate(-30px, 30px) scale(0.92); opacity: 0.4; }
-  75% { transform: translate(40px, -15px) scale(1.06); opacity: 0.75; }
-}
-
-@keyframes nebulaDrift2 {
-  0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.4; }
-  33% { transform: translate(-40px, -30px) scale(1.1); opacity: 0.7; }
-  66% { transform: translate(30px, 40px) scale(0.9); opacity: 0.3; }
-}
-
-/* ============================================
-   网格线 — 粗野主义几何装饰
-   ============================================ */
-html[data-theme='night-cosmos'] .app-shell::before {
-  content: '';
-  position: fixed;
-  pointer-events: none;
-  z-index: 0;
-  inset: 0;
-  background-image:
-    linear-gradient(rgba(99, 102, 241, 0.05) 1px, transparent 1px),
-    linear-gradient(90deg, rgba(99, 102, 241, 0.05) 1px, transparent 1px);
-  background-size: 80px 80px;
-  mask-image: radial-gradient(ellipse at 50% 50%, black 25%, transparent 65%);
-}
-
-/* ============================================
-   星点层 — 多层视差星点（亮星 + 彩色星）
-   ============================================ */
-html[data-theme='night-cosmos'] .app-shell::after {
-  content: '';
-  position: fixed;
-  pointer-events: none;
-  z-index: 0;
-  inset: 0;
-  background:
-    radial-gradient(2.5px 2.5px at 8% 12%, rgba(226, 232, 255, 0.95), transparent),
-    radial-gradient(1.5px 1.5px at 22% 28%, rgba(99, 102, 241, 0.85), transparent),
-    radial-gradient(2px 2px at 38% 18%, rgba(226, 232, 255, 0.75), transparent),
-    radial-gradient(1px 1px at 52% 35%, rgba(168, 85, 247, 0.75), transparent),
-    radial-gradient(3px 3px at 68% 22%, rgba(245, 158, 11, 0.7), transparent),
-    radial-gradient(1.5px 1.5px at 82% 40%, rgba(226, 232, 255, 0.65), transparent),
-    radial-gradient(2px 2px at 15% 55%, rgba(99, 102, 241, 0.75), transparent),
-    radial-gradient(1px 1px at 32% 68%, rgba(226, 232, 255, 0.55), transparent),
-    radial-gradient(2.5px 2.5px at 48% 58%, rgba(168, 85, 247, 0.65), transparent),
-    radial-gradient(1.5px 1.5px at 62% 72%, rgba(226, 232, 255, 0.75), transparent),
-    radial-gradient(2px 2px at 78% 65%, rgba(245, 158, 11, 0.55), transparent),
-    radial-gradient(1px 1px at 88% 78%, rgba(226, 232, 255, 0.55), transparent),
-    radial-gradient(2px 2px at 5% 82%, rgba(99, 102, 241, 0.65), transparent),
-    radial-gradient(1.5px 1.5px at 42% 85%, rgba(226, 232, 255, 0.55), transparent),
-    radial-gradient(2px 2px at 72% 15%, rgba(168, 85, 247, 0.55), transparent),
-    radial-gradient(1px 1px at 18% 42%, rgba(245, 158, 11, 0.5), transparent),
-    radial-gradient(2px 2px at 58% 8%, rgba(226, 232, 255, 0.6), transparent),
-    radial-gradient(1.5px 1.5px at 92% 55%, rgba(99, 102, 241, 0.55), transparent);
-  animation: starfieldSlow 50s linear infinite;
-}
-
-@keyframes starfieldSlow {
-  0% { transform: translate(0, 0); }
-  25% { transform: translate(-20px, -10px); }
-  50% { transform: translate(10px, -20px); }
-  75% { transform: translate(-8px, 15px); }
-  100% { transform: translate(0, 0); }
-}
-
-/* ============================================
-   卡片/面板 — 深色玻璃 + 霓虹边框 + 琥珀暖金高光线
-   ============================================ */
-html[data-theme='night-cosmos'] .panel,
-html[data-theme='night-cosmos'] .card {
-  background: rgba(10, 14, 38, 0.78);
-  backdrop-filter: blur(24px) saturate(1.1);
-  -webkit-backdrop-filter: blur(24px) saturate(1.1);
-  border: 1px solid rgba(99, 102, 241, 0.18);
-  box-shadow:
-    0 8px 32px rgba(0, 0, 0, 0.40),
-    inset 0 1px 0 rgba(99, 102, 241, 0.08);
-  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
-}
-
-/* 卡片顶部高光线 — 蓝紫渐变 + 琥珀暖金收尾 */
-html[data-theme='night-cosmos'] .panel::after,
-html[data-theme='night-cosmos'] .card::after {
-  content: '';
-  position: absolute;
-  inset: 0;
-  top: 0;
-  left: 10%;
-  right: 10%;
-  height: 1px;
-  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.5), rgba(168, 85, 247, 0.4), rgba(245, 158, 11, 0.25), transparent);
-  opacity: 1;
-  pointer-events: none;
-  z-index: 1;
-}
-
-/* 卡片 hover — 霓虹发光 + 琥珀暖金点缀 */
-html[data-theme='night-cosmos'] .panel:hover,
-html[data-theme='night-cosmos'] .card:hover {
-  border-color: rgba(99, 102, 241, 0.55);
-  box-shadow:
-    0 16px 48px rgba(0, 0, 0, 0.55),
-    0 0 35px rgba(99, 102, 241, 0.22),
-    0 0 70px rgba(168, 85, 247, 0.12),
-    0 0 15px rgba(245, 158, 11, 0.08),
-    inset 0 1px 0 rgba(99, 102, 241, 0.18);
-  transform: translateY(-2px);
-}
-
-/* ============================================
-   光轨环绕 — hover 时卡片边缘旋转光效（蓝紫 + 琥珀）
-   ============================================ */
-html[data-theme='night-cosmos'] .panel::before,
-html[data-theme='night-cosmos'] .card::before {
-  content: '';
-  position: absolute;
-  inset: -2px;
-  border-radius: inherit;
-  background: conic-gradient(from 0deg, transparent 55%, rgba(99, 102, 241, 0.55), rgba(168, 85, 247, 0.45), rgba(245, 158, 11, 0.3), transparent 75%);
-  opacity: 0;
-  transition: opacity 0.5s ease;
-  z-index: -1;
-  pointer-events: none;
-}
-
-html[data-theme='night-cosmos'] .panel:hover::before,
-html[data-theme='night-cosmos'] .card:hover::before {
-  opacity: 1;
-  animation: orbitSpin 4s linear infinite;
-}
-
-@keyframes orbitSpin {
-  from { transform: rotate(0deg); }
-  to { transform: rotate(360deg); }
-}
-
-/* ============================================
-   标题 — 渐变流光文字（蓝紫 + 琥珀暖金）
-   ============================================ */
-html[data-theme='night-cosmos'] h1,
-html[data-theme='night-cosmos'] h2,
-html[data-theme='night-cosmos'] .hero-title {
-  background: linear-gradient(135deg, #e2e8ff 0%, #a5b4fc 25%, #c4b5fd 45%, #fcd34d 65%, #e2e8ff 100%);
-  background-size: 200% auto;
-  -webkit-background-clip: text;
-  background-clip: text;
-  -webkit-text-fill-color: transparent;
-  animation: textFlow 8s linear infinite;
-  text-shadow: none;
-}
-
-@keyframes textFlow {
-  from { background-position: 200% center; }
-  to { background-position: -200% center; }
-}
-
-/* ============================================
-   工作台区域 — 微光粒子上升
-   ============================================ */
-html[data-theme='night-cosmos'] .workspace-layout::after {
-  content: '';
-  position: fixed;
-  pointer-events: none;
-  z-index: 0;
-  inset: 0;
-  background:
-    radial-gradient(2px 2px at 15% 92%, rgba(99, 102, 241, 0.6), transparent),
-    radial-gradient(1.5px 1.5px at 35% 88%, rgba(245, 158, 11, 0.45), transparent),
-    radial-gradient(2px 2px at 55% 90%, rgba(168, 85, 247, 0.5), transparent),
-    radial-gradient(1px 1px at 75% 86%, rgba(226, 232, 255, 0.6), transparent),
-    radial-gradient(1.5px 1.5px at 90% 91%, rgba(99, 102, 241, 0.4), transparent);
-  animation: particlesRise 10s ease-in-out infinite;
-}
-
-@keyframes particlesRise {
-  0%, 100% { transform: translateY(0); opacity: 0.3; }
-  50% { transform: translateY(-40px); opacity: 0.8; }
-}
-
-/* ============================================
-   按钮 — 霓虹 hover + 琥珀暖金点缀
-   ============================================ */
-html[data-theme='night-cosmos'] button:not(.plain):hover {
-  box-shadow:
-    0 0 20px rgba(99, 102, 241, 0.35),
-    0 0 40px rgba(99, 102, 241, 0.12),
-    0 0 8px rgba(245, 158, 11, 0.15);
-  transition: box-shadow 0.3s ease;
-}
-
-html[data-theme='night-cosmos'] button.primary,
-html[data-theme='night-cosmos'] .btn-primary {
-  background: linear-gradient(135deg, #6366f1, #a855f7);
-  border: none;
-  color: #fff;
-  box-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);
-}
-
-html[data-theme='night-cosmos'] button.primary:hover,
-html[data-theme='night-cosmos'] .btn-primary:hover {
-  background: linear-gradient(135deg, #818cf8, #c084fc);
-  box-shadow:
-    0 6px 30px rgba(99, 102, 241, 0.45),
-    0 0 15px rgba(245, 158, 11, 0.2);
-}
-
-/* ============================================
-   输入框 — 深色风格
-   ============================================ */
-html[data-theme='night-cosmos'] input,
-html[data-theme='night-cosmos'] textarea,
-html[data-theme='night-cosmos'] select {
-  background: rgba(10, 14, 38, 0.6);
