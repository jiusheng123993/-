-    growth: legacyState.growth ?? fallback.growth,
-    preferences: {
-      themeId: legacyState.preferences?.themeId ?? fallback.preferences.themeId,
-      themeMode: legacyState.preferences?.themeId ? 'manual' : fallback.preferences.themeMode,
