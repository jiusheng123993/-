-
-html[data-theme='night-cosmos'] input::placeholder,
-html[data-theme='night-cosmos'] textarea::placeholder {
-  color: rgba(148, 163, 184, 0.5);
-}
-
-/* ============================================
-   模态框 — 深色玻璃 + 霓虹边框
-   ============================================ */
-html[data-theme='night-cosmos'] .modal,
-html[data-theme='night-cosmos'] [class*="modal"],
-html[data-theme='night-cosmos'] [class*="Modal"] {
-  background: rgba(10, 14, 38, 0.92);
-  backdrop-filter: blur(30px) saturate(1.2);
