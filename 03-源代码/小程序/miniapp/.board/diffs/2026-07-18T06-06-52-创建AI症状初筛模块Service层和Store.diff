-    totalMaxScore += s.totalScore
-  }
-  const averageRate = totalMaxScore > 0 ? totalScore / totalMaxScore : 0
-  return {
-    totalScore,
-    totalMaxScore,
-    averageRate,
-    subjectCount: record.scores.length
-  }
-}
