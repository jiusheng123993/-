-import { getStorage, setStorage, setEncryptionEnabled, setStorageUserId } from '../../utils/storage';
-
-/** 默认配置常量 */
-export const DEFAULT_CONFIG = {
-  // 存储限制
-  maxMoodEntries: 500,
