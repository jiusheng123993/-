+      rewardGranted: false,
+      rewardType: 'none',
+      rewardValue: 0,
+      message: (res.data?.error as string) || '奖励发放失败',
+    };
+  } catch {
+    return {
+      rewardGranted: false,
+      rewardType: 'none',
+      rewardValue: 0,
+      message: '网络异常，请稍后重试',
+    };
+  }
+}
