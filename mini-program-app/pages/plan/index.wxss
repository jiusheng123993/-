.section-block {
  margin-top: 28rpx;
}

.section-title {
  display: block;
  color: #2b2833;
  font-size: 30rpx;
  font-weight: 900;
}

.task-list,
.schedule-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.task-item,
.schedule-item,
.review-card {
  border: 1rpx solid rgba(255, 122, 144, 0.16);
  border-radius: 28rpx;
  padding: 22rpx;
  background: #fffdf8;
}

.task-item,
.schedule-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.status-pill {
  border-radius: 999rpx;
  padding: 8rpx 14rpx;
  color: #ff7a90;
  background: rgba(255, 122, 144, 0.12);
  font-size: 22rpx;
  font-weight: 800;
}

.progress-track {
  overflow: hidden;
  height: 12rpx;
  margin: 18rpx 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 144, 0.12);
}

.progress-track view {
  height: 100%;
  border-radius: 999rpx;
  background: #ff7a90;
}

.review-card {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}
