page {
  min-height: 100vh;
  background: #fff7e6;
  color: #2b2833;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.container {
  padding: 32rpx;
}

.panel {
  border: 1rpx solid rgba(255, 122, 144, 0.18);
  border-radius: 36rpx;
  padding: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 24rpx 60rpx rgba(255, 122, 144, 0.12);
}

.eyebrow {
  color: #ff7a90;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #2b2833;
  font-size: 42rpx;
  font-weight: 900;
}

.description {
  display: block;
  margin-top: 12rpx;
  color: #7a7180;
  font-size: 26rpx;
  line-height: 1.7;
}

.card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.module-card {
  border: 1rpx solid rgba(255, 122, 144, 0.16);
  border-radius: 28rpx;
  padding: 22rpx;
  background: #fffdf8;
}

.module-title {
  display: block;
  color: #2b2833;
  font-size: 26rpx;
  font-weight: 800;
}

.module-meta {
  display: block;
  margin-top: 8rpx;
  color: #7a7180;
  font-size: 22rpx;
}
