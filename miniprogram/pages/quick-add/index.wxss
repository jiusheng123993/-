.privacy-card {
  display: grid;
  gap: 8rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(255, 122, 144, 0.16);
  border-radius: 28rpx;
  padding: 22rpx;
  background: rgba(255, 122, 144, 0.08);
}

.privacy-title {
  color: #ff7a90;
  font-size: 26rpx;
  font-weight: 900;
}

.capture-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.capture-button {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
  border: 0;
  border-radius: 28rpx;
  padding: 24rpx;
  color: #ffffff;
  background: #ff7a90;
  font-weight: 800;
  text-align: left;
}

.capture-title,
.capture-description {
  display: block;
  color: #ffffff;
}

.capture-title {
  font-size: 28rpx;
  font-weight: 900;
}

.capture-description {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.86;
}

.capture-privacy {
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 20rpx;
}
