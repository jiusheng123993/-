<view class="container home-page">
  <view class="panel hero-panel">
    <text class="eyebrow">{{blueprint.positioning}}</text>
    <text class="title">今天</text>
    <text class="description">{{blueprint.mobileBoundary}}</text>
    <view class="priority-card">
      <text class="module-title">{{primaryAction}}</text>
      <text class="module-meta">计划 · 专注 · 记录 · 复盘</text>
    </view>
  </view>

  <view class="section-block">
    <text class="section-title">今日优先级</text>
    <view class="priority-list">
      <view class="priority-item" wx:for="{{priorities}}" wx:key="title">
        <text class="priority-tag">{{item.tag}}</text>
        <view>
          <text class="module-title">{{item.title}}</text>
          <text class="module-meta">{{item.meta}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section-block">
    <text class="section-title">快捷入口</text>
    <view class="card-grid compact-grid">
      <view class="module-card" wx:for="{{shortcuts}}" wx:key="title">
        <text class="module-title">{{item.title}}</text>
        <text class="module-meta">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="card-grid">
    <view class="module-card support-card">
      <text class="module-title">{{energyStatus.title}}</text>
      <text class="module-meta">{{energyStatus.description}}</text>
    </view>
    <view class="module-card support-card">
      <text class="module-title">{{reviewSummary.title}}</text>
      <text class="module-meta">{{reviewSummary.description}}</text>
    </view>
  </view>

  <view class="section-block">
    <text class="section-title">默认模块</text>
    <view class="card-grid">
      <view class="module-card" wx:for="{{modules}}" wx:key="id">
        <text class="module-title">{{item.title}}</text>
        <text class="module-meta">{{item.privacyLevel}}</text>
      </view>
    </view>
  </view>
</view>
