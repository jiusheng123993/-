.notice-card {
  margin-top: 24rpx;
  border-radius: 26rpx;
  padding: 22rpx;
  color: #8a4f00;
  background: rgba(245, 184, 75, 0.16);
  font-size: 24rpx;
  line-height: 1.7;
}

.section-block {
  margin-top: 30rpx;
}

.section-title {
  display: block;
  color: #2b2833;
  font-size: 30rpx;
  font-weight: 900;
}

.setting-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.setting-item {
  border-radius: 24rpx;
  padding: 24rpx;
  background: #fffdf8;
  color: #2b2833;
  font-weight: 800;
}

.privacy-item,
.data-action {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.setting-title {
  display: block;
  color: #2b2833;
  font-size: 26rpx;
  font-weight: 900;
}

.setting-status,
.risk-pill {
  border-radius: 999rpx;
  padding: 8rpx 12rpx;
  color: #ff7a90;
  background: rgba(255, 122, 144, 0.12);
  font-size: 20rpx;
  font-weight: 900;
  white-space: nowrap;
}

.compact-list {
  grid-template-columns: 1fr 1fr;
}
