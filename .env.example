# 星寰海环境变量配置
# 复制此文件为 .env 并填入真实值

# === 后端服务 ===
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# === 认证 ===
# JWT密钥，生产环境必须设置，至少32字符
JWT_SECRET=

# === 小程序端 ===
# 后端API地址
TARO_APP_API_BASE_URL=http://localhost:3000

# === 微信小程序订阅消息模板ID ===
# 在微信小程序后台申请后填入
TARO_APP_FOLLOWUP_TEMPLATE_ID=
TARO_APP_INTERVENTION_TEMPLATE_ID=
TARO_APP_MOOD_CHECKIN_TEMPLATE_ID=
TARO_APP_VACCINE_REMINDER_TEMPLATE_ID=
