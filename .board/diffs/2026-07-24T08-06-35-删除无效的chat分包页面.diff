+.profile-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  animation: pageEnter 0.4s ease-out;
+  position: relative;
+  overflow: hidden;
+}
+
+.profile-page::before {
+  content: "";
+  position: absolute;
+  bottom: 100rpx;
+  left: -40rpx;
+  width: 200rpx;
+  height: 200rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.06) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 5s ease-in-out 1s infinite;
+}
+
+.profile-header {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-direction: column;
+  padding: 48rpx 32rpx 32rpx;
+  background: linear-gradient(180deg, rgba(var(--primary, #C88EA8), 0.06), var(--bg-page, #1A1418) 100%);
+}
+
+.profile-avatar {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 160rpx;
+  height: 160rpx;
+  border-radius: 999rpx;
+  background: linear-gradient(135deg, var(--bg-card, #2A1E24), rgba(var(--primary, #C88EA8), 0.1));
+  border: 2rpx solid rgba(var(--primary, #C88EA8), 0.2);
+  box-shadow: 0 0 32rpx rgba(var(--primary, #C88EA8), 0.15);
+  margin-bottom: 24rpx;
+  animation: rootGlow 4s ease-in-out infinite;
+}
+
+.profile-avatar-emoji {
+  font-size: 80rpx;
+}
+
+.profile-name {
+  font-size: 40rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  margin-bottom: 8rpx;
+}
+
+.profile-breed {
+  font-size: 24rpx;
+  color: var(--text-hint, #988898);
+  margin-bottom: 16rpx;
+}
+
+.profile-tags {
+  display: flex;
+  gap: 12rpx;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+.profile-tag {
+  padding: 8rpx 22rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  font-size: 20rpx;
+  color: var(--primary-light, #E8C8D8);
+  border: 1rpx solid rgba(var(--primary, #C88EA8), 0.2);
+  transition: all 0.2s ease;
+}
+.profile-tag:active {
+  border-color: var(--primary, #C88EA8);
+  background: rgba(var(--primary, #C88EA8), 0.1);
+}
+
+.profile-pet-switcher {
+  display: flex;
+  gap: 12rpx;
+  padding: 16rpx 32rpx;
+  overflow-x: auto;
+}
+
+.profile-pet-tab {
+  display: flex;
+  align-items: center;
+  gap: 8rpx;
+  padding: 12rpx 28rpx;
+  background: var(--bg-card, #2A1E24);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  font-size: 24rpx;
+  color: var(--text-secondary, #A098A0);
+  white-space: nowrap;
+  transition: all 0.2s ease;
+}
+.profile-pet-tab:active {
+  transform: scale(0.95);
+  opacity: 0.8;
+}
+
+.profile-pet-tab-active {
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  color: var(--text-inverse, #1A1418);
+  border-color: transparent;
+  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.3);
+}
+
+.profile-section {
+  margin: 0 32rpx 16rpx;
+}
+
+.profile-section-title {
+  font-size: 30rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  margin-bottom: 16rpx;
+  display: block;
+}
+
+.profile-info-grid {
+  display: grid;
+  grid-template-columns: repeat(2, 1fr);
+  gap: 12rpx;
+}
+
+.profile-info-item {
+  padding: 22rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  transition: all 0.2s ease;
+  animation: cardStaggerIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) both;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.profile-info-item:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.profile-info-item:active {
+  border-color: rgba(var(--primary, #C88EA8), 0.3);
+}
+
+.profile-info-item:nth-child(1) {
+  animation-delay: 0s;
+}
+
+.profile-info-item:nth-child(2) {
+  animation-delay: 0.06s;
+}
+
+.profile-info-item:nth-child(3) {
+  animation-delay: 0.12s;
+}
+
+.profile-info-item:nth-child(4) {
+  animation-delay: 0.18s;
+}
+
+.profile-info-label {
+  font-size: 20rpx;
+  color: var(--text-hint, #988898);
+  display: block;
+  margin-bottom: 6rpx;
+}
+
+.profile-info-value {
+  font-size: 28rpx;
+  color: var(--text-primary, #E8D8DE);
+  font-weight: 500;
+}
+
+.profile-feature-card {
+  padding: 0;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  overflow: hidden;
+}
+
+.profile-feature-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 26rpx 24rpx;
+  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+  transition: background 0.15s ease;
+}
+.profile-feature-item:last-child {
+  border-bottom: none;
+}
+.profile-feature-item:active {
+  background: rgba(var(--primary, #C88EA8), 0.05);
+}
+
+.profile-feature-label {
+  font-size: 24rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.profile-feature-value {
+  font-size: 24rpx;
+  color: var(--primary-light, #E8C8D8);
+  font-weight: 500;
+}
+
+.profile-health-card {
+  padding: 0;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  overflow: hidden;
+}
+
+.profile-health-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 26rpx 24rpx;
+  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+  transition: background 0.15s ease;
+}
+.profile-health-item:last-child {
+  border-bottom: none;
+}
+.profile-health-item:active {
+  background: rgba(var(--primary, #C88EA8), 0.05);
+}
+
+.profile-health-label {
+  font-size: 24rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.profile-health-value {
+  font-size: 24rpx;
+  color: var(--text-primary, #E8D8DE);
+  font-weight: 500;
+}
+
+.profile-actions {
+  display: flex;
+  gap: 16rpx;
+}
+
+.profile-action-btn {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8rpx;
+  padding: 28rpx 12rpx;
+  background: var(--bg-card, #2A1E24);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 16rpx;
+  transition: all 0.2s ease;
+}
+.profile-action-btn:active {
+  transform: scale(0.96);
+  border-color: rgba(var(--primary, #C88EA8), 0.3);
+  background: rgba(var(--primary, #C88EA8), 0.05);
+}
+
+.profile-action-icon {
+  font-size: 40rpx;
+  transition: transform 0.2s ease;
+}
+
+.profile-action-btn:active .profile-action-icon {
+  transform: scale(0.9);
+}
+
+.profile-action-label {
+  font-size: 24rpx;
+  color: var(--text-primary, #E8D8DE);
+  font-weight: 500;
+}
+
+.profile-danger-zone {
+  padding: 24rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 1rpx solid rgba(var(--coral, #D0A098), 0.3);
+}
+
+.profile-danger-title {
+  font-size: 24rpx;
+  color: var(--coral, #D0A098);
+  font-weight: 500;
+  margin-bottom: 16rpx;
+  display: block;
+}
+
+.profile-danger-btn {
+  padding: 16rpx;
+  text-align: center;
+  background: rgba(var(--coral, #D0A098), 0.08);
+  border: 1rpx solid rgba(var(--coral, #D0A098), 0.25);
+  border-radius: 8rpx;
+  font-size: 24rpx;
+  color: var(--coral, #D0A098);
+  border-radius: 16rpx;
+  transition: all 0.15s ease;
+}
+.profile-danger-btn:active {
+  background: rgba(var(--coral, #D0A098), 0.15);
+  transform: scale(0.98);
+}
+
+.profile-empty {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-direction: column;
+  padding: 120rpx 32rpx;
+}
+
+.profile-empty-icon {
+  font-size: 80rpx;
+  margin-bottom: 16rpx;
+  opacity: 0.6;
+}
+
+.profile-empty-text {
+  font-size: 28rpx;
+  color: var(--text-secondary, #A098A0);
+  font-weight: 500;
+  margin-bottom: 8rpx;
+}
+
+.profile-empty-hint {
+  font-size: 20rpx;
+  color: var(--text-hint, #988898);
+  margin-bottom: 32rpx;
+}
+
+.profile-empty-btn {
+  padding: 16rpx 56rpx;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  color: var(--text-inverse, #1A1418);
+  font-size: 28rpx;
+  font-weight: 600;
+  border-radius: 40rpx;
+  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.3);
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.profile-empty-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.profile-bottom-safe {
+  height: 60rpx;
+}
