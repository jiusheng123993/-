+  position: relative;
+  overflow: hidden;
+  animation: pageEnter 0.4s ease-out;
+}
+.profile-page .ink-bg-decoration {
+  position: absolute;
+  border-radius: 50%;
+  filter: blur(60rpx);
+  opacity: 0;
+  pointer-events: none;
+  animation: inkSpread 2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
+}
+.profile-page .ink-bg-1 {
+  width: 300rpx;
+  height: 300rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.06) 0%, transparent 70%);
+  top: -50rpx;
+  right: -80rpx;
+  animation-delay: 0.3s;
+}
+.profile-page .ink-bg-2 {
+  width: 250rpx;
+  height: 250rpx;
+  background: radial-gradient(circle, rgba(var(--primary-light, #E8C8D8), 0.04) 0%, transparent 70%);
+  bottom: 200rpx;
+  left: -60rpx;
+  animation-delay: 0.6s;
+}
+
+@keyframes inkSpread {
+  0% {
+    opacity: 0;
+    transform: scale(0.5);
+    filter: blur(80rpx);
+  }
+  50% {
+    opacity: 0.6;
+    filter: blur(40rpx);
+  }
+  100% {
+    opacity: 1;
+    transform: scale(1);
+    filter: blur(60rpx);
+  }
+}
+@keyframes inkFadeIn {
+  0% {
+    opacity: 0;
+    transform: translateY(20rpx);
+  }
+  100% {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+.ink-item {
+  opacity: 0;
+  animation: inkFadeIn 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
+}
+
+.profile-header {
+  background: var(--bg-card, #2A1E24);
+  padding: 48rpx 24rpx;
+  position: relative;
+  overflow: hidden;
+}
+.profile-header::after {
+  content: "";
+  position: absolute;
+  top: -50%;
+  right: -20%;
+  width: 300rpx;
+  height: 300rpx;
