+}
+
+.pet-checkin__disclaimer {
+  padding: 20rpx;
+  background: rgba(var(--primary, #C88EA8), 0.08);
+  border-radius: 16rpx;
+  border: 1rpx solid rgba(var(--primary, #C88EA8), 0.12);
+  margin-top: 24rpx;
+}
+
+.pet-checkin__disclaimer-text {
+  font-size: 22rpx;
+  color: var(--primary-light, #E8C8D8);
+  line-height: 1.5;
+}
+
+.pet-checkin__feedback-overlay {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: var(--bg-overlay, rgba(0, 0, 0, 0.7));
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.pet-checkin__feedback-popup {
+  width: 600rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 48rpx 40rpx 40rpx;
+  text-align: center;
+  animation: fadeInScale 0.3s ease-out;
+}
+
+.pet-checkin__feedback-header {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  margin-bottom: 24rpx;
+}
+
+.pet-checkin__feedback-icon {
+  font-size: 72rpx;
+  margin-bottom: 16rpx;
+}
+
+.pet-checkin__feedback-title {
+  font-size: 32rpx;
+  font-weight: 600;
+  color: var(--text-primary, #E8D8DE);
+}
+
+.pet-checkin__feedback-text {
+  font-size: 26rpx;
+  color: var(--text-secondary, #A098A0);
+  line-height: 1.6;
+  margin-bottom: 36rpx;
+  text-align: left;
+}
+
+.pet-checkin__feedback-actions {
+  display: flex;
+  flex-direction: column;
+  gap: 16rpx;
+}
+
+.pet-checkin__feedback-btn {
+  height: 80rpx;
+  border-radius: 40rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.pet-checkin__feedback-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.pet-checkin__feedback-btn--emergency {
+  background: linear-gradient(135deg, var(--danger, #C87070), #C0705A);
+}
+
+.pet-checkin__feedback-btn--emergency .pet-checkin__feedback-btn-text {
+  color: var(--text-primary, #E8D8DE);
+}
+
+.pet-checkin__feedback-btn--food {
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+}
+
+.pet-checkin__feedback-btn--food .pet-checkin__feedback-btn-text {
+  color: var(--text-inverse, #1A1418);
+}
+
+.pet-checkin__feedback-btn--close {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.pet-checkin__feedback-btn--close .pet-checkin__feedback-btn-text {
+  color: var(--text-tertiary, #786870);
+}
+
+.pet-checkin__feedback-btn-text {
+  font-size: 28rpx;
+  font-weight: 500;
+}
+
+.pet-checkin__result-wrapper {
+  display: flex;
+  flex-direction: column;
+  gap: 24rpx;
+}
+
+.pet-checkin__diary {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 32rpx;
+  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
+  border-color: rgba(var(--primary, #C88EA8), 0.25);
+}
+
+.pet-checkin__diary-header {
+  display: flex;
+  align-items: center;
+  gap: 16rpx;
+  margin-bottom: 24rpx;
+  padding-bottom: 20rpx;
+  border-bottom: 2rpx dashed rgba(var(--primary, #C88EA8), 0.15);
+}
+
+.pet-checkin__diary-title {
+  font-size: 28rpx;
+  font-weight: 600;
+  color: var(--primary, #C88EA8);
+  letter-spacing: 1rpx;
+}
+
+.pet-checkin__diary-body {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 16rpx 0;
+}
+
+.pet-checkin__diary-emoji {
+  font-size: 56rpx;
+  line-height: 1;
+  margin-bottom: 16rpx;
+}
+
+.pet-checkin__diary-text {
+  font-size: 28rpx;
+  color: var(--text-secondary, #A098A0);
+  line-height: 1.8;
+  text-align: center;
+  font-style: italic;
+  max-width: 480rpx;
+}
+
+.pet-checkin__diary-author {
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+  margin-top: 12rpx;
+  align-self: flex-end;
+}
+
+.pet-checkin__diary-share {
+  margin-top: 24rpx;
+  height: 72rpx;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  border-radius: 36rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 6rpx 24rpx rgba(var(--primary, #C88EA8), 0.25);
+  transition: all 0.25s ease;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.pet-checkin__diary-share:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.pet-checkin__diary-share-text {
+  font-size: 28rpx;
+  font-weight: 600;
+  color: var(--text-inverse, #1A1418);
+}
+
+.pet-checkin__care-plan-btn {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 32rpx;
+  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
+  border-color: rgba(var(--primary, #C88EA8), 0.25);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: all 0.25s ease;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.pet-checkin__care-plan-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.pet-checkin__care-plan-btn-text {
+  font-size: 28rpx;
+  font-weight: 600;
+  color: var(--primary, #C88EA8);
+  letter-spacing: 1rpx;
+}
