+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.chronic-modal-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.chronic-modal-btn-cancel {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  color: var(--text-secondary, #A098A0);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.chronic-modal-btn-confirm {
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  color: var(--text-inverse, #1A1418);
+}
+
+.chronic-empty {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 100vh;
+}
+
+.chronic-empty-text {
+  font-size: 16rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.chronic-bottom-safe {
+  height: 40rpx;
+}
