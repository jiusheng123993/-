+.chat-home-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  display: flex;
+  flex-direction: column;
+  position: relative;
+  animation: pageEnter 0.4s ease-out;
+}
+
+.chat-paw-particles {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  pointer-events: none;
+  z-index: 0;
+  overflow: hidden;
+}
+
+.chat-paw {
+  position: absolute;
+  font-size: 32rpx;
+  opacity: 0;
+}
+.chat-paw--1 {
+  bottom: 20%;
+  left: 8%;
+  animation: pawFloat1 5s ease-out infinite;
+  animation-delay: 0s;
+}
+.chat-paw--2 {
+  bottom: 30%;
+  right: 10%;
+  animation: pawFloat2 6s ease-out infinite;
+  animation-delay: 2s;
+}
+.chat-paw--3 {
+  bottom: 15%;
+  left: 45%;
+  animation: pawFloat3 4.5s ease-out infinite;
+  animation-delay: 1s;
+}
+.chat-paw--4 {
+  bottom: 25%;
+  right: 30%;
+  animation: pawFloat1 5.5s ease-out infinite;
+  animation-delay: 3s;
+}
+.chat-paw--5 {
+  bottom: 10%;
+  left: 25%;
+  animation: pawFloat2 4.8s ease-out infinite;
+  animation-delay: 0.5s;
+}
+.chat-paw--6 {
+  bottom: 35%;
+  left: 60%;
+  animation: pawFloat3 5.2s ease-out infinite;
+  animation-delay: 2.5s;
+}
+
+.chat-stars {
+  position: fixed;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  pointer-events: none;
+  z-index: 0;
+  overflow: hidden;
+}
+
+.chat-star {
+  position: absolute;
+  font-size: 16rpx;
+  opacity: 0.25;
+}
+.chat-star--1 {
+  top: 8%;
+  right: 12%;
+  animation: starTwinkle1 2.5s ease-in-out infinite;
+}
+.chat-star--2 {
+  top: 15%;
+  left: 8%;
+  animation: starTwinkle2 3s ease-in-out infinite;
+  animation-delay: 0.8s;
+}
+.chat-star--3 {
+  top: 22%;
+  right: 25%;
+  animation: starTwinkle3 2.8s ease-in-out infinite;
+  animation-delay: 1.6s;
+}
+.chat-star--4 {
