+}
+.stat-item:active {
+  background: rgba(var(--primary, #C88EA8), 0.12);
+}
+
+.stat-value {
+  font-size: 48rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  line-height: 1.2;
+}
+
+.stat-label {
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+  margin-top: 8rpx;
+  font-weight: 500;
+}
+
+.menu-section {
+  margin: 24rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  overflow: hidden;
+  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
+  position: relative;
+  z-index: 1;
+}
+
+.menu-item {
+  display: flex;
+  align-items: center;
+  padding: 32rpx;
+  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.menu-item:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.menu-item:last-child {
+  border-bottom: none;
+}
+.menu-item:active {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+}
+
+.menu-icon {
+  font-size: 40rpx;
+  margin-right: 24rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 64rpx;
+  height: 64rpx;
+  border-radius: 12rpx;
+  background: rgba(var(--primary, #C88EA8), 0.1);
+}
+
+.menu-text {
+  flex: 1;
+  font-size: 32rpx;
+  color: var(--text-primary, #E8D8DE);
+  font-weight: 500;
+}
+
+.menu-arrow {
+  font-size: 36rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.logout-section {
+  margin: 48rpx 24rpx 24rpx;
+  position: relative;
+  z-index: 1;
+}
+
+.logout-btn {
+  height: 96rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 48rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
+  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.logout-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.logout-btn:active {
+  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
+}
+
+.logout-text {
+  font-size: 32rpx;
+  color: var(--text-secondary, #A098A0);
+  font-weight: 600;
+}
+
+.profile-footer {
+  position: fixed;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  padding: 24rpx;
+  text-align: center;
+  background: var(--bg-page, #1A1418);
+}
+
+.footer-text {
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+}
