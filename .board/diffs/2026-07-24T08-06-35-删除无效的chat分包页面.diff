+  line-height: 1.4;
+  flex-shrink: 0;
+}
+
+.pet-diary__entry-text {
+  font-size: 15rpx;
+  color: var(--text-primary, #E8D8DE);
+  line-height: 1.5;
+  flex: 1;
+}
+
+.pet-diary__entry-note {
+  display: flex;
+  align-items: flex-start;
+  gap: 4rpx;
+  padding: 8rpx 10rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border-radius: 8rpx;
+  margin-bottom: 8rpx;
+}
+
+.pet-diary__note-label {
+  font-size: 12rpx;
+  color: var(--text-tertiary, #786870);
+  flex-shrink: 0;
+}
+
+.pet-diary__note-text {
+  font-size: 12rpx;
+  color: var(--text-secondary, #A098A0);
+  flex: 1;
+}
+
+.pet-diary__entry-share {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 6rpx 0;
+}
+
+.pet-diary__share-text {
+  font-size: 12rpx;
+  color: var(--primary, #C88EA8);
+}
+
+.pet-diary__disclaimer {
+  padding: 12rpx 24rpx 20rpx;
+  text-align: center;
+}
+
+.pet-diary__disclaimer-text {
+  font-size: 11rpx;
+  color: var(--text-tertiary, #786870);
+  line-height: 1.5;
+}
