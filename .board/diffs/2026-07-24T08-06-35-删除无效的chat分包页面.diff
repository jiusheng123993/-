+.hospital-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  padding-bottom: 200rpx;
+  animation: pageEnter 0.4s ease-out;
+}
+
+.hospital-page__search {
+  display: flex;
+  align-items: center;
+  gap: 16rpx;
+  padding: 24rpx;
+  background: var(--bg-card, #2A1E24);
+  border-bottom: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.hospital-page__search-input-wrap {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
+  height: 80rpx;
+  padding: 0 24rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border-radius: 40rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.hospital-page__search-icon {
+  font-size: 28rpx;
+  color: var(--text-tertiary, #786870);
+  flex-shrink: 0;
+}
+
+.hospital-page__search-input {
+  flex: 1;
+  font-size: 28rpx;
+  color: var(--text-primary, #E8D8DE);
+  height: 100%;
+}
+
+.hospital-page__search-placeholder {
+  color: var(--text-tertiary, #786870);
+}
+
+.hospital-page__search-btn {
+  width: 120rpx;
+  height: 80rpx;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  border-radius: 40rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.25);
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.hospital-page__search-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.hospital-page__search-btn-text {
+  font-size: 28rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 600;
+}
+
+.hospital-page__filters {
+  display: flex;
+  gap: 16rpx;
+  padding: 16rpx 24rpx;
+  background: var(--bg-card, #2A1E24);
+  overflow-x: auto;
+  white-space: nowrap;
+}
+
+.hospital-page__filter-tag {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 12rpx 28rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border: 1rpx solid rgba(255, 255, 255, 0.04);
+  border-radius: 32rpx;
+  transition: all 0.25s ease;
+  flex-shrink: 0;
+}
+
+.hospital-page__filter-tag--active {
+  background: var(--primary, #C88EA8);
+  border-color: var(--primary, #C88EA8);
+}
+
+.hospital-page__filter-tag-text {
+  font-size: 26rpx;
+  color: var(--text-secondary, #A098A0);
+  font-weight: 500;
+}
+
+.hospital-page__filter-tag--active .hospital-page__filter-tag-text {
+  color: var(--text-inverse, #1A1418);
+  font-weight: 600;
+}
+
+.hospital-page__disclaimer {
+  padding: 16rpx 24rpx;
+  background: var(--bg-card, #2A1E24);
+}
+
+.hospital-page__disclaimer-text {
+  display: block;
+  font-size: 22rpx;
+  color: var(--text-tertiary, #786870);
+  line-height: 1.5;
+}
+
+.hospital-page__empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 160rpx 48rpx;
+  animation: fadeInScale 0.4s ease-out;
+}
+
+.hospital-page__empty-icon {
+  font-size: 96rpx;
+  margin-bottom: 24rpx;
+}
+
+.hospital-page__empty-text {
+  font-size: 30rpx;
+  color: var(--text-tertiary, #786870);
+  font-weight: 500;
+  margin-bottom: 12rpx;
+}
+
+.hospital-page__empty-hint {
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+  text-align: center;
+}
+
+.hospital-page__list {
+  display: flex;
+  flex-direction: column;
+  gap: 20rpx;
+  padding: 24rpx;
+}
+
+.hospital-page__card {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  padding: 32rpx;
+  transition: all 0.25s ease;
+  animation: cardStaggerIn 0.4s ease-out both;
+}
+
+.hospital-page__card:active {
+  transform: scale(0.98);
+  opacity: 0.9;
+}
+
+.hospital-page__card-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  margin-bottom: 20rpx;
+}
+
+.hospital-page__card-title-wrap {
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
+  flex: 1;
+  min-width: 0;
+}
+
+.hospital-page__card-name {
+  font-size: 30rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  flex: 1;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.hospital-page__card-type {
+  padding: 4rpx 16rpx;
+  border-radius: 16rpx;
+  flex-shrink: 0;
+}
+
+.hospital-page__card-type-text {
+  font-size: 22rpx;
+  font-weight: 600;
+}
+
+.hospital-page__card-rating {
+  display: flex;
+  align-items: center;
+  gap: 8rpx;
+  flex-shrink: 0;
+  margin-left: 16rpx;
+}
+
+.hospital-page__card-stars {
+  font-size: 24rpx;
+  color: var(--primary, #C88EA8);
+  letter-spacing: 2rpx;
+}
+
+.hospital-page__card-rating-text {
+  font-size: 26rpx;
+  color: var(--primary, #C88EA8);
+  font-weight: 700;
+}
+
+.hospital-page__card-info {
+  display: flex;
+  flex-direction: column;
+  gap: 12rpx;
+  margin-bottom: 20rpx;
+}
+
+.hospital-page__card-info-item {
+  display: flex;
+  align-items: flex-start;
+  gap: 12rpx;
+}
+
+.hospital-page__card-info-icon {
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+  flex-shrink: 0;
+  margin-top: 2rpx;
+}
+
+.hospital-page__card-info-text {
+  font-size: 26rpx;
+  color: var(--text-secondary, #A098A0);
+  line-height: 1.5;
+  flex: 1;
+}
+
+.hospital-page__card-services {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12rpx;
+  margin-bottom: 24rpx;
+}
+
+.hospital-page__card-service-tag {
+  padding: 8rpx 20rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border-radius: 20rpx;
+}
+
+.hospital-page__card-service-tag--more {
+  background: rgba(var(--primary, #C88EA8), 0.1);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.hospital-page__card-service-tag-text {
+  font-size: 22rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.hospital-page__card-service-tag--more .hospital-page__card-service-tag-text {
+  color: var(--primary, #C88EA8);
+  font-weight: 600;
+}
+
+.hospital-page__card-detail {
+  padding: 20rpx 0;
+  border-top: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+  margin-bottom: 20rpx;
+}
+
+.hospital-page__card-detail-section {
+  margin-bottom: 16rpx;
+}
+
+.hospital-page__card-detail-section:last-child {
+  margin-bottom: 0;
+}
+
+.hospital-page__card-detail-label {
+  display: block;
+  font-size: 24rpx;
+  color: var(--text-tertiary, #786870);
+  margin-bottom: 12rpx;
+}
+
+.hospital-page__card-detail-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 12rpx;
+}
+
+.hospital-page__card-detail-tag {
+  font-size: 22rpx;
+  padding: 8rpx 20rpx;
+  background: rgba(var(--primary, #C88EA8), 0.1);
+  color: var(--primary-light, #E8C8D8);
+  border-radius: 20rpx;
+}
+
+.hospital-page__card-actions {
+  display: flex;
+  gap: 16rpx;
+  padding-top: 20rpx;
+  border-top: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+}
+
+.hospital-page__card-btn {
+  flex: 1;
+  height: 80rpx;
+  border-radius: 40rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8rpx;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.hospital-page__card-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.hospital-page__card-btn--call {
+  background: rgba(var(--success, #8EA898), 0.1);
+  border: 1rpx solid rgba(var(--success, #8EA898), 0.3);
+}
+
+.hospital-page__card-btn--nav {
+  background: rgba(var(--primary, #C88EA8), 0.1);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.hospital-page__card-btn-icon {
+  font-size: 28rpx;
+}
+
+.hospital-page__card-btn-text {
+  font-size: 28rpx;
+  font-weight: 600;
+}
+
+.hospital-page__card-btn--call .hospital-page__card-btn-text {
+  color: var(--success, #8EA898);
+}
+
+.hospital-page__card-btn--nav .hospital-page__card-btn-text {
+  color: var(--primary, #C88EA8);
+}
