+  animation: pet-avatar-pulse 1.5s ease-in-out infinite;
+}
+
+.pet-avatar__image--shake {
+  animation: pet-avatar-shake 0.8s ease-in-out infinite;
+}
+
+.pet-avatar__image--flash {
+  animation: pet-avatar-flash 1s ease-in-out infinite;
+}
+
+.pet-avatar__image--float {
+  animation: pet-avatar-float 2s ease-in-out infinite;
+}
+
