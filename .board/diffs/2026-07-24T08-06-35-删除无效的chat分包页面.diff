+}
+
+.feeding-meal-active {
+  background: var(--primary, #C88EA8);
+  color: var(--text-inverse, #1A1418);
+  border-color: var(--primary, #C88EA8);
+}
+
+.feeding-form-rating {
+  display: flex;
+  gap: 12rpx;
+}
+
+.feeding-rating-option {
+  flex: 1;
+  text-align: center;
+  padding: 10rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 8rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  transition: all 0.15s ease;
+  color: var(--text-secondary, #A098A0);
+}
+
+.feeding-rating-active {
+  background: var(--primary, #C88EA8);
+  color: var(--text-inverse, #1A1418);
+  border-color: var(--primary, #C88EA8);
+}
+
+.feeding-rating-emoji {
+  font-size: 20rpx;
+  display: block;
+  margin-bottom: 4rpx;
+}
+
+.feeding-rating-label {
+  font-size: 12rpx;
+}
+
+.feeding-form-textarea {
+  width: 100%;
+  height: 80rpx;
+  padding: 8rpx 12rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 8rpx;
+  font-size: 14rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  color: var(--text-primary, #E8D8DE);
+  box-sizing: border-box;
+}
+
+.feeding-modal-footer {
+  display: flex;
+  gap: 12rpx;
+  padding: 16rpx 20rpx;
+  border-top: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+}
+
+.feeding-modal-btn {
+  flex: 1;
+  text-align: center;
+  padding: 12rpx;
+  border-radius: 8rpx;
+  font-size: 16rpx;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.feeding-modal-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.feeding-modal-btn-cancel {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  color: var(--text-secondary, #A098A0);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+}
+
+.feeding-modal-btn-confirm {
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  color: var(--text-inverse, #1A1418);
+}
+
+.feeding-empty {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 100vh;
+}
+
+.feeding-empty-text {
+  font-size: 16rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.feeding-bottom-safe {
+  height: 40rpx;
+}
