+    transform: scale(0);
+    opacity: 0.6;
+  }
+  100% {
+    transform: scale(4);
+    opacity: 0;
+  }
+}
+.mine-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  animation: pageEnter 0.4s ease-out;
+}
+
+.mine-header {
+  padding: 40rpx 32rpx 24rpx;
+}
+
+.mine-user-card {
+  display: flex;
+  align-items: center;
+  gap: 24rpx;
+  padding: 28rpx;
+  background: var(--gradient-card, linear-gradient(135deg, rgba(200, 142, 168, 0.12), rgba(200, 142, 168, 0.04)));
+  border-radius: 20rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  animation: fadeInUp 0.45s ease-out;
+  animation: warmBreathe 3s ease-in-out infinite;
+}
+
+.mine-avatar {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 120rpx;
+  height: 120rpx;
+  border-radius: 999rpx;
+  background: var(--gradient-warm, linear-gradient(135deg, #C88EA8, #D8A8B8, #E8C8D8));
+  box-shadow: 0 0 24rpx rgba(var(--primary, #C88EA8), 0.3);
+  flex-shrink: 0;
+}
+
+.mine-avatar-text {
+  font-size: 48rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 700;
+}
+
+.mine-user-info {
+  flex: 1;
+  min-width: 0;
+}
+
+.mine-user-name-row {
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
+  margin-bottom: 8rpx;
+}
+
+.mine-user-name {
+  font-size: 34rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+}
+
+.mine-vip-badge {
+  padding: 4rpx 14rpx;
+  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
+  border-radius: 16rpx;
+  font-size: 20rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 700;
+  box-shadow: 0 2rpx 8rpx rgba(var(--primary, #C88EA8), 0.3);
+}
+
+.mine-user-desc {
+  font-size: 24rpx;
+  color: var(--text-hint, #988898);
+}
+
+.mine-edit-btn {
+  padding: 12rpx 28rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 40rpx;
+  font-size: 24rpx;
+  color: var(--primary-light, #E8C8D8);
+  align-self: flex-start;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.mine-edit-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.mine-pet-chips {
+  padding: 0 32rpx 16rpx;
+}
+
+.mine-pet-chips-scroll {
+  white-space: nowrap;
+}
+
+.mine-pet-chip {
+  display: inline-flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 8rpx;
+  padding: 16rpx 24rpx;
+  border-radius: 40rpx;
+  background: var(--bg-card, #2A1E24);
+  border: 1rpx solid var(--border-light, rgba(200, 142, 168, 0.08));
+  margin-right: 16rpx;
+  white-space: normal;
+  position: relative;
+  transition: all 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
+}
+.mine-pet-chip--active {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border-color: var(--primary, #C88EA8);
+  box-shadow: 0 0 20rpx rgba(var(--primary, #C88EA8), 0.15);
+  animation: warmBreathe 3s ease-in-out infinite;
+}
+.mine-pet-chip--add {
+  border-style: dashed;
+  border-color: var(--text-tertiary, #786870);
+  opacity: 0.6;
+}
+.mine-pet-chip:active {
+  transform: scale(0.94);
+  opacity: 0.8;
+}
+
+.mine-pet-chip-avatar {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 60rpx;
+  height: 60rpx;
+  border-radius: 999rpx;
+  background: var(--gradient-card, linear-gradient(135deg, rgba(200, 142, 168, 0.12), rgba(200, 142, 168, 0.04)));
+  font-size: 30rpx;
+}
+
+.mine-pet-chip-name {
+  font-size: 20rpx;
+  color: var(--text-secondary, #A098A0);
+  font-weight: 500;
+}
+
+.mine-pet-chip-check {
+  position: absolute;
+  top: -4rpx;
+  right: -4rpx;
+  width: 32rpx;
+  height: 32rpx;
+  border-radius: 999rpx;
+  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 18rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 700;
+  box-shadow: 0 2rpx 8rpx rgba(var(--primary, #C88EA8), 0.4);
+}
+
+.mine-pet-chip-add-icon {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 60rpx;
+  height: 60rpx;
+  border-radius: 999rpx;
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border: 2rpx dashed var(--text-tertiary, #786870);
+  font-size: 32rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.mine-stats {
+  display: flex;
+  margin: 0 32rpx 16rpx;
+  padding: 28rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  animation: fadeInUp 0.45s ease-out 0.05s both;
+}
+
+.section-divider {
+  height: 1rpx;
+  margin: 8rpx 32rpx 16rpx;
+  background: linear-gradient(90deg, transparent, rgba(var(--primary, #C88EA8), 0.15), transparent);
+}
+
+.mine-stat-item {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 6rpx;
+  position: relative;
+}
+.mine-stat-item:not(:last-child)::after {
+  content: "";
+  position: absolute;
+  right: 0;
+  top: 20%;
+  height: 60%;
+  width: 1rpx;
+  background: linear-gradient(180deg, transparent, rgba(var(--primary, #C88EA8), 0.15), transparent);
+}
+
+.mine-stat-num {
+  font-size: 40rpx;
+  font-weight: 700;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-light, #E8C8D8));
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+}
+
+.mine-stat-label {
+  font-size: 20rpx;
+  color: var(--text-hint, #988898);
+}
+
+.mine-vip-banner {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin: 0 32rpx 16rpx;
+  padding: 24rpx 28rpx;
+  background: var(--gradient-card, linear-gradient(135deg, rgba(200, 142, 168, 0.12), rgba(200, 142, 168, 0.04)));
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 20rpx;
+  animation: warmBreathe 3s ease-in-out infinite;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.mine-vip-banner:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.mine-vip-banner-left {
+  display: flex;
+  align-items: center;
+  gap: 16rpx;
+}
+
+.mine-vip-banner-icon {
+  font-size: 44rpx;
+  animation: pulse 2.5s ease-in-out infinite;
+}
+
+.mine-vip-banner-title {
+  font-size: 28rpx;
+  font-weight: 700;
+  color: var(--primary-light, #E8C8D8);
+  display: block;
+}
+
+.mine-vip-banner-desc {
+  font-size: 20rpx;
+  color: var(--text-hint, #988898);
+  margin-top: 4rpx;
+  display: block;
+}
+
+.mine-vip-banner-arrow {
+  font-size: 36rpx;
+  color: var(--primary, #C88EA8);
+  font-weight: 700;
+}
+
+.mine-menu-group {
+  margin: 0 32rpx 16rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  overflow: hidden;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  animation: fadeInUp 0.45s ease-out 0.1s both;
+}
+
+.mine-menu-item {
+  display: flex;
+  align-items: center;
+  padding: 28rpx 24rpx;
+  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+  transition: all 0.15s ease;
+}
+.mine-menu-item:last-child {
+  border-bottom: none;
+}
+.mine-menu-item:active {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+}
+
+.mine-menu-icon {
+  font-size: 36rpx;
+  margin-right: 16rpx;
+  width: 40rpx;
+  text-align: center;
+}
+
+.mine-menu-label {
+  flex: 1;
+  font-size: 28rpx;
+  color: var(--text-primary, #E8D8DE);
+}
+
+.mine-menu-arrow {
+  font-size: 32rpx;
+  color: var(--text-tertiary, #786870);
+  transition: transform 0.2s ease;
+}
+
+.mine-menu-item:active .mine-menu-arrow {
+  transform: translateX(4rpx);
+}
+
+.mine-section {
+  margin: 24rpx 32rpx;
+}
+
+.mine-logout-btn {
+  height: 88rpx;
+  line-height: 88rpx;
+  text-align: center;
+  background: var(--bg-card, #2A1E24);
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 20rpx;
+  font-size: 28rpx;
+  color: var(--coral, #D0A098);
+  opacity: 0.7;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.mine-logout-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+
+.mine-bottom-safe {
+  height: 60rpx;
+}
