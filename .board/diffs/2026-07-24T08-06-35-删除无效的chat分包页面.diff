+.invite-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  padding: 32rpx;
+  animation: pageEnter 0.4s ease-out;
+  position: relative;
+  overflow: hidden;
+}
+.invite-page::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  right: -40rpx;
+  width: 200rpx;
+  height: 200rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.06) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 5s ease-in-out infinite;
+}
+.invite-page__header {
+  text-align: center;
+  padding: 40rpx 0 32rpx;
+  position: relative;
+  z-index: 1;
+}
+.invite-page__title {
+  font-size: 40rpx;
+  font-weight: bold;
+  color: var(--text-primary, #E8D8DE);
+  display: block;
+  margin-bottom: 12rpx;
+  animation: fadeInUp 0.4s ease-out both;
+}
+.invite-page__subtitle {
+  font-size: 26rpx;
+  color: var(--text-secondary, #A098A0);
+  display: block;
+  animation: fadeInUp 0.4s ease-out 0.1s both;
+}
+.invite-page__code-section {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 40rpx 32rpx;
+  text-align: center;
+  margin-bottom: 32rpx;
+  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
+  position: relative;
+  z-index: 1;
+  animation: cardStaggerIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s both;
+}
+.invite-page__code-label {
+  font-size: 26rpx;
+  color: var(--text-tertiary, #786870);
+  display: block;
+  margin-bottom: 16rpx;
+}
+.invite-page__code-box {
+  background: var(--primary-bg, rgba(200, 142, 168, 0.08));
+  border: 2rpx dashed var(--primary, #C88EA8);
+  border-radius: 16rpx;
+  padding: 24rpx;
+  margin-bottom: 24rpx;
+}
+.invite-page__code-text {
+  font-size: 48rpx;
+  font-weight: bold;
+  color: var(--primary, #C88EA8);
+  letter-spacing: 8rpx;
+}
+.invite-page__copy-btn {
+  background: var(--primary, #C88EA8) !important;
+  color: var(--text-inverse, #1A1418) !important;
+  border-radius: 40rpx !important;
+  font-size: 28rpx !important;
+  width: 300rpx !important;
+  height: 80rpx !important;
+  line-height: 80rpx !important;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.invite-page__copy-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.invite-page__stats {
+  display: flex;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 32rpx;
+  margin-bottom: 32rpx;
+  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
+  position: relative;
+  z-index: 1;
+  animation: cardStaggerIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.2s both;
+}
+.invite-page__stat-item {
+  flex: 1;
+  text-align: center;
+}
+.invite-page__stat-value {
+  font-size: 40rpx;
+  font-weight: bold;
+  color: var(--primary, #C88EA8);
+  display: block;
+  margin-bottom: 8rpx;
+}
+.invite-page__stat-label {
+  font-size: 22rpx;
+  color: var(--text-tertiary, #786870);
+  display: block;
+}
+.invite-page__actions {
+  display: flex;
+  gap: 16rpx;
+  margin-bottom: 32rpx;
+  position: relative;
+  z-index: 1;
+  animation: fadeInUp 0.4s ease-out 0.25s both;
+}
+.invite-page__share-btn {
+  flex: 1;
+  background: var(--success, #8EA898) !important;
+  color: var(--text-inverse, #1A1418) !important;
+  border-radius: 40rpx !important;
+  font-size: 28rpx !important;
+  height: 88rpx !important;
+  line-height: 88rpx !important;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.invite-page__share-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.invite-page__timeline-btn {
+  flex: 1;
+  background: var(--primary, #C88EA8) !important;
+  color: var(--text-inverse, #1A1418) !important;
+  border-radius: 40rpx !important;
+  font-size: 28rpx !important;
+  height: 88rpx !important;
+  line-height: 88rpx !important;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.invite-page__timeline-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.invite-page__reward {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  border-radius: 24rpx;
+  padding: 32rpx;
+  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
+  position: relative;
+  z-index: 1;
+  animation: cardStaggerIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) 0.3s both;
+}
+.invite-page__reward-title {
+  font-size: 30rpx;
+  font-weight: bold;
+  color: var(--text-primary, #E8D8DE);
+  display: block;
+  margin-bottom: 12rpx;
+}
+.invite-page__reward-desc {
+  font-size: 24rpx;
+  color: var(--text-secondary, #A098A0);
+  display: block;
+  margin-bottom: 20rpx;
+}
+.invite-page__reward-btn {
+  background: var(--primary-light, #E8C8D8) !important;
+  color: var(--text-inverse, #1A1418) !important;
+  border-radius: 40rpx !important;
+  font-size: 26rpx !important;
+  width: 240rpx !important;
+  height: 72rpx !important;
+  line-height: 72rpx !important;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.invite-page__reward-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.invite-page__reward-result {
+  font-size: 24rpx;
+  color: var(--primary, #C88EA8);
+  display: block;
+  margin-top: 16rpx;
+  text-align: center;
+}
