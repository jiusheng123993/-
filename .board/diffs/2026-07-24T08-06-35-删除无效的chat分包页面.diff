+  justify-content: center;
+  transition: all 0.25s ease;
+}
+
+.pet-symptom-check__btn:active {
+  transform: scale(0.98);
+}
+
+.pet-symptom-check__btn--primary {
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  box-shadow: 0 8rpx 32rpx rgba(var(--primary, #C88EA8), 0.3);
+}
+
+.pet-symptom-check__btn--primary:active {
+  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.2);
+}
+
+.pet-symptom-check__btn--hospital {
+  background: var(--danger, #C87070);
+  box-shadow: 0 8rpx 32rpx rgba(224, 133, 107, 0.3);
+}
+
+.pet-symptom-check__btn--hospital:active {
+  box-shadow: 0 4rpx 16rpx rgba(224, 133, 107, 0.2);
+}
+
+.pet-symptom-check__btn--outline {
+  background: transparent;
+  border: 2rpx solid var(--primary, #C88EA8);
+}
+
+.pet-symptom-check__btn--disabled {
+  opacity: 0.4;
+  box-shadow: none;
+}
+
+.pet-symptom-check__btn-text {
+  font-size: 32rpx;
+  font-weight: 700;
+  color: var(--primary, #C88EA8);
+}
+
+.pet-symptom-check__btn-text--white {
+  color: #FFFFFF;
+}
