+.pet-trends-page {
+  min-height: 100vh;
+  background-color: var(--bg-page, #1A1418);
+  padding-bottom: 160rpx;
+}
+
+.pet-trends__time-range {
+  display: flex;
+  justify-content: center;
+  gap: 16rpx;
+  padding: 20rpx 32rpx;
+}
+
+.pet-trends__time-btn {
+  padding: 12rpx 32rpx;
+  border-radius: 32rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  transition: all 0.25s ease;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.pet-trends__time-btn:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.pet-trends__time-btn--active {
+  background: rgba(var(--primary, #C88EA8), 0.08);
+  border-color: var(--primary, #C88EA8);
+}
+.pet-trends__time-btn--active .pet-trends__time-btn-text {
+  color: var(--primary, #C88EA8);
+  font-weight: 600;
+}
+
+.pet-trends__time-btn-text {
+  font-size: 24rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.pet-trends__tabs {
+  display: flex;
+  margin: 0 32rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  padding: 8rpx;
+}
+
+.pet-trends__tab {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 16rpx 0;
+  border-radius: 28rpx;
+  transition: all 0.25s ease;
+}
+.pet-trends__tab--active {
+  background: rgba(var(--primary, #C88EA8), 0.08);
+}
+.pet-trends__tab--active .pet-trends__tab-text {
+  color: var(--primary, #C88EA8);
+  font-weight: 600;
+}
+
+.pet-trends__tab-text {
+  font-size: 28rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.pet-trends__content {
+  flex: 1;
+  padding: 20rpx 32rpx;
+}
+
+.pet-trends__chart-area {
+  display: flex;
+  flex-direction: column;
+  gap: 24rpx;
+}
+
+.trend-card {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  padding: 32rpx;
+  animation: cardStaggerIn 0.4s ease-out both;
+}
+
+.trend-card__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 24rpx;
+}
+
+.trend-card__title {
+  font-size: 32rpx;
+  font-weight: 600;
+  color: var(--text-primary, #E8D8DE);
+}
+
+.trend-card__period {
+  font-size: 20rpx;
+  color: var(--text-tertiary, #786870);
+}
+
+.trend-card__badge {
+  font-size: 20rpx;
+  color: #FFFFFF;
+  background-color: var(--danger, #C87070);
+  padding: 4rpx 16rpx;
+  border-radius: 16rpx;
+}
+
+.trend-chart__container {
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  padding: 32rpx;
+}
+
+.trend-chart__breed-range-header {
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
+  margin-bottom: 20rpx;
+  padding: 16rpx 20rpx;
+  background: rgba(140, 173, 126, 0.08);
+  border-radius: 16rpx;
+  border: 2rpx solid rgba(140, 173, 126, 0.2);
+}
+
+.trend-chart__breed-range-label {
+  font-size: 20rpx;
+  color: var(--success, #8EA898);
+  font-weight: 500;
+}
+
+.trend-chart__breed-range-value {
+  font-size: 20rpx;
+  color: var(--success, #8EA898);
+  font-weight: 600;
+}
+.trend-chart__breed-range-value--warning {
+  color: var(--danger, #C87070);
+}
+
+.trend-chart__breed-range-warning {
+  font-size: 22rpx;
+  color: var(--danger, #C87070);
+  font-weight: 600;
+  margin-left: auto;
+  padding: 4rpx 16rpx;
+  background: var(--danger-bg, rgba(200, 112, 112, 0.2));
+  border-radius: 12rpx;
+  border: 1rpx solid rgba(224, 133, 107, 0.3);
+}
+
+/* 品种体重分析卡片 */
+.trend-chart__breed-analysis {
+  margin-bottom: 20rpx;
+  padding: 20rpx;
+  border-radius: 20rpx;
+  border: 2rpx solid;
+}
+.trend-chart__breed-analysis--normal {
+  background: rgba(140, 173, 126, 0.08);
+  border-color: rgba(140, 173, 126, 0.2);
+}
+.trend-chart__breed-analysis--underweight {
+  background: rgba(var(--primary, #C88EA8), 0.06);
+  border-color: rgba(var(--primary, #C88EA8), 0.2);
+}
