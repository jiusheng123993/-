+  margin-right: 16rpx;
+  transition: all $transition-fast;
+  white-space: normal;
+  position: relative;
+
+  &--active {
+    background: rgba($color-primary, 0.08);
+    border-color: $color-primary;
+  }
+
+  &--add {
+    border-style: dashed;
+    border-color: $color-border;
+  }
+
+  &:active {
+    transform: scale(0.96);
+    opacity: 0.85;
+  }
+}
+
