+            <div class="tl-file">src/app.tsx, package.json</div>
+            <div class="tl-actions"><span class="tl-view-diff" onclick="openDiff('2026-07-23T13-52-18-修复-React-error--321.diff', '修复 React error #321')">&#128269; 查看改动</span></div>
+          </div>
