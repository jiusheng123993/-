+/**
+ * 将长文本按指定宽度拆分为多行
+ * 中文按字符数计算，英文按单词边界计算
+ */
+function wrapText(text: string, maxCharsPerLine: number): string[] {
+  const lines: string[] = [];
+  let current = '';
+  for (const ch of text) {
+    if (ch === '\n') {
+      lines.push(current);
+      current = '';
+    } else if (current.length >= maxCharsPerLine) {
+      lines.push(current);
+      current = ch;
+    } else {
+      current += ch;
+    }
+  }
+  if (current) lines.push(current);
+  return lines.length > 0 ? lines : [''];
+}
