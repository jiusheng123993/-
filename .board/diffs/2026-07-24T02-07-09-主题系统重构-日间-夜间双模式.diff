+
+    res.json({
+      success: true,
+      data: {
+        task,
+        model,
+      },
+    });
+  } catch (error) {
+    console.error('[Avatar model/:petId] Error:', error);
+    res.status(500).json({ success: false, message: '查询模型失败，请稍后重试' });
   }
 });
 
