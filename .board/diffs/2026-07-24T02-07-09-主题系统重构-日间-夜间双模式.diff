+"use strict";(wx["webpackJsonp"]=wx["webpackJsonp"]||[]).push([[4505],{9806:function(p,e,t){var n=t(2180),l=t(9439),i=t(1515),r=t(2954),s=t.n(r),a=t(7294),o=t(8537),g=t(3328),h=t(5893),u={user:{title:"\u7528\u6237\u534f\u8bae",content:'<h3>\u4e00\u3001\u670d\u52a1\u6761\u6b3e</h3><p>\u661f\u5bf0\u6d77\uff08\u4ee5\u4e0b\u7b80\u79f0"\u672c\u5e94\u7528"\uff09\u662f\u4e00\u6b3e\u5ba0\u7269\u5065\u5eb7\u7ba1\u7406\u5de5\u5177\uff0c\u4e3a\u7528\u6237\u63d0\u4f9b\u5ba0\u7269\u5065\u5eb7\u6253\u5361\u3001\u98df\u7269\u5b89\u5168\u67e5\u8be2\u3001\u75c7\u72b6\u521d\u7b5b\u3001\u75ab\u82d7\u7ba1\u7406\u3001\u4f1a\u5458\u8ba2\u9605\u7b49\u670d\u52a1\u3002\u672c\u534f\u8bae\u662f\u60a8\u4e0e\u661f\u5bf0\u6d77\u4e4b\u95f4\u5173\u4e8e\u4f7f\u7528\u672c\u5e94\u7528\u6240\u8ba2\u7acb\u7684\u534f\u8bae\u3002\u8bf7\u60a8\u4ed4\u7ec6\u9605\u8bfb\u672c\u534f\u8bae\uff0c\u5728\u786e\u8ba4\u5145\u5206\u7406\u89e3\u5e76\u540c\u610f\u540e\u518d\u5f00\u59cb\u4f7f\u7528\u3002\u82e5\u60a8\u4e0d\u540c\u610f\u672c\u534f\u8bae\u7684\u4efb\u4f55\u5185\u5bb9\uff0c\u8bf7\u505c\u6b62\u4f7f\u7528\u672c\u5e94\u7528\u3002</p><h3>\u4e8c\u3001\u7528\u6237\u8d23\u4efb</h3><p>1. \u7528\u6237\u5e94\u786e\u4fdd\u63d0\u4f9b\u7684\u5ba0\u7269\u4fe1\u606f\u771f\u5b9e\u51c6\u786e\uff0c\u56e0\u4fe1\u606f\u4e0d\u5b9e\u5bfc\u81f4\u7684\u5065\u5eb7\u5efa\u8bae\u504f\u5dee\u7531\u7528\u6237\u81ea\u884c\u627f\u62c5\u3002</p><p>2. \u672c\u5e94\u7528\u63d0\u4f9b\u7684\u5065\u5eb7\u5efa\u8bae\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u66ff\u4ee3\u4e13\u4e1a\u517d\u533b\u8bca\u65ad\u3002\u5f53\u5ba0\u7269\u51fa\u73b0\u5065\u5eb7\u5f02\u5e38\u65f6\uff0c\u8bf7\u53ca\u65f6\u5c31\u533b\u3002</p><p>3. \u7528\u6237\u5e94\u9075\u5b88\u76f8\u5173\u6cd5\u5f8b\u6cd5\u89c4\uff0c\u4e0d\u5f97\u5229\u7528\u672c\u5e94\u7528\u4ece\u4e8b\u8fdd\u6cd5\u6d3b\u52a8\u3002</p><p>4. \u7528\u6237\u5e94\u59a5\u5584\u4fdd\u7ba1\u8d26\u53f7\u4fe1\u606f\uff0c\u56e0\u8d26\u53f7\u4fdd\u7ba1\u4e0d\u5584\u5bfc\u81f4\u7684\u635f\u5931\u7531\u7528\u6237\u81ea\u884c\u627f\u62c5\u3002</p><p>5. \u7528\u6237\u4e0d\u5f97\u5bf9\u672c\u5e94\u7528\u8fdb\u884c\u53cd\u7f16\u8bd1\u3001\u53cd\u6c47\u7f16\u3001\u4fee\u6539\u3001\u6216\u521b\u5efa\u884d\u751f\u4f5c\u54c1\u3002</p><h3>\u4e09\u3001\u514d\u8d23\u58f0\u660e</h3><p>1. \u672c\u5e94\u7528\u7684\u75c7\u72b6\u521d\u7b5b\u529f\u80fd\u57fa\u4e8e\u89c4\u5219\u5f15\u64ce\uff0c\u4ec5\u4f9b\u53c2\u8003\uff0c\u4e0d\u6784\u6210\u533b\u7597\u8bca\u65ad\u3002</p><p>2. \u98df\u7269\u5b89\u5168\u6570\u636e\u6765\u6e90\u4e8e\u516c\u5f00\u8d44\u6599\uff0c\u53ef\u80fd\u5b58\u5728\u66f4\u65b0\u4e0d\u53ca\u65f6\u7684\u60c5\u51b5\uff0c\u5efa\u8bae\u4ee5\u4e13\u4e1a\u517d\u533b\u610f\u89c1\u4e3a\u51c6\u3002</p><p>3. \u56e0\u7528\u6237\u81ea\u8eab\u539f\u56e0\u5bfc\u81f4\u7684\u5ba0\u7269\u5065\u5eb7\u95ee\u9898\uff0c\u672c\u5e94\u7528\u4e0d\u627f\u62c5\u8d23\u4efb\u3002</p><p>4. \u56e0\u4e0d\u53ef\u6297\u529b\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u81ea\u7136\u707e\u5bb3\u3001\u653f\u7b56\u53d8\u5316\u3001\u7f51\u7edc\u6545\u969c\uff09\u5bfc\u81f4\u7684\u670d\u52a1\u4e2d\u65ad\uff0c\u672c\u5e94\u7528\u4e0d\u627f\u62c5\u8d23\u4efb\u3002</p><p>5. \u672c\u5e94\u7528\u4e0d\u5bf9\u7528\u6237\u4e4b\u95f4\u7684\u7ea0\u7eb7\u627f\u62c5\u4efb\u4f55\u8d23\u4efb\u3002</p><h3>\u56db\u3001\u4f1a\u5458\u670d\u52a1\u4e0e\u4ed8\u8d39</h3><p>1. \u672c\u5e94\u7528\u63d0\u4f9b\u4f1a\u5458\u8ba2\u9605\u670d\u52a1\uff0c\u901a\u8fc7\u5fae\u4fe1\u652f\u4ed8\u5b8c\u6210\u4ed8\u8d39\u3002</p><p>2. \u4f1a\u5458\u670d\u52a1\u6309\u8ba2\u9605\u5468\u671f\u6536\u8d39\uff0c\u5230\u671f\u540e\u81ea\u52a8\u7eed\u8d39\uff0c\u7528\u6237\u53ef\u968f\u65f6\u5728\u5fae\u4fe1\u652f\u4ed8\u7ba1\u7406\u4e2d\u5173\u95ed\u81ea\u52a8\u7eed\u8d39\u3002</p><p>3. \u4f1a\u5458\u670d\u52a1\u4e00\u7ecf\u5f00\u901a\uff0c\u975e\u672c\u5e94\u7528\u539f\u56e0\u4e0d\u4e88\u9000\u6b3e\u3002</p><p>4. \u672c\u5e94\u7528\u4fdd\u7559\u8c03\u6574\u4f1a\u5458\u4ef7\u683c\u7684\u6743\u5229\uff0c\u8c03\u6574\u524d\u5c06\u5728\u5e94\u7528\u5185\u516c\u793a\u3002</p><h3>\u4e94\u3001\u77e5\u8bc6\u4ea7\u6743</h3><p>1. \u672c\u5e94\u7528\u7684\u6240\u6709\u5185\u5bb9\uff08\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u6587\u5b57\u3001\u56fe\u7247\u3001\u56fe\u6807\u3001\u754c\u9762\u8bbe\u8ba1\u3001\u4ee3\u7801\u3001\u6570\u636e\u7ed3\u6784\uff09\u5747\u53d7\u77e5\u8bc6\u4ea7\u6743\u6cd5\u5f8b\u4fdd\u62a4\uff0c\u5f52\u661f\u5bf0\u6d77\u6240\u6709\u3002</p><p>2. \u672a\u7ecf\u661f\u5bf0\u6d77\u4e66\u9762\u8bb8\u53ef\uff0c\u7528\u6237\u4e0d\u5f97\u590d\u5236\u3001\u4f20\u64ad\u3001\u5c55\u793a\u3001\u4fee\u6539\u672c\u5e94\u7528\u7684\u4efb\u4f55\u5185\u5bb9\u3002</p><p>3. \u7528\u6237\u5728\u672c\u5e94\u7528\u4e2d\u521b\u5efa\u7684\u5ba0\u7269\u6570\u636e\u548c\u5065\u5eb7\u8bb0\u5f55\uff0c\u5176\u77e5\u8bc6\u4ea7\u6743\u5f52\u7528\u6237\u6240\u6709\uff0c\u661f\u5bf0\u6d77\u4ec5\u5728\u672c\u534f\u8bae\u8303\u56f4\u5185\u4f7f\u7528\u3002</p><h3>\u516d\u3001\u670d\u52a1\u53d8\u66f4\u4e0e\u7ec8\u6b62</h3><p>1. \u661f\u5bf0\u6d77\u6709\u6743\u6839\u636e\u4e1a\u52a1\u53d1\u5c55\u9700\u8981\u4fee\u6539\u3001\u6682\u505c\u6216\u7ec8\u6b62\u90e8\u5206\u6216\u5168\u90e8\u670d\u52a1\uff0c\u5e76\u5c06\u63d0\u524d\u5728\u5e94\u7528\u5185\u516c\u544a\u3002</p><p>2. \u7528\u6237\u53ef\u968f\u65f6\u505c\u6b62\u4f7f\u7528\u672c\u5e94\u7528\u5e76\u6ce8\u9500\u8d26\u53f7\uff0c\u6ce8\u9500\u540e\u661f\u5bf0\u6d77\u5c06\u4f9d\u6cd5\u5220\u9664\u7528\u6237\u4e2a\u4eba\u4fe1\u606f\u3002</p><p>3. \u5982\u7528\u6237\u8fdd\u53cd\u672c\u534f\u8bae\u7ea6\u5b9a\uff0c\u661f\u5bf0\u6d77\u6709\u6743\u6682\u505c\u6216\u7ec8\u6b62\u5411\u8be5\u7528\u6237\u63d0\u4f9b\u670d\u52a1\u3002</p><p>4. \u670d\u52a1\u7ec8\u6b62\u540e\uff0c\u661f\u5bf0\u6d77\u65e0\u4e49\u52a1\u4e3a\u7528\u6237\u4fdd\u7559\u8d26\u53f7\u4e2d\u7684\u4efb\u4f55\u6570\u636e\uff0c\u4f46\u6cd5\u5f8b\u6cd5\u89c4\u53e6\u6709\u89c4\u5b9a\u7684\u9664\u5916\u3002</p><h3>\u4e03\u3001\u9690\u79c1\u4fdd\u62a4</h3><p>\u6211\u4eec\u91cd\u89c6\u7528\u6237\u9690\u79c1\u4fdd\u62a4\uff0c\u5177\u4f53\u9690\u79c1\u653f\u7b56\u8bf7\u53c2\u9605\u300a\u9690\u79c1\u653f\u7b56\u300b\u3002</p><h3>\u516b\u3001\u4e89\u8bae\u89e3\u51b3</h3><p>1. \u672c\u534f\u8bae\u7684\u8ba2\u7acb\u3001\u6267\u884c\u548c\u89e3\u91ca\u5747\u9002\u7528\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u6cd5\u5f8b\u3002</p><p>2. \u56e0\u672c\u534f\u8bae\u5f15\u8d77\u7684\u6216\u4e0e\u672c\u534f\u8bae\u6709\u5173\u7684\u4efb\u4f55\u4e89\u8bae\uff0c\u53cc\u65b9\u5e94\u9996\u5148\u901a\u8fc7\u53cb\u597d\u534f\u5546\u89e3\u51b3\u3002</p><p>3. \u534f\u5546\u4e0d\u6210\u7684\uff0c\u4efb\u4f55\u4e00\u65b9\u5747\u53ef\u5411\u661f\u5bf0\u6d77\u6240\u5728\u5730\u6709\u7ba1\u8f96\u6743\u7684\u4eba\u6c11\u6cd5\u9662\u63d0\u8d77\u8bc9\u8bbc\u3002</p><h3>\u4e5d\u3001\u5176\u4ed6</h3><p>1. \u672c\u534f\u8bae\u7684\u4efb\u4f55\u6761\u6b3e\u5982\u56e0\u4e0e\u76f8\u5173\u6cd5\u5f8b\u62b5\u89e6\u800c\u65e0\u6548\uff0c\u4e0d\u5f71\u54cd\u5176\u4ed6\u6761\u6b3e\u7684\u6548\u529b\u3002</p><p>2. \u661f\u5bf0\u6d77\u672a\u884c\u4f7f\u6216\u5ef6\u8fdf\u884c\u4f7f\u672c\u534f\u8bae\u9879\u4e0b\u7684\u6743\u5229\uff0c\u4e0d\u6784\u6210\u5bf9\u8be5\u6743\u5229\u7684\u653e\u5f03\u3002</p><p>3. \u672c\u534f\u8bae\u7684\u6700\u7ec8\u89e3\u91ca\u6743\u5f52\u661f\u5bf0\u6d77\u6240\u6709\u3002</p><p><strong>\u751f\u6548\u65e5\u671f\uff1a2026\u5e747\u670820\u65e5 | \u7248\u672c\uff1av1.0</strong></p>'},privacy:{title:"\u9690\u79c1\u653f\u7b56",content:"<h3>\u4e00\u3001\u4e2a\u4eba\u4fe1\u606f\u6e05\u5355</h3><p>\u6211\u4eec\u6536\u96c6\u4ee5\u4e0b\u4e2a\u4eba\u4fe1\u606f\uff0c\u7528\u4e8e\u4e3a\u60a8\u63d0\u4f9b\u5ba0\u7269\u5065\u5eb7\u7ba1\u7406\u670d\u52a1\uff1a</p><ul><li><strong>\u5fae\u4fe1\u6388\u6743\u4fe1\u606f</strong>\uff1aopenid\u3001\u6635\u79f0\u3001\u5934\u50cf\uff0c\u7528\u4e8e\u767b\u5f55\u548c\u8eab\u4efd\u9a8c\u8bc1\u3002</li><li><strong>\u5ba0\u7269\u4fe1\u606f</strong>\uff1a\u54c1\u79cd\u3001\u5e74\u9f84\u3001\u4f53\u91cd\u3001\u7167\u7247\uff0c\u7528\u4e8e\u63d0\u4f9b\u4e2a\u6027\u5316\u5065\u5eb7\u5efa\u8bae\u548c\u5065\u5eb7\u8d8b\u52bf\u5206\u6790\u3002</li><li><strong>\u5065\u5eb7\u6570\u636e</strong>\uff1a\u6253\u5361\u8bb0\u5f55\u3001\u75c7\u72b6\u8bb0\u5f55\u3001\u75ab\u82d7\u8bb0\u5f55\u3001\u98df\u7269\u67e5\u8be2\u8bb0\u5f55\uff0c\u7528\u4e8e\u5065\u5eb7\u8d8b\u52bf\u5206\u6790\u548c\u63d0\u9192\u670d\u52a1\u3002</li><li><strong>\u8ba2\u9605\u6d88\u606f\u6388\u6743</strong>\uff1a\u6253\u5361\u63d0\u9192\u3001\u75ab\u82d7\u63d0\u9192\u3001\u5065\u5eb7\u5f02\u5e38\u63d0\u9192\uff0c\u7528\u4e8e\u5411\u60a8\u53d1\u9001\u670d\u52a1\u901a\u77e5\u3002</li><li><strong>\u652f\u4ed8\u4fe1\u606f</strong>\uff1a\u5fae\u4fe1\u652f\u4ed8\u8ba2\u5355\u53f7\uff0c\u7528\u4e8e\u4f1a\u5458\u8ba2\u9605\u670d\u52a1\u7684\u652f\u4ed8\u5904\u7406\u3002</li></ul><h3>\u4e8c\u3001\u4fe1\u606f\u4f7f\u7528</h3><p>\u6211\u4eec\u4ec5\u5c06\u6536\u96c6\u7684\u4fe1\u606f\u7528\u4e8e\u4ee5\u4e0b\u76ee\u7684\uff1a</p><ul><li>\u63d0\u4f9b\u548c\u6539\u5584\u5ba0\u7269\u5065\u5eb7\u7ba1\u7406\u670d\u52a1\u3002</li><li>\u53d1\u9001\u670d\u52a1\u901a\u77e5\uff08\u6253\u5361\u63d0\u9192\u3001\u75ab\u82d7\u63d0\u9192\u3001\u5065\u5eb7\u5f02\u5e38\u63d0\u9192\u7b49\uff09\u3002</li><li>\u751f\u6210\u5065\u5eb7\u8d8b\u52bf\u62a5\u544a\u548c\u4e2a\u6027\u5316\u5efa\u8bae\u3002</li><li>\u5904\u7406\u4f1a\u5458\u8ba2\u9605\u548c\u652f\u4ed8\u76f8\u5173\u4e8b\u52a1\u3002</li><li>\u4fdd\u969c\u670d\u52a1\u5b89\u5168\u548c\u7a33\u5b9a\u8fd0\u884c\u3002</li></ul><p>\u6211\u4eec\u4e0d\u4f1a\u5c06\u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u7528\u4e8e\u672c\u653f\u7b56\u672a\u8f7d\u660e\u7684\u5176\u4ed6\u76ee\u7684\u3002\u5982\u9700\u53d8\u66f4\u4f7f\u7528\u76ee\u7684\uff0c\u6211\u4eec\u5c06\u518d\u6b21\u5f81\u5f97\u60a8\u7684\u540c\u610f\u3002</p><h3>\u4e09\u3001\u7b2c\u4e09\u65b9SDK\u4fe1\u606f</h3><p>\u672c\u5e94\u7528\u63a5\u5165\u4ee5\u4e0b\u7b2c\u4e09\u65b9SDK\uff1a</p><ul><li><strong>Supabase</strong>\uff1a\u63d0\u4f9b\u6570\u636e\u5b58\u50a8\u548c\u8ba4\u8bc1\u670d\u52a1\u3002Supabase\u670d\u52a1\u5668\u4f4d\u4e8e\u6d77\u5916\uff0c\u60a8\u7684\u6570\u636e\u5c06\u4f20\u8f93\u81f3\u6d77\u5916\u670d\u52a1\u5668\u5b58\u50a8\u3002Supabase\u6536\u96c6\u7684\u6570\u636e\u5305\u62ec\uff1a\u8d26\u53f7\u6807\u8bc6\u3001\u5ba0\u7269\u4fe1\u606f\u3001\u5065\u5eb7\u6570\u636e\u3002Supabase\u9690\u79c1\u653f\u7b56\uff1ahttps://supabase.com/privacy</li><li><strong>\u5fae\u4fe1\u5f00\u653e\u5e73\u53f0SDK</strong>\uff1a\u63d0\u4f9b\u767b\u5f55\u6388\u6743\u3001\u652f\u4ed8\u3001\u8ba2\u9605\u6d88\u606f\u80fd\u529b\u3002\u5fae\u4fe1\u6536\u96c6\u7684\u6570\u636e\u7531\u5fae\u4fe1\u6839\u636e\u5176\u9690\u79c1\u653f\u7b56\u5904\u7406\u3002</li></ul><h3>\u56db\u3001\u6570\u636e\u8de8\u5883\u4f20\u8f93</h3><p>\u7531\u4e8e\u672c\u5e94\u7528\u4f7f\u7528Supabase\u63d0\u4f9b\u6570\u636e\u5b58\u50a8\u670d\u52a1\uff0c\u5176\u670d\u52a1\u5668\u4f4d\u4e8e\u6d77\u5916\uff0c\u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u5c06\u88ab\u4f20\u8f93\u81f3\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u5883\u5916\u5b58\u50a8\u3002\u6211\u4eec\u5df2\u91c7\u53d6\u5408\u7406\u63aa\u65bd\u786e\u4fdd\u5883\u5916\u63a5\u6536\u65b9\u7684\u6570\u636e\u4fdd\u62a4\u80fd\u529b\u8fbe\u5230\u4e2d\u534e\u4eba\u6c11\u5171\u548c\u56fd\u76f8\u5173\u6cd5\u5f8b\u8981\u6c42\u7684\u6c34\u5e73\uff0c\u5305\u62ec\uff1a</p><ul><li>\u6570\u636e\u4f20\u8f93\u91c7\u7528SSL/TLS\u52a0\u5bc6\u3002</li><li>\u6570\u636e\u5b58\u50a8\u91c7\u7528\u52a0\u5bc6\u5b58\u50a8\u3002</li><li>Supabase\u9075\u5b88GDPR\u7b49\u56fd\u9645\u6570\u636e\u4fdd\u62a4\u6807\u51c6\u3002</li></ul><h3>\u4e94\u3001\u6570\u636e\u5b58\u50a8\u671f\u9650</h3><p>1. \u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u5c06\u5728\u60a8\u4f7f\u7528\u672c\u5e94\u7528\u671f\u95f4\u6301\u7eed\u5b58\u50a8\u3002</p><p>2. \u5f53\u60a8\u6ce8\u9500\u8d26\u53f7\u540e\uff0c\u6211\u4eec\u5c06\u572815\u4e2a\u5de5\u4f5c\u65e5\u5185\u5220\u9664\u60a8\u7684\u6240\u6709\u4e2a\u4eba\u4fe1\u606f\uff0c\u6216\u8fdb\u884c\u533f\u540d\u5316\u5904\u7406\u3002</p><p>3. \u56e0\u6cd5\u5f8b\u6cd5\u89c4\u8981\u6c42\u9700\u7559\u5b58\u7684\u6570\u636e\uff0c\u6211\u4eec\u5c06\u6309\u6cd5\u5f8b\u89c4\u5b9a\u7684\u6700\u77ed\u671f\u9650\u7559\u5b58\uff0c\u7559\u5b58\u671f\u95f4\u4ec5\u7528\u4e8e\u6cd5\u5f8b\u5408\u89c4\u76ee\u7684\u3002</p><h3>\u516d\u3001\u4fe1\u606f\u4fdd\u62a4</h3><p>1. \u6211\u4eec\u91c7\u7528SSL/TLS\u52a0\u5bc6\u4f20\u8f93\u548c\u52a0\u5bc6\u5b58\u50a8\u4fdd\u62a4\u7528\u6237\u6570\u636e\u3002</p><p>2. \u672a\u7ecf\u7528\u6237\u540c\u610f\uff0c\u6211\u4eec\u4e0d\u4f1a\u5411\u7b2c\u4e09\u65b9\u5171\u4eab\u7528\u6237\u4e2a\u4eba\u4fe1\u606f\uff0c\u672c\u653f\u7b56\u7b2c\u4e09\u6761\u6240\u8ff0\u7b2c\u4e09\u65b9SDK\u9664\u5916\u3002</p><p>3. \u6211\u4eec\u5efa\u7acb\u4e86\u6570\u636e\u5b89\u5168\u7ba1\u7406\u5236\u5ea6\uff0c\u9650\u5236\u6570\u636e\u8bbf\u95ee\u6743\u9650\uff0c\u4ec5\u6388\u6743\u4eba\u5458\u53ef\u8bbf\u95ee\u7528\u6237\u6570\u636e\u3002</p><p>4. \u5982\u53d1\u751f\u4e2a\u4eba\u4fe1\u606f\u5b89\u5168\u4e8b\u4ef6\uff0c\u6211\u4eec\u5c06\u4f9d\u6cd5\u53ca\u65f6\u901a\u77e5\u60a8\u3002</p><h3>\u4e03\u3001\u7528\u6237\u6743\u5229</h3><p>\u60a8\u5bf9\u4e2a\u4eba\u4fe1\u606f\u4eab\u6709\u4ee5\u4e0b\u6743\u5229\uff1a</p><ul><li><strong>\u67e5\u8be2\u6743</strong>\uff1a\u60a8\u53ef\u968f\u65f6\u5728\u672c\u5e94\u7528\u4e2d\u67e5\u770b\u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u548c\u5ba0\u7269\u6570\u636e\u3002</li><li><strong>\u66f4\u6b63\u6743</strong>\uff1a\u60a8\u53ef\u968f\u65f6\u4fee\u6539\u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u548c\u5ba0\u7269\u4fe1\u606f\u3002</li><li><strong>\u5220\u9664\u6743</strong>\uff1a\u60a8\u53ef\u5220\u9664\u60a8\u7684\u5ba0\u7269\u4fe1\u606f\u3001\u5065\u5eb7\u8bb0\u5f55\u7b49\u6570\u636e\u3002</li><li><strong>\u64a4\u56de\u540c\u610f\u6743</strong>\uff1a\u60a8\u53ef\u5728\u5fae\u4fe1\u8bbe\u7f6e\u4e2d\u64a4\u56de\u5bf9\u5fae\u4fe1\u6388\u6743\u3001\u8ba2\u9605\u6d88\u606f\u7684\u540c\u610f\uff0c\u64a4\u56de\u540e\u76f8\u5173\u529f\u80fd\u5c06\u65e0\u6cd5\u4f7f\u7528\u3002</li><li><strong>\u6ce8\u9500\u6743</strong>\uff1a\u60a8\u53ef\u7533\u8bf7\u6ce8\u9500\u8d26\u53f7\uff0c\u6ce8\u9500\u540e\u6211\u4eec\u5c06\u4f9d\u6cd5\u5220\u9664\u60a8\u7684\u4e2a\u4eba\u4fe1\u606f\u3002</li></ul><p>\u5982\u9700\u884c\u4f7f\u4e0a\u8ff0\u6743\u5229\uff0c\u8bf7\u901a\u8fc7\u672c\u653f\u7b56\u7b2c\u4e5d\u6761\u6240\u8ff0\u8054\u7cfb\u65b9\u5f0f\u4e0e\u6211\u4eec\u8054\u7cfb\u3002</p><h3>\u516b\u3001\u672a\u6210\u5e74\u4eba\u4fdd\u62a4</h3><p>1. \u6211\u4eec\u9ad8\u5ea6\u91cd\u89c6\u672a\u6210\u5e74\u4eba\u4fe1\u606f\u4fdd\u62a4\uff0c\u4e0d\u4f1a\u4e3b\u52a8\u6536\u96c6\u672a\u6ee114\u5468\u5c81\u672a\u6210\u5e74\u4eba\u7684\u4e2a\u4eba\u4fe1\u606f\u3002</p><p>2. \u82e5\u60a8\u662f\u672a\u6ee114\u5468\u5c81\u7684\u672a\u6210\u5e74\u4eba\uff0c\u8bf7\u5728\u76d1\u62a4\u4eba\u6307\u5bfc\u4e0b\u4f7f\u7528\u672c\u5e94\u7528\uff0c\u5e76\u5728\u53d6\u5f97\u76d1\u62a4\u4eba\u540c\u610f\u540e\u63d0\u4f9b\u4e2a\u4eba\u4fe1\u606f\u3002</p><p>3. \u82e5\u6211\u4eec\u53d1\u73b0\u5728\u672a\u53d6\u5f97\u76d1\u62a4\u4eba\u540c\u610f\u7684\u60c5\u51b5\u4e0b\u6536\u96c6\u4e86\u672a\u6210\u5e74\u4eba\u4e2a\u4eba\u4fe1\u606f\uff0c\u5c06\u5c3d\u5feb\u5220\u9664\u76f8\u5173\u4fe1\u606f\u3002</p><p>4. \u76d1\u62a4\u4eba\u6709\u6743\u67e5\u8be2\u3001\u66f4\u6b63\u3001\u5220\u9664\u672a\u6210\u5e74\u4eba\u7684\u4e2a\u4eba\u4fe1\u606f\u3002</p><h3>\u4e5d\u3001\u8054\u7cfb\u65b9\u5f0f</h3><p>\u5982\u60a8\u5bf9\u672c\u9690\u79c1\u653f\u7b56\u6709\u4efb\u4f55\u7591\u95ee\u3001\u610f\u89c1\u6216\u5efa\u8bae\uff0c\u6216\u9700\u8981\u884c\u4f7f\u60a8\u7684\u7528\u6237\u6743\u5229\uff0c\u8bf7\u901a\u8fc7\u4ee5\u4e0b\u65b9\u5f0f\u8054\u7cfb\u6211\u4eec\uff1a</p><ul><li>\u5ba2\u670d\u7535\u8bdd\uff1a400-161-9995</li><li>\u670d\u52a1\u65f6\u95f4\uff1a\u5de5\u4f5c\u65e5 9:00-18:00</li></ul><p>\u6211\u4eec\u5c06\u572815\u4e2a\u5de5\u4f5c\u65e5\u5185\u56de\u590d\u60a8\u7684\u8bf7\u6c42\u3002</p><h3>\u5341\u3001\u9690\u79c1\u653f\u7b56\u66f4\u65b0</h3><p>1. \u6211\u4eec\u53ef\u80fd\u4f1a\u9002\u65f6\u4fee\u8ba2\u672c\u9690\u79c1\u653f\u7b56\uff0c\u4fee\u8ba2\u540e\u7684\u653f\u7b56\u5c06\u5728\u5e94\u7528\u5185\u516c\u793a\u3002</p><p>2. \u5bf9\u4e8e\u91cd\u5927\u53d8\u66f4\uff08\u5982\u6536\u96c6\u4fe1\u606f\u8303\u56f4\u6269\u5927\u3001\u4f7f\u7528\u76ee\u7684\u53d8\u66f4\u7b49\uff09\uff0c\u6211\u4eec\u5c06\u901a\u8fc7\u5e94\u7528\u5185\u5f39\u7a97\u7b49\u65b9\u5f0f\u53e6\u884c\u901a\u77e5\u60a8\uff0c\u5e76\u518d\u6b21\u5f81\u5f97\u60a8\u7684\u540c\u610f\u3002</p><p>3. \u672c\u653f\u7b56\u4fee\u8ba2\u540e\uff0c\u82e5\u60a8\u7ee7\u7eed\u4f7f\u7528\u672c\u5e94\u7528\uff0c\u5373\u89c6\u4e3a\u60a8\u540c\u610f\u4fee\u8ba2\u540e\u7684\u9690\u79c1\u653f\u7b56\u3002</p><p>4. \u82e5\u60a8\u4e0d\u540c\u610f\u4fee\u8ba2\u540e\u7684\u9690\u79c1\u653f\u7b56\uff0c\u60a8\u6709\u6743\u505c\u6b62\u4f7f\u7528\u672c\u5e94\u7528\u5e76\u6ce8\u9500\u8d26\u53f7\u3002</p><p><strong>\u751f\u6548\u65e5\u671f\uff1a2026\u5e747\u670820\u65e5 | \u7248\u672c\uff1av1.0</strong></p>"}};function c(){var p=(0,a.useState)("user"),e=(0,l.Z)(p,2),t=e[0],n=e[1],r=(0,o.z)(),c=r.trackEvent;(0,o.a)("agreement");var v=(0,g.F)();(0,a.useEffect)(function(){var p,e=s().getCurrentInstance(),t=null===(p=e.router)||void 0===p||null===(p=p.params)||void 0===p?void 0:p.type;"user"!==t&&"privacy"!==t||(n(t),c("view_agreement",{type:t}))},[c]);var S=u[t];return(0,h.jsxs)(i.G7,{className:"agreement-page "+v,children:[(0,h.jsx)(i.G7,{className:"agreement-page__header",children:(0,h.jsx)(i.xv,{className:"agreement-page__title",children:S.title})}),(0,h.jsx)(i.G7,{className:"agreement-page__content",children:(0,h.jsx)(i.Ho,{nodes:S.content})})]})}var v={navigationBarTitleText:"\u7528\u6237\u534f\u8bae"};Page((0,n.createPageConfig)(c,"pagesUser/agreement/index",{root:{cn:[]}},v||{}))}},function(p){var e=function(e){return p(p.s=e)};p.O(0,[2107,1216,8592],function(){return e(9806)});p.O()}]);
