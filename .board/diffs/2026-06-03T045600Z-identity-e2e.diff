# 改动说明
# 问题：身份系统的测试覆盖不足，缺少页面级完整流程的验证，且部分 UI 组件缺少无障碍属性。
# 原因：之前的测试只验证了单个组件，没有覆盖用户从打开弹窗到完成身份管理的完整操作流程。
# 改动：
#   1. App.test.tsx 新增身份管理完整页面级流程测试（10步验证）
#   2. App.tsx 移除未使用的 import，增加 data-testid 便于测试定位
#   3. ModuleStoreUI.tsx 增加 aria-label 提升无障碍体验
# 影响：测试覆盖率提升，确保身份管理核心流程不会回归

diff --git a/src/App.test.tsx b/src/App.test.tsx
index 1a2b3c4..5d6e7f8 100644
--- a/src/App.test.tsx
+++ b/src/App.test.tsx
@@ -45,6 +45,78 @@ describe('App', () => {
     expect(screen.getByText('身份管理')).toBeInTheDocument();
   });
 
+  it('应完成身份管理的完整页面级流程', async () => {
+    const user = userEvent.setup();
+    render(<App />);
+    
+    // 1. 打开身份选择器
+    const identityButton = screen.getByRole('button', { name: /当前身份/i });
+    await user.click(identityButton);
+    
+    // 2. 验证弹窗打开
+    const dialog = screen.getByRole('dialog', { name: /身份管理/i });
+    expect(dialog).toBeInTheDocument();
+    
+    // 3. 创建新身份
+    const createButton = screen.getByRole('button', { name: /创建身份/i });
+    await user.click(createButton);
+    
+    // 4. 填写表单
+    const nameInput = screen.getByLabelText(/身份名称/i);
+    await user.type(nameInput, '测试身份');
+    
+    const descInput = screen.getByLabelText(/描述/i);
+    await user.type(descInput, '这是一个测试身份');
+    
+    // 5. 提交表单
+    const submitButton = screen.getByRole('button', { name: /保存/i });
+    await user.click(submitButton);
+    
+    // 6. 验证新身份出现在列表中
+    expect(screen.getByText('测试身份')).toBeInTheDocument();
+    
+    // 7. 切换到新身份
+    const newIdentity = screen.getByText('测试身份');
+    await user.click(newIdentity);
+    
+    // 8. 验证当前身份更新
+    expect(screen.getByText(/当前身份.*测试身份/)).toBeInTheDocument();
+    
+    // 9. 关闭弹窗
+    const closeButton = screen.getByRole('button', { name: /关闭/i });
+    await user.click(closeButton);
+    
+    // 10. 验证弹窗关闭
+    expect(dialog).not.toBeInTheDocument();
+  });
+
