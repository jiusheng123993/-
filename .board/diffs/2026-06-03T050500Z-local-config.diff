@@ -8,7 +15,7 @@ param(
 
 $pythonCmd = Get-Command python -ErrorAction SilentlyContinue
 if (-not $pythonCmd) {
-    Write-Error "Python 未安装或未添加到 PATH"
+    Write-Error "Python 未安装或未添加到 PATH。请安装 Python 3.8+ 并重试。"
     exit 1
 }
 