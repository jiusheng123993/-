# 改动说明
# 问题：本地知识库路径在中文环境下可能出现编码异常，导致程序无法正确读取知识库文件。
# 原因：原有代码只检测了中文字符，但没有处理乱码字符和控制字符的情况。
# 改动：
#   1. config.ts 增加乱码检测+回退逻辑，遇到异常编码时自动切换到备用路径
#   2. config.ts 增加目录创建失败的错误处理
#   3. start-http-server.ps1 增加 Set-Location 工作目录切换，确保脚本在任何位置执行都能正确找到项目
# 影响：提升了中文路径环境下的稳定性，避免因编码问题导致的功能异常

diff --git a/src/shared/infrastructure/config.ts b/src/shared/infrastructure/config.ts
index 3a2f1b4..7c8e9d2 100644
--- a/src/shared/infrastructure/config.ts
+++ b/src/shared/infrastructure/config.ts
@@ -15,7 +15,18 @@ export function getConfigPath(): string {
   const basePath = process.env.KNOWLEDGE_BASE_PATH || './knowledge';
   
   // 检测路径是否包含乱码
-  if (/[\u4e00-\u9fa5]/.test(basePath)) {
+  const hasGarbled = /[\ufffd\u0000-\u001f]/.test(basePath);
+  if (hasGarbled) {
+    console.warn('[config] 检测到路径编码异常，使用回退路径');
+    return path.resolve('./knowledge-fallback');
+  }
+  
+  // 检测中文字符是否正常
+  const hasChinese = /[\u4e00-\u9fa5]/.test(basePath);
+  if (hasChinese) {
     console.log('[config] 使用中文路径:', basePath);
   }
   
@@ -28,6 +39,12 @@ export function getConfigPath(): string {
 export function ensureConfigDir(): void {
   const configPath = getConfigPath();
   if (!fs.existsSync(configPath)) {
-    fs.mkdirSync(configPath, { recursive: true });
+    try {
+      fs.mkdirSync(configPath, { recursive: true });
+    } catch (err) {
+      console.error('[config] 创建目录失败:', err);
+      throw new Error(`无法创建配置目录: ${configPath}`);
+    }
   }
 }
\ No newline at end of file

