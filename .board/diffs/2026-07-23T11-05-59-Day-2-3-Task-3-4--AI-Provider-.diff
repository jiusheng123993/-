-export function calculateConsecutiveAnomalyDays(
-  entries: Array<{ date: string; hasAnomaly: boolean }>,
-): number {
-  const sorted = [...entries].sort((a, b) => b.date.localeCompare(a.date))
-  let count = 0
-  for (const entry of sorted) {
-    if (entry.hasAnomaly) {
-      count++
-    } else {
-      break
-    }
-  }
-  return count
-}
