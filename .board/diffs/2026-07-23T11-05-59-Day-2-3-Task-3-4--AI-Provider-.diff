+<script>
+/* ===== Navigation ===== */
+function switchTab(tab) {
+  closeAllSubViews();
+  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
+  document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
+
+  const viewMap = { chat:'chatView', timeline:'timelineView', family:'familyView', profile:'profileView' };
+  const targetView = document.getElementById(viewMap[tab]);
+  if (targetView) targetView.classList.add('active');
+
+  const tabEl = document.querySelector(`.tab-item[data-tab="${tab}"]`);
+  if (tabEl) tabEl.classList.add('active');
+
+  if (tab === 'chat') {
+    document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight;
+  }
+}
+
+function closeAllSubViews() {
+  document.querySelectorAll('.sub-view').forEach(v => v.classList.remove('active'));
+  document.getElementById('petProfileModal').classList.remove('show');
+}
+
+function openFamilyTree() {
+  closeAllSubViews();
+  document.getElementById('familyTreeView').classList.add('active');
+  document.getElementById('familyView').classList.remove('active');
+}
+
+function openFamilyCalendar() {
+  closeAllSubViews();
+  document.getElementById('familyCalendarView').classList.add('active');
+  document.getElementById('familyView').classList.remove('active');
+}
+
+function closeSubView() {
+  var wasHealthTrend = document.getElementById('healthTrendView').classList.contains('active');
+  document.querySelectorAll('.sub-view').forEach(v => v.classList.remove('active'));
+  if (wasHealthTrend) {
+    document.getElementById('chatView').classList.add('active');
+    if (document.querySelector('.tab-item[data-tab="chat"]')) {
+      document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
+      document.querySelector('.tab-item[data-tab="chat"]').classList.add('active');
+    }
+  } else {
+    document.getElementById('familyView').classList.add('active');
+  }
+}
+
+/* ===== Plus Menu ===== */
+function togglePlusMenu() {
+  const menu = document.getElementById('chatPlusMenu');
+  menu.classList.toggle('show');
+}
+
+document.addEventListener('click', function(e) {
+  const menu = document.getElementById('chatPlusMenu');
+  if (menu.classList.contains('show') && !e.target.closest('.chat-plus-menu') && !e.target.closest('.chat-btn-plus')) {
+    menu.classList.remove('show');
+  }
+});
+
+/* ===== Chat Messages ===== */
+function addMessage(type, html) {
+  const msgs = document.getElementById('chatMessages');
+  const div = document.createElement('div');
+  div.className = `msg msg-${type}`;
+  const avatarEmoji = type === 'ai' ? '🤖' : '😊';
+  div.innerHTML = `<div class="msg-avatar">${avatarEmoji}</div><div class="msg-content">${html}</div>`;
+  msgs.appendChild(div);
+  msgs.scrollTop = msgs.scrollHeight;
+  return div;
+}
+
+function addAIMessage(text) {
+  return addMessage('ai', `<div class="msg-bubble">${text}</div>`);
+}
+
+function addUserMessage(text) {
+  return addMessage('user', `<div class="msg-bubble">${text}</div>`);
+}
+
+function addAIOptions(text, options) {
+  let html = `<div class="msg-bubble">${text}</div><div style="margin-top:8px;">`;
+  options.forEach((opt, i) => {
+    html += `<button class="btn-option" data-opt-idx="${i}">${opt.label}</button>`;
+  });
+  html += '</div>';
+  const msgEl = addMessage('ai', html);
+
+  msgEl.querySelectorAll('.btn-option').forEach(btn => {
+    btn.addEventListener('click', function() {
+      const idx = parseInt(this.dataset.optIdx);
+      msgEl.querySelectorAll('.btn-option').forEach(b => b.classList.remove('selected'));
+      this.classList.add('selected');
+      if (options[idx].onSelect) options[idx].onSelect(this, msgEl);
+    });
+  });
+  return msgEl;
+}
+
+function addTyping() {
+  const msgs = document.getElementById('chatMessages');
+  const div = document.createElement('div');
+  div.className = 'msg msg-ai';
+  div.id = 'typingIndicator';
+  div.innerHTML = `<div class="msg-avatar">🤖</div><div class="msg-content"><div class="msg-bubble"><div class="typing-dots"><span></span><span></span><span></span></div></div></div>`;
+  msgs.appendChild(div);
+  msgs.scrollTop = msgs.scrollHeight;
+  return div;
+}
+
+function removeTyping() {
+  const el = document.getElementById('typingIndicator');
+  if (el) el.remove();
+}
+
+function sendMessage() {
+  const input = document.getElementById('chatInput');
+  const text = input.value.trim();
+  if (!text) return;
+  input.value = '';
+  addUserMessage(text);
+
+  const typing = addTyping();
+  setTimeout(() => {
+    removeTyping();
+    if (text.includes('打卡') || text.includes('健康')) {
+      startCheckIn();
+    } else if (text.includes('食物') || text.includes('能不能吃')) {
+      addAIMessage('好的！你想查询哪种食物呢？<br><br>可以告诉我具体的食物名称，比如"巧克力""葡萄""苹果""鸡肉"等，我来帮你分析青橘能不能吃～');
+    } else if (text.includes('症状') || text.includes('不舒服') || text.includes('生病')) {
+      startSymptomCheck();
+    } else if (text.includes('取名') || text.includes('名字')) {
+      startNaming();
+    } else if (text.includes('趋势') || text.includes('健康报告')) {
+      addAIMessage('好的！让我为你打开青橘的健康趋势图～');
+      setTimeout(() => openHealthTrend(), 500);
+    } else {
+      addAIMessage('收到啦！青橘的情况我记下了 ✦<br><br>你还可以试试：<br>· 打卡记录今天的健康状况<br>· 查询某种食物能不能吃<br>· 做一次症状初筛评估<br>· 让我帮新宠物取个好名字');
+    }
+  }, 800);
