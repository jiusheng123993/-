+.profile-pets-scroll {
+  display: flex;
+  gap: 10px;
+  overflow-x: auto;
+  padding: 8px 16px 16px;
+}
+.profile-pets-scroll::-webkit-scrollbar { display:none; }
+.profile-pet-chip {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  background: var(--color-bg-card);
+  border-radius: 20px;
+  padding: 6px 14px 6px 6px;
+  flex-shrink: 0;
+  cursor: pointer;
+}
+.profile-pet-chip .pp-avatar {
+  width: 30px; height: 30px;
+  border-radius: 50%;
+  display: flex; align-items:center; justify-content:center;
+  font-size: 16px;
+}
+.profile-pet-chip .pp-name { font-size:12px; }
+
+.profile-menu { padding: 0 16px 20px; }
+.profile-menu-item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 16px;
+  background: var(--color-bg-card);
+  border-radius: 14px;
+  margin-bottom: 8px;
+  cursor: pointer;
+  transition: all 0.2s;
+}
+.profile-menu-item:active { background: rgba(26,35,50,0.6); }
+.profile-menu-item .pm-left { display:flex; align-items:center; gap:12px; }
+.profile-menu-item .pm-icon { font-size:20px; width:24px; text-align:center; }
+.profile-menu-item .pm-label { font-size:14px; }
+.profile-menu-item .pm-arrow { font-size:14px; color:var(--color-text-dim); }
+
+.profile-logout {
+  text-align: center;
+  padding: 20px;
+  color: var(--color-coral);
+  font-size: 13px;
+  cursor: pointer;
+  opacity: 0.7;
+}
+
+/* ===== Health Trend View ===== */
+.health-trend-container {
+  padding: 16px;
+}
+.health-chart-bars {
+  display: flex;
+  align-items: flex-end;
+  gap: 8px;
+  height: 160px;
+  padding: 8px 0;
+}
+.health-bar-col {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 4px;
+}
+.health-bar {
+  width: 100%;
+  max-width: 32px;
+  border-radius: 6px 6px 0 0;
+  transition: height 0.5s ease-out;
+  position: relative;
+}
+.health-bar.good { background: linear-gradient(180deg, var(--color-sage), rgba(140,173,126,0.4)); }
+.health-bar.warn { background: linear-gradient(180deg, var(--color-gold), rgba(232,168,56,0.4)); }
+.health-bar.bad { background: linear-gradient(180deg, var(--color-coral), rgba(224,133,107,0.4)); }
+.health-bar-label { font-size: 10px; color: var(--color-text-dim); }
+.health-bar-val { font-size: 10px; color: var(--color-gold-light); }
+
+.health-ai-card {
+  margin-top: 16px;
+  background: var(--color-bg-card);
+  border: 1px solid rgba(91,154,155,0.3);
+  border-radius: 14px;
+  padding: 16px;
+}
+.health-ai-card .hai-title { font-size:14px; color:var(--color-teal); margin-bottom:8px; }
+.health-ai-card .hai-text { font-size:13px; line-height:1.7; color:var(--color-text-dim); }
+
+/* ===== Pet Profile Modal ===== */
+.modal-overlay {
+  display: none;
+  position: fixed;
+  top: 0; left: 0; right: 0; bottom: 0;
+  background: rgba(0,0,0,0.7);
+  z-index: 200;
+  justify-content: center;
+  align-items: flex-end;
+}
+.modal-overlay.show { display: flex; }
+.modal-sheet {
+  width: 100%;
+  max-width: 414px;
+  background: linear-gradient(180deg, #1A2332 0%, #0F1724 100%);
+  border-radius: 20px 20px 0 0;
+  padding: 20px 16px 32px;
+  animation: sheetUp 0.3s ease-out;
+  max-height: 80vh;
+  overflow-y: auto;
+}
+@keyframes sheetUp {
+  from { transform: translateY(100%); }
+  to { transform: translateY(0); }
+}
+.modal-handle {
+  width: 36px; height: 4px;
+  background: rgba(136,153,170,0.3);
+  border-radius: 2px;
+  margin: 0 auto 16px;
+}
+.modal-pet-header {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  margin-bottom: 16px;
+}
+.modal-pet-avatar {
+  width: 60px; height: 60px;
+  border-radius: 50%;
+  display: flex; align-items:center; justify-content:center;
+  font-size: 32px;
+}
+.modal-pet-name { font-size:20px; font-weight:600; }
+.modal-pet-breed { font-size:12px; color:var(--color-text-dim); }
+.modal-info-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+.modal-info-item {
+  background: rgba(26,35,50,0.6);
+  border-radius: 10px;
+  padding: 10px 12px;
+}
+.modal-info-item .mii-label { font-size:10px; color:var(--color-text-dim); }
+.modal-info-item .mii-val { font-size:13px; font-weight:500; margin-top:2px; }
+.modal-btn-row { display:flex; gap:10px; }
+.modal-btn-row button { flex:1; }
+
+/* ===== Toast ===== */
+.toast {
+  position: fixed;
+  top: 60px;
+  left: 50%;
+  transform: translateX(-50%);
+  background: var(--color-bg-card);
+  border: 1px solid var(--color-gold);
+  color: var(--color-gold-light);
+  padding: 10px 20px;
+  border-radius: 20px;
+  font-size: 13px;
+  z-index: 300;
+  animation: toastIn 0.3s ease-out;
+  pointer-events: none;
+}
+@keyframes toastIn {
+  from { opacity:0; transform:translateX(-50%) translateY(-10px); }
+  to { opacity:1; transform:translateX(-50%) translateY(0); }
+}
+
+/* ===== Typing indicator ===== */
+.typing-dots {
+  display: flex;
+  gap: 4px;
+  padding: 4px 0;
+}
+.typing-dots span {
+  width: 6px; height: 6px;
+  border-radius: 50%;
+  background: var(--color-text-dim);
+  animation: dotBounce 1.4s ease-in-out infinite both;
+}
+.typing-dots span:nth-child(1) { animation-delay: 0s; }
+.typing-dots span:nth-child(2) { animation-delay: 0.2s; }
+.typing-dots span:nth-child(3) { animation-delay: 0.4s; }
+@keyframes dotBounce {
+  0%,80%,100% { transform:scale(0.6); }
+  40% { transform:scale(1); }
+}
+
+/* ===== Score Stars ===== */
+.score-stars { color: var(--color-gold); font-size: 16px; letter-spacing: 2px; }
+.score-stars .empty { color: rgba(136,153,170,0.3); }
+
+/* ===== Divider ===== */
+.section-divider {
+  height: 1px;
+  background: linear-gradient(90deg, transparent, rgba(232,168,56,0.15), transparent);
+  margin: 8px 0 16px;
+}
+</style>
