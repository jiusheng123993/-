+  }
+}
+@keyframes skeletonLoading {
+  0% {
+    background-position: -200% 0;
+  }
+  100% {
+    background-position: 200% 0;
+  }
+}
+@keyframes shimmer {
+  0%, 100% {
+    opacity: 0.3;
+  }
+  50% {
+    opacity: 1;
+  }
+}
+@keyframes shimmerLine {
+  0% {
+    left: -100%;
+  }
+  100% {
+    left: 100%;
+  }
+}
+@keyframes rootGlow {
+  0%, 100% {
+    box-shadow: 0 0 12rpx rgba(var(--primary-rgb), 0.08);
+  }
+  50% {
+    box-shadow: 0 0 28rpx rgba(var(--primary-rgb), 0.22);
+  }
+}
+@keyframes toastIn {
+  from {
+    opacity: 0;
+    transform: translateX(-50%) translateY(-12rpx);
+  }
+  to {
+    opacity: 1;
+    transform: translateX(-50%) translateY(0);
+  }
+}
+@keyframes breathingScore {
+  0%, 100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.5;
+  }
+}
+@keyframes pageEnter {
+  from {
+    opacity: 0;
+  }
+  to {
+    opacity: 1;
+  }
+}
+@keyframes btnRipple {
+  0% {
+    transform: scale(0);
+    opacity: 0.6;
+  }
+  100% {
+    transform: scale(4);
+    opacity: 0;
+  }
+}
+.member-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  animation: pageEnter 0.4s ease-out;
+  position: relative;
+  overflow: hidden;
+}
+
+.member-page::before {
+  content: "";
+  position: absolute;
+  top: -60rpx;
+  right: -40rpx;
+  width: 220rpx;
+  height: 220rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.06) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 5s ease-in-out infinite;
+}
+
+.member-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 32rpx 32rpx 16rpx;
+}
+
+.member-header-title {
+  font-size: 40rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+}
+
+.member-badge {
+  padding: 8rpx 22rpx;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  border-radius: 20rpx;
+  font-size: 24rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 700;
+  box-shadow: 0 4rpx 16rpx rgba(var(--primary, #C88EA8), 0.3);
+  animation: pulse 2s ease-in-out infinite;
+}
+
+.member-hero {
+  position: relative;
+  margin: 16rpx 32rpx;
+  border-radius: 20rpx;
+  overflow: hidden;
+  animation: fadeInScale 0.4s ease-out;
+}
+
+.member-hero-bg {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: linear-gradient(135deg, rgba(var(--primary, #C88EA8), 0.15), rgba(var(--primary-dark, #A06880), 0.08), var(--bg-card, #2A1E24));
+}
+
+.member-hero-content {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 48rpx 32rpx;
+}
+
+.member-hero-icon {
+  font-size: 72rpx;
+  margin-bottom: 16rpx;
+  animation: rootGlow 3s ease-in-out infinite;
+  filter: drop-shadow(0 0 12rpx rgba(var(--primary, #C88EA8), 0.4));
+}
+
+.member-hero-title {
+  font-size: 34rpx;
+  font-weight: 700;
+  color: var(--primary-light, #E8C8D8);
+  margin-bottom: 12rpx;
+}
+
+.member-hero-desc {
+  font-size: 24rpx;
+  color: var(--text-hint, #988898);
+  text-align: center;
+  line-height: 1.5;
+}
+
+.member-section {
+  margin: 0 32rpx 24rpx;
+}
+
+.member-section-title {
+  font-size: 30rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  margin-bottom: 16rpx;
+  display: block;
+}
+
+.member-benefits {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 12rpx;
+}
+
+.member-benefit-item {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  padding: 24rpx 12rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  transition: all 0.2s ease;
+  animation: cardStaggerIn 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) both;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.member-benefit-item:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.member-benefit-item:active {
+  border-color: rgba(var(--primary, #C88EA8), 0.3);
+  background: rgba(var(--primary, #C88EA8), 0.05);
+}
+
+.member-benefit-item:nth-child(1) {
+  animation-delay: 0s;
+}
+
+.member-benefit-item:nth-child(2) {
+  animation-delay: 0.06s;
+}
+
+.member-benefit-item:nth-child(3) {
+  animation-delay: 0.12s;
+}
+
+.member-benefit-item:nth-child(4) {
+  animation-delay: 0.18s;
+}
+
+.member-benefit-item:nth-child(5) {
+  animation-delay: 0.24s;
+}
+
+.member-benefit-item:nth-child(6) {
+  animation-delay: 0.3s;
+}
+
+.member-benefit-icon {
+  font-size: 36rpx;
+  margin-bottom: 8rpx;
+}
+
+.member-benefit-title {
+  font-size: 20rpx;
+  color: var(--text-primary, #E8D8DE);
+  font-weight: 500;
+  margin-bottom: 4rpx;
+  text-align: center;
+}
+
+.member-benefit-desc {
+  font-size: 18rpx;
+  color: var(--text-hint, #988898);
+  text-align: center;
+}
+
+.member-plans {
+  display: flex;
+  gap: 16rpx;
+}
+
+.member-plan-card {
+  flex: 1;
+  position: relative;
+  padding: 32rpx 24rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 2rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  transition: all 0.25s ease;
+  overflow: hidden;
+  transition: transform 0.15s ease, opacity 0.15s ease;
+}
+.member-plan-card:active {
+  transform: scale(0.96);
+  opacity: 0.85;
+}
+.member-plan-card::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 3rpx;
+  background: linear-gradient(90deg, transparent, var(--primary, #C88EA8), transparent);
+  opacity: 0;
+  transition: opacity 0.25s ease;
+}
+
+.member-plan-card-active {
+  border-color: var(--primary, #C88EA8);
+  background: linear-gradient(135deg, rgba(var(--primary, #C88EA8), 0.08), var(--bg-card, #2A1E24));
+  box-shadow: 0 0 24rpx rgba(var(--primary, #C88EA8), 0.15);
+}
+.member-plan-card-active::before {
+  opacity: 1;
+  animation: shimmer 2s ease-in-out infinite;
+}
+
+.member-plan-tag {
+  position: absolute;
+  top: 0;
+  right: 0;
+  padding: 6rpx 18rpx;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  border-radius: 0 14rpx 0 14rpx;
+  font-size: 20rpx;
+  color: var(--text-inverse, #1A1418);
+  font-weight: 700;
+  box-shadow: 0 2rpx 8rpx rgba(var(--primary, #C88EA8), 0.3);
+}
+
+.member-plan-name {
+  font-size: 28rpx;
+  font-weight: 700;
+  color: var(--text-primary, #E8D8DE);
+  display: block;
+  margin-bottom: 12rpx;
+}
+
+.member-plan-price-row {
+  display: flex;
+  align-items: baseline;
+  margin-bottom: 8rpx;
+}
+
+.member-plan-price {
+  font-size: 44rpx;
+  font-weight: 700;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-light, #E8C8D8));
+  -webkit-background-clip: text;
+  -webkit-text-fill-color: transparent;
+  background-clip: text;
+}
+
+.member-plan-period {
+  font-size: 24rpx;
+  color: var(--text-hint, #988898);
+  margin-left: 4rpx;
+}
+
+.member-plan-original {
+  font-size: 22rpx;
+  color: var(--text-tertiary, #786870);
+  text-decoration: line-through;
+  display: block;
+  margin-bottom: 24rpx;
+}
+
+.member-plan-features {
+  display: flex;
+  flex-direction: column;
+  gap: 12rpx;
+}
+
+.member-plan-feature {
+  display: flex;
+  align-items: center;
+  gap: 8rpx;
+}
+
+.member-plan-check {
+  font-size: 22rpx;
+  color: var(--primary, #C88EA8);
+  font-weight: 700;
+}
+
+.member-plan-feature-text {
+  font-size: 22rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.member-subscribe-btn {
+  height: 96rpx;
+  line-height: 96rpx;
+  text-align: center;
+  background: linear-gradient(135deg, var(--primary, #C88EA8), var(--primary-dark, #A06880));
+  border-radius: 40rpx;
+  font-size: 32rpx;
+  font-weight: 700;
+  color: var(--text-inverse, #1A1418);
+  box-shadow: 0 8rpx 24rpx rgba(var(--primary, #C88EA8), 0.3);
+  transition: all 0.2s ease;
+}
+.member-subscribe-btn:active {
+  transform: scale(0.97);
+  box-shadow: 0 4rpx 12rpx rgba(var(--primary, #C88EA8), 0.2);
+}
+
+.member-subscribe-hint {
+  font-size: 20rpx;
+  color: var(--text-hint, #988898);
+  text-align: center;
+  margin-top: 16rpx;
+  display: block;
+}
+
+.member-manage-card {
+  padding: 0;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 20rpx;
+  border: 1rpx solid var(--border, rgba(200, 142, 168, 0.15));
+  overflow: hidden;
+}
+
+.member-manage-item {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 28rpx 24rpx;
+  border-bottom: 1rpx solid var(--divider, rgba(200, 142, 168, 0.06));
+}
+.member-manage-item:last-child {
+  border-bottom: none;
+}
+
+.member-manage-label {
+  font-size: 28rpx;
+  color: var(--text-secondary, #A098A0);
+}
+
+.member-manage-value {
+  font-size: 28rpx;
+  color: var(--primary-light, #E8C8D8);
+  font-weight: 500;
+}
+
+.member-bottom-safe {
+  height: 60rpx;
+}
