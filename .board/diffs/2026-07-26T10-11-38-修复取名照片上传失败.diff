+.login-page {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  min-height: 100vh;
+  padding: 40rpx 32rpx;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  position: relative;
+  overflow: hidden;
+  animation: pageEnter 0.5s ease-out;
+}
+
+.login-page::before {
+  content: "";
+  position: absolute;
+  top: -80rpx;
+  left: 50%;
+  transform: translateX(-50%);
+  width: 300rpx;
+  height: 300rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.08) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 4s ease-in-out infinite;
+}
+
+.login-page::after {
+  content: "";
+  position: absolute;
+  bottom: 100rpx;
+  right: -60rpx;
+  width: 200rpx;
+  height: 200rpx;
+  background: radial-gradient(circle, rgba(var(--primary-light, #E8C8D8), 0.06) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 4s ease-in-out 1.5s infinite;
+}
+
+.login-paw-particles {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  overflow: hidden;
+}
+
+.login-paw {
+  position: absolute;
+  font-size: 28rpx;
+  opacity: 0;
+}
+
+.login-paw--1 {
+  top: 15%;
+  left: 10%;
+  animation: pawFloat1 6s ease-in-out infinite;
+}
+
+.login-paw--2 {
+  top: 25%;
+  right: 12%;
+  animation: pawFloat2 7s ease-in-out 1s infinite;
+}
+
+.login-paw--3 {
+  bottom: 30%;
+  left: 8%;
+  animation: pawFloat3 5.5s ease-in-out 2s infinite;
+}
+
+.login-paw--4 {
+  top: 40%;
+  right: 8%;
+  animation: pawFloat1 6.5s ease-in-out 0.5s infinite;
+}
+
+.login-paw--5 {
+  bottom: 20%;
+  right: 15%;
+  animation: pawFloat2 7.5s ease-in-out 1.8s infinite;
+}
+
+.login-stars {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  overflow: hidden;
+}
+
+.login-star {
+  position: absolute;
+  font-size: 24rpx;
+  color: rgba(var(--primary-light, #E8C8D8), 0.5);
+}
+
+.login-star--1 {
+  top: 10%;
+  right: 20%;
+  animation: starTwinkle1 3s ease-in-out infinite;
+}
+
+.login-star--2 {
+  top: 30%;
+  left: 15%;
+  animation: starTwinkle2 3.5s ease-in-out 0.5s infinite;
+}
+
+.login-star--3 {
+  bottom: 35%;
+  right: 25%;
+  animation: starTwinkle3 2.8s ease-in-out 1s infinite;
+}
+
+.login-star--4 {
+  top: 50%;
+  left: 10%;
+  animation: starTwinkle1 3.2s ease-in-out 1.5s infinite;
+}
+
+.login-star--5 {
+  bottom: 15%;
+  left: 20%;
