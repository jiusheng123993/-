+.profile-page {
+  min-height: 100vh;
+  background: var(--gradient-page, linear-gradient(180deg, #160E14 0%, #1A1418 30%, #241820 70%, #2A1E24 100%));
+  animation: pageEnter 0.4s ease-out;
+  position: relative;
+  overflow: hidden;
+}
+
+.profile-page::before {
+  content: "";
+  position: absolute;
+  bottom: 100rpx;
+  left: -40rpx;
+  width: 200rpx;
+  height: 200rpx;
+  background: radial-gradient(circle, rgba(var(--primary, #C88EA8), 0.06) 0%, transparent 70%);
+  border-radius: 50%;
+  pointer-events: none;
+  animation: warmBreathe 5s ease-in-out 1s infinite;
+}
+
+.profile-header {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-direction: column;
+  padding: 48rpx 32rpx 32rpx;
+  background: linear-gradient(180deg, rgba(var(--primary, #C88EA8), 0.06), var(--bg-page, #1A1418) 100%);
+}
+
+.profile-avatar {
