+@keyframes home-skeleton-shimmer {
+  0% {
+    background-position: -200% 0;
+  }
+  100% {
+    background-position: 200% 0;
+  }
+}
+.home-skeleton {
+  min-height: 100vh;
+  background: var(--bg-page, #1A1418);
+  padding: 24rpx 32rpx;
+}
+.home-skeleton__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  margin-bottom: 24rpx;
+}
+.home-skeleton__title {
+  width: 160rpx;
+  height: 40rpx;
+  border-radius: 4rpx;
+  background: linear-gradient(90deg, var(--border-light, rgba(200, 142, 168, 0.08)) 25%, var(--border, rgba(200, 142, 168, 0.15)) 50%, var(--border-light, rgba(200, 142, 168, 0.08)) 75%);
+  background-size: 200% 100%;
+  animation: home-skeleton-shimmer 1.5s ease-in-out infinite;
+}
+.home-skeleton__icon {
+  width: 48rpx;
+  height: 48rpx;
+  border-radius: 999rpx;
+  background: linear-gradient(90deg, var(--border-light, rgba(200, 142, 168, 0.08)) 25%, var(--border, rgba(200, 142, 168, 0.15)) 50%, var(--border-light, rgba(200, 142, 168, 0.08)) 75%);
+  background-size: 200% 100%;
+  animation: home-skeleton-shimmer 1.5s ease-in-out infinite;
+}
+.home-skeleton__pet-card {
+  display: flex;
+  align-items: center;
+  gap: 16rpx;
+  padding: 24rpx;
+  background: var(--bg-card, #2A1E24);
+  border-radius: 16rpx;
+  margin-bottom: 24rpx;
+  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
+}
+.home-skeleton__avatar {
+  width: 96rpx;
+  height: 96rpx;
+  border-radius: 999rpx;
+  background: linear-gradient(90deg, var(--border-light, rgba(200, 142, 168, 0.08)) 25%, var(--border, rgba(200, 142, 168, 0.15)) 50%, var(--border-light, rgba(200, 142, 168, 0.08)) 75%);
+  background-size: 200% 100%;
+  animation: home-skeleton-shimmer 1.5s ease-in-out infinite;
+}
+.home-skeleton__info {
+  flex: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 12rpx;
+}
+.home-skeleton__name {
+  width: 60%;
+  height: 36rpx;
+  border-radius: 4rpx;
+  background: linear-gradient(90deg, var(--border-light, rgba(200, 142, 168, 0.08)) 25%, var(--border, rgba(200, 142, 168, 0.15)) 50%, var(--border-light, rgba(200, 142, 168, 0.08)) 75%);
+  background-size: 200% 100%;
+  animation: home-skeleton-shimmer 1.5s ease-in-out infinite;
+}
+.home-skeleton__detail {
+  width: 80%;
