-| 医疗边界声明 | 所有AI建议 | 附加"仅供参考，不替代兽医诊断" | 常规展示 |
+function validateSortField(field: string): SortField {
+  if (!ALLOWED_SORT_FIELDS.includes(field as SortField)) {
+    throw new ValidationError(`非法排序字段: ${field}`);
+  }
+  return field as SortField;
+}
 
