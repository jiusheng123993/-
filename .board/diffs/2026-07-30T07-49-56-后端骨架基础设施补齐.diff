+#### 4.12.7 命名数据库设计
+
+```sql
+-- 宠物名（写入宠物档案）
+pet_profiles.name -- 用户确认的名字存储在这里
+
+-- 取名历史（独立表，可追溯取名过程）
+pet_name_history (
+  id uuid PRIMARY KEY,
+  pet_id uuid REFERENCES pet_profiles(id),
+  mode text NOT NULL, -- 'ai_recommend'/'name_interpret'/'inspire_explore'/'pair_name'
+  input_params jsonb, -- 用户输入：{species, breed, birth_date, gender, color, preference}
+  candidates jsonb, -- AI生成的候选：[{name, pinyin, dimension, analysis_json}]
+  selected_name text, -- 用户最终选择
+  interpretation jsonb, -- 完整解读
+  couplet text, -- 趣味对联
+  created_at timestamptz
+)
+
+-- 取名知识库缓存（减少AI调用，热门品种复用）
+pet_name_knowledge_cache (
+  id uuid PRIMARY KEY,
+  cache_key text UNIQUE, -- hash(species+breed+season)
+  five_elements_analysis jsonb, -- 五行分析缓存
+  star_mapping jsonb, -- 星象映射缓存
+  recommended_names jsonb[], -- 推荐名字缓存
+  usage_count int DEFAULT 1,
+  last_used_at timestamptz,
+  created_at timestamptz
+)
+```
