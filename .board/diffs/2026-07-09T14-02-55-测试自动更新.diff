-export function buildMultiAgentContinuityReport(
-  checkpoints: ContinuityCheckpoint[]
-): MultiAgentContinuityReport {
-  if (checkpoints.length === 0) {
-    return {
-      handoffChain: [],
-      checkpoints: [],
-      validations: [],
-      overallConsistency: 1,
-      issues: [],
-      recommendations: []
