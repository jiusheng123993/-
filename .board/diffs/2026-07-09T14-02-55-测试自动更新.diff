-
-  const obj = data as Record<string, unknown>
-
-  // v0 纯文本格式
-  if (typeof obj.text === 'string' && !obj.atoms && !obj.version) {
-    return 'v0_raw_text'
-  }
-
-  // v0 JSON atoms 格式
-  if (Array.isArray(obj.atoms) && (!obj.version || obj.version === '0')) {
