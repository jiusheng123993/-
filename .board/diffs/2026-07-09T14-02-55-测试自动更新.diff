-    const newWeak = [...new Set([...currentWeak, ...weakSubjects])]
-    if (newWeak.length > currentWeak.length) {
-      proposals.push({
-        fieldPath: 'learning.weakSubjects',
-        oldValue: currentWeak,
-        newValue: newWeak,
