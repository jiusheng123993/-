-
-    return {
-      proposedChanges,
-      reflectionNote: parsed.reflectionNote || '反思完成',
-      confidence: proposedChanges.length > 0 
-        ? proposedChanges.reduce((sum: number, p: ProfileChangeProposal) => sum + p.confidence, 0) / proposedChanges.length
