-  }
-  
-  const draft = createAiPromptDraft(activeProvider.id, {
-    kind: 'agent-chat',
-    input: userPrompt,
-    context: systemPrompt
-  })
-  
-  try {
-    await fetchChatCompletionStream(activeProvider.id, draft.systemPrompt, draft.userPrompt, onChunk, signal)
