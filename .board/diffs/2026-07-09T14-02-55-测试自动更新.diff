-      accessCount: typeof item.accessCount === 'number' ? item.accessCount : 0,
-      contradictionOf: Array.isArray(item.contradictionOf) ? item.contradictionOf as string[] : [],
-    }))
-    return {
-      version: CURRENT_MEMORY_BODY_SCHEMA_VERSION as 1,
-      scope,
-      atoms,
-      entities: [],
-      relations: [],
