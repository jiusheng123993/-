-
-const CATEGORY_COLORS: Record<GraphNodeCategory, string> = {
-  memory: '#3B82F6',
-  entity: '#6B7280',
-  user: '#3B82F6',
-  goal: '#10B981',
-  preference: '#F59E0B',
-  boundary: '#EF4444',
-  emotion: '#EC4899',
-  evidence: '#8B5CF6'
-}
-
-const LIFECYCLE_BORDER_COLORS: Record<string, string> = {
-  draft: '#9CA3AF',
-  active: '#3B82F6',
-  confirmed: '#10B981',
-  stable: '#6366F1',
-  weakening: '#F59E0B',
-  archived: '#6B7280',
-  contradicted: '#EF4444',
-  protected: '#8B5CF6',
-  forbidden: '#DC2626'
-}
-
-const EDGE_CATEGORY_COLORS: Record<GraphEdgeCategory, string> = {
