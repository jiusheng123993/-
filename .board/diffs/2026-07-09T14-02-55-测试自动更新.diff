-
-export type MemoryEvolutionProposalType = 'merge_duplicate' | 'promote_memory' | 'resolve_contradiction'
-
-export interface MemoryEvolutionProposal {
-  type: MemoryEvolutionProposalType
-  targetAtomIds: string[]
