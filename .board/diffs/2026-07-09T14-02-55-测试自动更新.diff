-export function createEmptyProfile(scope: MemoryScope): MemoryProfile {
-  const now = new Date().toISOString()
-  return {
-    version: PROFILE_VERSION,
-    scope,
-    identity: {},
-    personality: {},
-    rhythm: {},
-    goals: {},
-    preferences: {},
-    boundaries: {},
-    learning: {},
-    emotional: {},
-    meta: {
-      createdAt: now,
-      updatedAt: now,
