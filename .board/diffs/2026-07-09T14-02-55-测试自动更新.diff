-    }
-    lines.push('')
-  }
-
-  if (important.length > 0) {
-    lines.push('## 🟡 建议关注')
-    for (const change of important) {
-      lines.push(`- ${change.description}`)
-    }
-    lines.push('')
-  }
-
-  if (notice.length > 0) {
