-const DEFAULT_METRIC_WEIGHTS: Record<EvaluationMetric, number> = {
-  accuracy: 0.20,
-  coverage: 0.15,
-  user_satisfaction: 0.15,
-  correction_rate: 0.10,
-  confirmation_rate: 0.10,
-  forget_rate: 0.05,
-  conflict_rate: 0.10,
-  staleness: 0.05,
-  prompt_efficiency: 0.05,
-  trust_score: 0.05
