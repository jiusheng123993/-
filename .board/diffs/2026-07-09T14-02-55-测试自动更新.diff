-    const highConfAtoms = group.filter(a => a.confidence >= 0.7 && a.lifecycle !== 'archived')
-    for (let i = 0; i < highConfAtoms.length - 1; i++) {
-      for (let j = i + 1; j < highConfAtoms.length; j++) {
