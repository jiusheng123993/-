-  let size: GraphNodeStyle['size'] = 'medium'
-  if (sizeScale > 0.8) size = 'large'
-  else if (sizeScale < 0.4) size = 'small'
-
-  return {
-    color: CATEGORY_COLORS[category],
-    size,
