-          type: 'review',
-          title: '复习提醒',
-          body: `该复习了：${item.title}`,
-          icon: '🧠',
-          data: { itemId: item.id }
-        })
-      }
-    })
-  }
-
-  return {
-    add, markRead, dismiss, dismissAll,
-    getUnread, getActive, getAll,
-    getPrefs, updatePrefs,
-    requestBrowserPermission,
-    subscribe,
-    checkScheduleReminders,
-    checkHabitReminders,
-    checkReviewReminders
-  }
-}
