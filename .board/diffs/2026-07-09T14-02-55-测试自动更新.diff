-
-    if (!goal) return { target: 0, completed, percent: 0 }
-    return {
-      target: goal.targetBooks,
-      completed,
-      percent: goal.targetBooks > 0 ? Math.min(100, Math.round((completed / goal.targetBooks) * 100)) : 0
-    }
-  }
-
-  return {
-    getState,
-    addBook,
-    updateBookProgress,
-    updateBookStatus,
-    rateBook,
-    removeBook,
-    addNote,
-    removeNote,
-    setReadingGoal,
-    getReadingStats,
-    getGoalProgress
-  }
-}
