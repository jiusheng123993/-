-    }
-    if (m.target !== undefined && m.value < m.target * 0.5) {
-      recommendations.push(`${m.label} 偏低 (${m.value}${m.unit})，目标 ${m.target}${m.unit}`)
-    }
-  }
-
-  if (recommendations.length === 0) {
-    recommendations.push('所有指标在健康范围内')
-  }
-
-  return recommendations
-}
