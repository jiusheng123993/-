-    for (let i = 0; i < 24; i++) {
-      stats[i] = { totalMinutes: 0, count: 0 }
-    }
-    
-    history.forEach((entry: FocusHistoryEntry) => {
-      stats[entry.hourOfDay].totalMinutes += entry.minutes
-      stats[entry.hourOfDay].count += 1
-    })
-    
-    return Object.entries(stats).map(([hour, data]) => ({
-      hour: parseInt(hour),
