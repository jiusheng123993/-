# 改动说明
问题：新旧 UI 存在重复组件，导致性能卡顿
原因：旧版 Sidebar/SidebarToggle 与新版模块画布并存，造成渲染冗余
改动：
  1. 移除旧独立 Sidebar 组件
  2. 移除旧独立 SidebarToggle 组件
  3. 模块画布改为按需展示
影响：性能提升，测试 891/891 通过

--- a/src/App.tsx
+++ b/src/App.tsx
@@ -1,5 +1,3 @@
-import { Sidebar } from './shared/sidebar/Sidebar';
-import { SidebarToggle } from './shared/sidebar/SidebarToggle';
 import { ModuleCanvas } from './shared/module-store/ModuleCanvas';
 
 export const App = () => {
@@ -7,7 +5,5 @@
     <div className="app">
-      <SidebarToggle />
-      <Sidebar />
       <ModuleCanvas />
     </div>
   );
 };

--- a/src/shared/sidebar/Sidebar.tsx
+++ /dev/null
@@ -1,10 +0,0 @@
-// 旧版 Sidebar - 已移除
