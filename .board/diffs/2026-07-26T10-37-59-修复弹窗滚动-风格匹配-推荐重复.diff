+    const systemPrompt = `你是一个专业的语音转文字助手。请将用户提供的语音内容转写成文字。
+如果语音内容不清晰或无法辨识，请返回"无法识别语音内容"。
+只返回转写后的文字，不要添加任何解释或额外内容。`;
+
+    const result = await chat(
+      [
+        { role: 'system' as const, content: systemPrompt },
+        {
+          role: 'user' as const,
+          content: [
+            {
+              type: 'text' as const,
+              text: '请将以下语音内容转写成文字，只返回转写结果：',
+            },
+            {
+              type: 'image_url' as const,
+              image_url: {
+                url: `data:audio/mp3;base64,${audioBase64}`,
+              },
+            },
+          ],
+        },
+      ],
+      { temperature: 0, max_tokens: 500 }
+    );
+
+    res.json({
+      success: true,
+      data: {
+        text: result.trim(),
+      },
+    });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : '语音转文字服务异常';
+    console.error('[Voice] 语音转文字失败:', message);
+    res.status(500).json({ success: false, message });
+  }
+});
+
 export default router;
