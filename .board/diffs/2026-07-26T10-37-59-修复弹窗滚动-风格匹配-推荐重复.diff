-.settings-page__theme-desc {
-  display: block;
-  font-size: 22rpx;
-  color: var(--text-tertiary, #786870);
-  overflow: hidden;
-  text-overflow: ellipsis;
-  white-space: nowrap;
-}
-.settings-page__theme-check {
-  width: 40rpx;
-  height: 40rpx;
-  border-radius: 50%;
-  background: var(--gradient-gold, linear-gradient(135deg, #C88EA8, #E8C8D8));
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  flex-shrink: 0;
-}
-.settings-page__theme-check Text {
-  font-size: 24rpx;
-  color: var(--text-inverse, #1A1418);
-  font-weight: 700;
-}
