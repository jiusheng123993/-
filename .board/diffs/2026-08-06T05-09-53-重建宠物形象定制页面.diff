+  &--female { color: #E0856B; }
+}
+
+// 关系列表
+.lineage-overview-rel-list {
+  display: flex;
+  flex-direction: column;
+  gap: 12rpx;
+}
+
+.lineage-overview-rel-item {
+  display: flex;
+  align-items: center;
+  gap: 12rpx;
+  padding: 16rpx 20rpx;
+  border-radius: $radius-md;
+  background: rgba(255, 255, 255, 0.6);
+  border: 1px solid rgba($color-primary, 0.1);
+  animation: fadeInUp 0.3s ease-out both;
+}
+
+.lineage-overview-rel-pet {
+  display: flex;
+  align-items: center;
+  gap: 8rpx;
+  flex: 1;
+  min-width: 0;
+}
+
+.lineage-overview-rel-emoji {
+  font-size: 28rpx;
+  flex-shrink: 0;
+}
+
+.lineage-overview-rel-name {
+  font-size: 26rpx;
+  color: $color-text-primary;
+  font-weight: 500;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.lineage-overview-rel-arrow {
+  font-size: 28rpx;
+  color: $color-text-tertiary;
+  flex-shrink: 0;
+}
+
+.lineage-overview-rel-label {
+  font-size: 24rpx;
+  color: $color-primary;
+  background: rgba($color-primary, 0.1);
+  padding: 4rpx 12rpx;
+  border-radius: $radius-sm;
+  flex-shrink: 0;
+}
+
+.lineage-overview-rel-del {
+  width: 48rpx;
+  height: 48rpx;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 50%;
+  background: rgba($color-danger, 0.1);
+  flex-shrink: 0;
+  transition: all 0.2s;
+
+  &:active {
+    background: rgba($color-danger, 0.2);
+    transform: scale(0.9);
+  }
+
+  Text {
+    font-size: 24rpx;
+    color: $color-danger;
+  }
+}
