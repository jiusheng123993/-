+  .xhh-tab-ripple::after,
+  .xhh-tab-bounce[data-active='true'] {
+    animation: none !important;
+  }
+  .xhh-reveal {
+    opacity: 1;
+    transform: none;
+    transition: none !important;
+  }
+  .xhh-tap { transition: none !important; }
