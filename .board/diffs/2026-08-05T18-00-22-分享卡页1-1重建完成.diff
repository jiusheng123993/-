+  opacity: 0;
+  transform: translateY(20rpx);
+  transition: opacity 0.55s cubic-bezier(0.3, 0, 0, 1), transform 0.55s cubic-bezier(0.3, 0, 0, 1);
+}
+
+.xhh-revealed {
+  opacity: 1;
+  transform: translateY(0);
+}
+
