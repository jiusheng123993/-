-
-/** 情绪标签白名单 */
-const VALID_MOOD_TAGS: MoodTag[] = [
-  'sad', 'anxious', 'tired', 'lonely', 'unclear',
-  'happy', 'calm', 'angry', 'fearful', 'joyful',
-  'stressed', 'relaxed', 'frustrated', 'hopeful',
