-
-      // 按严重程度排序
-      const levelOrder = { severe: 0, moderate: 1, mild: 2 };
-      alerts.sort((a, b) => levelOrder[a.level] - levelOrder[b.level]);
-
-      setStorage(STORAGE_KEYS.CRISIS_ALERTS, alerts);
-      return alerts;
-    } catch (error) {
-      return [];
-    }
-  }
-
-  /**
