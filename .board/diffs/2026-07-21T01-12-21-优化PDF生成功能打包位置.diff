-
-  // 移除HTML标签
-  cleaned = cleaned.replace(/<[^>]*>/g, '');
-
-  // 移除特殊字符（保留中文、英文、数字、基本标点）
-  cleaned = cleaned.replace(/[^\u4e00-\u9fa5a-zA-Z0-9\s\n\r\t，。！？、；：""''（）【】《》—…·\-_.,!?;:()\[\]{}]/g, '');
-
-  // 移除连续空格
-  cleaned = cleaned.replace(/\s+/g, ' ').trim();
-
-  // 限制长度
-  if (cleaned.length > 1000) {
