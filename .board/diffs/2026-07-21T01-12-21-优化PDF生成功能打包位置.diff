-      const alerts = getStorage<CrisisAlert[]>(STORAGE_KEYS.CRISIS_ALERTS) || [];
-      const alertIndex = alerts.findIndex(a => a.id === alertId);
-
-      if (alertIndex === -1) {
-        return false;
-      }
-
-      alerts[alertIndex].acknowledged = true;
