-import { getStorage, setStorage } from '../../utils/storage';
-import type { CrisisAssessment, CrisisLevel, MoodEntry } from '../types/memoryBodyTypes';
-
-const STORAGE_KEYS = {
-  CRISIS_ALERTS: 'crisis_alerts',
