-
-      // 执行升级
-      alert.escalated = true;
-      alert.message = `${alert.message}\n[升级] ${reason}`;
-
-      alerts[alertIndex] = alert;
-      setStorage(STORAGE_KEYS.CRISIS_ALERTS, alerts);
-
-      // 记录到历史
-      this.recordEscalation(alert, reason);
-
-      return true;
-    } catch (error) {
-      return false;
-    }
-  }
-
-  /**
-   * 确认警报
-   * @param alertId 警报ID
-   */
-  acknowledgeAlert(alertId: string): boolean {
