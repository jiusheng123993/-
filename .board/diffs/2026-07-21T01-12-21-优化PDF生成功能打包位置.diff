-      const alerts = getStorage<CrisisAlert[]>(STORAGE_KEYS.CRISIS_ALERTS) || [];
-      const alertIndex = alerts.findIndex(a => a.id === alertId);
-
-      if (alertIndex === -1) {
-        return false;
-      }
-
-      const alert = alerts[alertIndex];
-
-      // 检查冷却时间
-      const lastEscalation = alert.escalated ? alert.detectedAt : null;
