-function shouldSkipDecay(atom: MemoryAtom): boolean {
-  return atom.lifecycle === 'protected'
-    || atom.lifecycle === 'forbidden'
-    || atom.lifecycle === 'archived'
-    || atom.sensitivity === 'forbidden'
