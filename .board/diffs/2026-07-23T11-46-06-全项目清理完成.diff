-const STORAGE_KEY = 'xinghuanhai-focus-records'
-
-function loadRecords(): PomodoroRecord[] {
-  try {
-    const raw = localStorage.getItem(STORAGE_KEY)
-    if (!raw) return []
-    const parsed = JSON.parse(raw)
-    return Array.isArray(parsed) ? parsed : []
-  } catch {
-    return []
-  }
-}
-
-function getTodayRecords(): PomodoroRecord[] {
-  const records = loadRecords()
-  const now = new Date()
-  const startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString()
-  return records.filter(r => r.completedAt >= startOfDay)
-}
-
-function computeStats(records: PomodoroRecord[]): DashboardStats {
-  const now = new Date()
-  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).toISOString()
-  const weekAgo = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 7).toISOString()
-  const monthAgo = new Date(now.getFullYear(), now.getMonth() - 1, now.getDate()).toISOString()
-
-  const todayRecords = records.filter(r => r.completedAt >= today)
-  const weekRecords = records.filter(r => r.completedAt >= weekAgo)
-  const monthRecords = records.filter(r => r.completedAt >= monthAgo)
-
-  const dailyStats: { date: string; minutes: number }[] = []
-  const last7Days = Array.from({ length: 7 }, (_, i) => {
-    const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i)
-    return d.toISOString().split('T')[0]
-  }).reverse()
-
-  for (const date of last7Days) {
-    const dayRecords = records.filter(r => r.completedAt.startsWith(date))
-    dailyStats.push({ date, minutes: dayRecords.reduce((sum, r) => sum + r.durationMinutes, 0) })
-  }
-
-  const subjectMap = new Map<string, number>()
-  for (const record of records) {
-    const subject = record.taskTitle || '未分类'
-    subjectMap.set(subject, (subjectMap.get(subject) || 0) + record.durationMinutes)
-  }
-  const subjectStats = Array.from(subjectMap.entries())
-    .map(([subject, minutes]) => ({ subject, minutes }))
-    .sort((a, b) => b.minutes - a.minutes)
-
-  return {
-    todayMinutes: todayRecords.reduce((sum, r) => sum + r.durationMinutes, 0),
-    weekMinutes: weekRecords.reduce((sum, r) => sum + r.durationMinutes, 0),
-    monthMinutes: monthRecords.reduce((sum, r) => sum + r.durationMinutes, 0),
-    completedSessions: records.filter(r => !r.abandoned).length,
-    dailyStats,
-    subjectStats
-  }
-}
