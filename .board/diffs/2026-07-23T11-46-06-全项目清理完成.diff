-    prefs.browserEnabled = granted
-    persistPrefs()
-    return granted
-  }
-
-  const sendBrowserNotification = (notification: AppNotification): void => {
-    if (typeof window === 'undefined' || !('Notification' in window)) return
-    if (Notification.permission !== 'granted') return
