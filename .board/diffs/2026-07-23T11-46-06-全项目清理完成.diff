-    temperature: 0.7,
-    max_tokens: 1000
-  }
-  
-  if (config.model) {
-    requestBody.model = config.model
-  }
-  
-  const bodyString = JSON.stringify(requestBody)
-  
-  try {
-    const response = await fetch(config.endpoint, {
-      method: 'POST',
-      headers: {
-        'Content-Type': 'application/json',
-        'Authorization': `Bearer ${config.apiKey}`
-      },
-      body: bodyString
-    })
