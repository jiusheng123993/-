-/* ===== Avatar 动画关键帧 ===== */
-
-@keyframes avatar-idle {
-  0%, 100% {
-    transform: scale(1) translateY(0);
-  }
-  50% {
-    transform: scale(1.03) translateY(-4px);
-  }
-}
-
-@keyframes avatar-talking {
-  0%, 100% {
-    transform: translateY(0);
-  }
-  25% {
-    transform: translateY(-6px);
-  }
-  75% {
-    transform: translateY(-2px);
-  }
-}
-
-@keyframes avatar-thinking {
-  0% {
-    transform: rotate(0deg) translateX(0);
-  }
-  25% {
-    transform: rotate(3deg) translateX(4px);
-  }
-  50% {
-    transform: rotate(0deg) translateX(0);
-  }
-  75% {
-    transform: rotate(-3deg) translateX(-4px);
-  }
-  100% {
-    transform: rotate(0deg) translateX(0);
-  }
-}
-
-@keyframes avatar-encouraging {
-  0% {
-    transform: scale(1);
-  }
-  50% {
-    transform: scale(1.12);
-  }
-  100% {
-    transform: scale(1);
-  }
-}
-
-@keyframes avatar-celebrating {
-  0% {
-    transform: scale(1) rotate(0deg) translateY(0);
-  }
-  25% {
-    transform: scale(1.1) rotate(-5deg) translateY(-10px);
-  }
-  50% {
-    transform: scale(1.05) rotate(3deg) translateY(-4px);
-  }
-  75% {
-    transform: scale(1.12) rotate(-3deg) translateY(-8px);
-  }
-  100% {
-    transform: scale(1) rotate(0deg) translateY(0);
-  }
-}
-
-@keyframes avatar-waving {
