-function startCheckIn() {
-  checkInData = {};
-  checkInStep = 0;
-  addAIMessage('好的！让我们来给青橘做个快速打卡 ✦<br><br>一共5项，大概1分钟完成～<br>准备好了吗？我们从第一项开始：');
-  setTimeout(() => askCheckInItem(), 600);
-}
-
-function askCheckInItem() {
-  if (checkInStep >= checkInItems.length) {
-    finishCheckIn();
-    return;
-  }
-  var item = checkInItems[checkInStep];
-  var progress = (checkInStep + 1) + '/5';
-  addAIOptions(item.emoji + ' <strong>' + progress + ' ' + item.label + '</strong><br>' + item.question, item.options.map(function(opt) {
-    return {
-      label: opt.label,
-      onSelect: function(btn, msgEl) {
-        checkInData[item.key] = { label: opt.label, score: opt.score };
-        setTimeout(function() {
-          addUserMessage(opt.label);
-          checkInStep++;
-          setTimeout(askCheckInItem, 400);
-        }, 200);
-      }
-    };
-  }));
-}
-
-function finishCheckIn() {
-  var total = 0;
-  var keys = Object.keys(checkInData);
-  keys.forEach(function(k) { total += checkInData[k].score; });
-  var maxScore = keys.length * 5;
-  var rate = Math.round((total / maxScore) * 100);
-  var starCount = rate >= 90 ? 5 : rate >= 70 ? 4 : rate >= 50 ? 3 : rate >= 30 ? 2 : 1;
-
-  var starsHtml = '';
-  for (var i = 0; i < 5; i++) {
-    starsHtml += i < starCount ? '★' : '<span class="empty">★</span>';
-  }
-
-  var summaryHtml = '<div class="msg-bubble">打卡完成！青橘今天的健康报告出炉啦 ✦</div>';
-  summaryHtml += '<div class="msg-card">';
-  summaryHtml += '<div class="msg-card-title">📊 今日健康报告</div>';
-  summaryHtml += '<div class="score-stars" style="margin-bottom:8px;">' + starsHtml + '</div>';
-  summaryHtml += '<div class="msg-card-stat"><span class="msg-card-stat-label">综合评分</span><span class="msg-card-stat-val">' + rate + ' 分</span></div>';
-  keys.forEach(function(k) {
-    var d = checkInData[k];
-    var item = checkInItems.find(function(it) { return it.key === k; });
-    summaryHtml += '<div class="msg-card-stat"><span class="msg-card-stat-label">' + item.emoji + ' ' + item.label + '</span><span class="msg-card-stat-val">' + d.label + '</span></div>';
-  });
-  summaryHtml += '</div>';
-
-  if (rate >= 90) {
-    summaryHtml += '<div class="msg-bubble" style="margin-top:8px;">太棒了！青橘今天状态满分 ✦<br>连续4天表现优秀，继续保持！<br><br>想<a href="javascript:void(0)" onclick="openHealthTrend()" style="color:var(--color-gold);text-decoration:underline;">查看健康趋势</a>吗？</div>';
-  } else if (rate >= 70) {
-    summaryHtml += '<div class="msg-bubble" style="margin-top:8px;">整体还不错！不过有些项目需要注意一下～<br>明天继续加油 ✦</div>';
-  } else {
-    summaryHtml += '<div class="msg-bubble" style="margin-top:8px;">青橘今天状态不太理想，建议多观察。<br>如果持续这样，可以做个<a href="javascript:void(0)" onclick="startSymptomCheck()" style="color:var(--color-coral);text-decoration:underline;">症状初筛</a>看看是否需要就医。</div>';
-  }
-
-  addMessage('ai', summaryHtml);
-}
