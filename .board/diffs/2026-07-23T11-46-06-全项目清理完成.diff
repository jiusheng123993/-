-        localPath: partial.localPath,
-        thumbnailDataUrl: partial.thumbnailDataUrl,
-        themeBinding: partial.themeBinding,
-        adjustments: partial.adjustments,
-        readabilityWarning: partial.readabilityWarning
-      }
