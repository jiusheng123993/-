-    { label: '活力满满，拆家选手', score: 5 },
-    { label: '正常活动', score: 4 },
-    { label: '有点蔫，不太想动', score: 2 },
-    { label: '趴着不动，精神差', score: 1 }
-  ]},
-  { key: 'weight', emoji: '⚖', label: '体重确认', question: '体重今天称了吗？（参考：上周28.0kg）', options: [
