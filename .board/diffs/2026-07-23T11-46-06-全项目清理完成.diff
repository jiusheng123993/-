-      : focusPausedRemainingMs !== null
-        ? Math.round(focusPausedRemainingMs / 1000)
-        : 0
-
-  useEffect(() => {
-    if (focusEndsAt === null || remainingMsFromEnds > 0) return
-
-    const completedTaskId = focusTaskId
