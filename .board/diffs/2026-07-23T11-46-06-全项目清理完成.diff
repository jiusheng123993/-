-      const expireAt = new Date(Date.now() + reward.rewardDurationDays * 24 * 60 * 60 * 1000).toISOString()
-      entitlementService.grant(reward.inviteeId, {
-        code: reward.rewardCode,
-        source: 'invite_reward',
-        expireAt
-      })
