-        content,
-        layer: 'semantic',
-        type: isGoal ? 'goal' : 'preference',
-        scope,
-        subject: 'user',
-        predicate: isNegative ? 'dislikes' : 'likes',
-        object: content,
-        scenarios: ['chat'],
-        lifecycle: 'active',
-        confidence: 0.6,
-        sensitivity: 'public',
-        source,
-        evidence: [],
-        tags: isNegative ? ['negative'] : [],
-        createdAt: timestamp,
-        updatedAt: timestamp,
-        quality: 0.5,
-        strength: 0.5,
-        emotionalWeight: 0,
-        accessCount: 0,
-        lastAccessedAt: timestamp,
-        contradictionOf: [],
-      })
-    }
