-const maxRelevantEvents = 5
-
-const normalizeText = (value: string) => value.trim().toLowerCase()
-
-const tokenize = (query: string) => normalizeText(query).split(/\s+/).filter(Boolean)
-
-const factLine = (fact: MemoryFact) => `- ${fact.content}`
