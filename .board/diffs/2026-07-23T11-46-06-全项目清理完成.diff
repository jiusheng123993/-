-function drawTrendChart(canvas: HTMLCanvasElement, dailyStats: { date: string; minutes: number }[]) {
-  const ctx = canvas.getContext('2d')
-  if (!ctx) return
-
-  const width = canvas.width
-  const height = canvas.height
-  const padding = 40
-  const chartWidth = width - padding * 2
-  const chartHeight = height - padding * 2
-
-  ctx.clearRect(0, 0, width, height)
-
-  const maxMinutes = Math.max(...dailyStats.map(d => d.minutes), 1)
-
-  // Draw grid lines
-  ctx.strokeStyle = 'rgba(0, 0, 0, 0.1)'
-  ctx.lineWidth = 1
-  for (let i = 0; i <= 5; i++) {
-    const y = padding + (chartHeight / 5) * i
-    ctx.beginPath()
-    ctx.moveTo(padding, y)
-    ctx.lineTo(width - padding, y)
-    ctx.stroke()
-  }
-
-  // Draw bars
-  const barWidth = chartWidth / dailyStats.length * 0.6
-  const barSpacing = chartWidth / dailyStats.length
-
-  dailyStats.forEach((stat, index) => {
-    const barHeight = (stat.minutes / maxMinutes) * chartHeight
-    const x = padding + index * barSpacing + (barSpacing - barWidth) / 2
-    const y = padding + chartHeight - barHeight
-
-    ctx.fillStyle = 'var(--primary)'
-    ctx.fillRect(x, y, barWidth, barHeight)
-
-    // Draw date labels
-    ctx.fillStyle = 'var(--text-secondary)'
-    ctx.font = '12px sans-serif'
-    ctx.textAlign = 'center'
-    const date = new Date(stat.date)
-    ctx.fillText(`${date.getMonth() + 1}/${date.getDate()}`, x + barWidth / 2, height - 10)
-  })
-}
